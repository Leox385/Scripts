local function IsTreeMatchingSize(treeModel, selectedType)
    if selectedType == "All Trees" then return true end
    local name = treeModel.Name:lower()
    local isBig = name:find("big") ~= nil
    local isSmall = name:find("small") ~= nil

    if not isBig and not isSmall then
        local trunk = treeModel:FindFirstChild("Trunk") or treeModel:FindFirstChild("Wood") or treeModel.PrimaryPart
        if trunk and trunk:IsA("BasePart") then
            if trunk.Size.Y >= 25 or trunk.Size.X >= 3.5 then
                isBig = true
            else
                isSmall = true
            end
        else
            isSmall = true
        end
    end

    if selectedType == "Small Trees Only" then
        return isSmall and not isBig
    elseif selectedType == "Big Trees Only" then
        return isBig
    end
    return true
end

local function DisarmAndExpandAnimal(targetModel, customSize)
    if not targetModel or not targetModel.Parent then return end
    local s = customSize or huntHitboxSize or 22
    local targetPart = targetModel:FindFirstChild("HumanoidRootPart") or targetModel:FindFirstChild("Torso") or targetModel.PrimaryPart
    if targetPart and targetPart:IsA("BasePart") then
        if targetPart.Size.X ~= s or targetPart.CanCollide ~= false then
            targetPart.Size = Vector3.new(s, s, s)
            targetPart.CanCollide = false
        end
    end
    for _, p in ipairs(targetModel:GetChildren()) do
        if p:IsA("BasePart") and p.CanCollide then
            pcall(function() p.CanCollide = false end)
        end
    end
    if targetModel:GetAttribute("AttackRange") ~= 0 then
        pcall(function() targetModel:SetAttribute("AttackRange", 0) end)
    end
    if targetModel:GetAttribute("ChasingPlayer") ~= 0 then
        pcall(function() targetModel:SetAttribute("ChasingPlayer", 0) end)
    end
    if targetModel:GetAttribute("State") ~= "Idle" then
        pcall(function() targetModel:SetAttribute("State", "Idle") end)
    end
end

