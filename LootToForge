local function tweenToPosition(targetPos, duration, isLoop)
    local curPos, hrp = getHRPPosition()
    if not curPos or not hrp or not targetPos then return false end

    local startPos = curPos
    local d = duration or 1.5
    local startTime = tick()

    pcall(function()
        if applyBarrierBypass then applyBarrierBypass() end
    end)

    local groundY = startPos.Y
    if math.abs(groundY - 4.0) > 4.5 then
        groundY = 4.0
    end
    local endGroundY = targetPos.Y or groundY
    if math.abs(endGroundY - 4.0) > 4.5 then
        endGroundY = 4.0
    end

    local conn
    local finished = false

    conn = RunService.RenderStepped:Connect(function()
        if not STATE.Running or (isLoop and not STATE.Zone27Loop) then
            if conn then conn:Disconnect() conn = nil end
            finished = true
            return
        end

        local elapsed = tick() - startTime
        if elapsed >= d then
            if conn then conn:Disconnect() conn = nil end
            pcall(function()
                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                hrp.Velocity = Vector3.new(0, 0, 0)
                hrp.CFrame = CFrame.new(targetPos.X, endGroundY, targetPos.Z)
            end)
            finished = true
            return
        end

        local alpha = math.clamp(elapsed / d, 0, 1)
        local t = (1 - math.cos(alpha * math.pi)) / 2

        local curX = startPos.X + (targetPos.X - startPos.X) * t
        local curZ = startPos.Z + (targetPos.Z - startPos.Z) * t
        local curY = groundY + (endGroundY - groundY) * t

        pcall(function()
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            hrp.Velocity = Vector3.new(0, 0, 0)
            local ok = pcall(function()
                hrp.CFrame = CFrame.lookAt(
                    Vector3.new(curX, curY, curZ),
                    Vector3.new(targetPos.X, curY, targetPos.Z)
                )
            end)
            if not ok then
                hrp.CFrame = CFrame.new(curX, curY, curZ)
            end
        end)
    end)

    while not finished and STATE.Running do
        if isLoop and not STATE.Zone27Loop then break end
        task.wait(0.02)
    end

    if conn then
        conn:Disconnect()
        conn = nil
    end

    pcall(function()
        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        hrp.Velocity = Vector3.new(0, 0, 0)
    end)

    return true
end

