-- =========================================================================
-- BUCLE INFINITO DE ENTREGA: NIKO -> SHIORI -> NIKO -> REPETIR
-- 1,000 EXP + 400 Dinero por ciclo
-- Compatible con Matcha (CFrame corregido y Botón con Drawing)
-- =========================================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local lp = Players.LocalPlayer
local mouse = lp:GetMouse()

-- Configuración y Coordenadas
_G.NikoDeliveryConfig = _G.NikoDeliveryConfig or {
    Enabled = true,                                     -- Estado del auto-farm
    NikoPos = Vector3.new(407.3, 875.0, 978.9),         -- Coordenada de Niko (Mistfall Harbor)
    ShioriPos = Vector3.new(-1814.34, 311.80, -101.07), -- Coordenada de Shiori (Butterfly Estate)
    InteractDelay = 0.8,
}
local Config = _G.NikoDeliveryConfig

-- Estadísticas
local Stats = {
    Completed = 0,
    ExpEarned = 0,
    MoneyEarned = 0,
    Phase = "Iniciando..."
}

-- =========================================================================
-- 1. LIMPIEZA DE UI PREVIA SI SE RE-EJECUTA
-- =========================================================================
if _G.NikoDeliveryUI then
    pcall(function()
        for _, elem in pairs(_G.NikoDeliveryUI) do
            if elem and elem.Remove then elem:Remove() end
        end
    end)
    if _G.NikoDeliveryConn then
        pcall(function() _G.NikoDeliveryConn:Disconnect() end)
    end
    _G.NikoDeliveryActive = false
    task.wait(0.1)
end
_G.NikoDeliveryActive = true

-- =========================================================================
-- 2. BOTÓN FLOTANTE (ON / OFF)
-- =========================================================================
local btnX, btnY = 30, 220
local btnW, btnH = 220, 65

local bg = Drawing.new("Square")
bg.Position = Vector2.new(btnX, btnY)
bg.Size = Vector2.new(btnW, btnH)
bg.Filled = true
bg.Color = Config.Enabled and Color3.fromRGB(40, 160, 60) or Color3.fromRGB(180, 40, 40)
bg.Visible = true

local border = Drawing.new("Square")
border.Position = Vector2.new(btnX, btnY)
border.Size = Vector2.new(btnW, btnH)
border.Filled = false
border.Thickness = 2
border.Color = Color3.fromRGB(255, 255, 255)
border.Visible = true

local label = Drawing.new("Text")
label.Position = Vector2.new(btnX + btnW / 2, btnY + 8)
label.Size = 14
label.Center = true
label.Outline = true
label.Color = Color3.fromRGB(255, 255, 255)
label.Text = Config.Enabled and "[ ON ] PAQUETE NIKO <-> SHIORI" or "[ OFF ] FARM PAUSADO"
label.Visible = true

local phaseLabel = Drawing.new("Text")
phaseLabel.Position = Vector2.new(btnX + btnW / 2, btnY + 26)
phaseLabel.Size = 11
phaseLabel.Center = true
phaseLabel.Outline = true
phaseLabel.Color = Color3.fromRGB(255, 230, 120)
phaseLabel.Text = "Fase: Esperando inicio..."
phaseLabel.Visible = true

local statsLabel = Drawing.new("Text")
statsLabel.Position = Vector2.new(btnX + btnW / 2, btnY + 44)
statsLabel.Size = 11
statsLabel.Center = true
statsLabel.Outline = true
statsLabel.Color = Color3.fromRGB(220, 220, 220)
statsLabel.Text = "Completadas: 0 | EXP: +0"
statsLabel.Visible = true

_G.NikoDeliveryUI = { bg = bg, border = border, label = label, phaseLabel = phaseLabel, statsLabel = statsLabel }

local function updateUI()
    if Config.Enabled then
        bg.Color = Color3.fromRGB(40, 160, 60)
        label.Text = "[ ON ] PAQUETE NIKO <-> SHIORI"
    else
        bg.Color = Color3.fromRGB(180, 40, 40)
        label.Text = "[ OFF ] FARM PAUSADO"
    end
    phaseLabel.Text = "Fase: " .. Stats.Phase
    statsLabel.Text = string.format("Completadas: %d | EXP: +%d", Stats.Completed, Stats.ExpEarned)
end

local function toggleFarm()
    Config.Enabled = not Config.Enabled
    updateUI()
    print("[NikoDelivery] Estado cambiado a:", Config.Enabled and "ACTIVO (ON)" or "PAUSADO (OFF)")
end

-- Clic con ratón sobre el botón
task.spawn(function()
    while _G.NikoDeliveryActive do
        if ismouse1pressed and ismouse1pressed() then
            local mx, my = mouse.X, mouse.Y
            if mx >= btnX and mx <= (btnX + btnW) and my >= btnY and my <= (btnY + btnH) then
                toggleFarm()
                while ismouse1pressed and ismouse1pressed() do
                    task.wait(0.05)
                end
            end
        end
        task.wait(0.04)
    end
end)

-- Teclado: [K] = ON/OFF | [N] = Calibrar posición de Niko si estás parado junto a él
_G.NikoDeliveryConn = UserInputService.InputBegan:Connect(function(input)
    if not input or not input.KeyCode then return end
    if input.KeyCode == Enum.KeyCode.K or input.KeyCode == 107 then
        toggleFarm()
    elseif input.KeyCode == Enum.KeyCode.N or input.KeyCode == 110 then
        local char = lp.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            Config.NikoPos = hrp.Position
            print(string.format("[NikoDelivery] Posición de Niko guardada en: Vector3.new(%.1f, %.1f, %.1f)", 
                hrp.Position.X, hrp.Position.Y, hrp.Position.Z))
        end
    end
end)

-- =========================================================================
-- 3. TELETRANSPORTE (CORRECCIÓN CFRAME MATCHA)
-- =========================================================================
local function teleportTo(targetPos, npcName)
    local char = lp.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local dest = targetPos

    -- Si el modelo exacto del NPC ya está en Workspace, teletransportarse a él
    if npcName and npcName ~= "" then
        for _, m in ipairs(workspace:GetDescendants()) do
            if m.ClassName == "Model" and m.Name:lower():find(npcName:lower(), 1, true) then
                local root = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart or m:FindFirstChild("Head")
                if root then
                    dest = root.Position
                    break
                end
            end
        end
    end

    if dest then
        pcall(function()
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            -- Corrección: 3 números individuales para evitar el error de CFrame.new
            hrp.CFrame = CFrame.new(dest.X, dest.Y + 2.5, dest.Z)
        end)
    end
    task.wait(0.25)
end

-- =========================================================================
-- 4. INTERACCIÓN Y DIÁLOGOS
-- =========================================================================
local function uiClick(btn)
    if not btn then return end
    if firesignal then
        pcall(function() firesignal(btn.MouseButton1Click) end)
        pcall(function() firesignal(btn.Activated) end)
        return
    end
    if VirtualInputManager and btn.AbsolutePosition then
        local pos = btn.AbsolutePosition
        local size = btn.AbsoluteSize
        local cx = math.floor(pos.X + size.X / 2)
        local cy = math.floor(pos.Y + size.Y / 2)
        pcall(function()
            VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, true, game, 0)
            task.wait(0.04)
            VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 0)
        end)
        return
    end
    if mousemoveabs and mouse1click and btn.AbsolutePosition then
        local pos = btn.AbsolutePosition
        local size = btn.AbsoluteSize
        local cx = math.floor(pos.X + size.X / 2)
        local cy = math.floor(pos.Y + size.Y / 2)
        pcall(function()
            mousemoveabs(cx, cy)
            task.wait(0.04)
            mouse1click()
        end)
    end
end

local function clickNearbyPrompt()
    local char = lp.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    for _, p in ipairs(workspace:GetDescendants()) do
        if p.ClassName == "ProximityPrompt" and p.Enabled then
            local parent = p.Parent
            local pPos = parent and (parent:IsA("BasePart") and parent.Position or (parent:IsA("Model") and parent.PrimaryPart and parent.PrimaryPart.Position))
            if pPos and (pPos - hrp.Position).Magnitude <= (p.MaxActivationDistance or 15) then
                if fireproximityprompt then
                    fireproximityprompt(p)
                end
            end
        end
    end
end

local function pressT()
    clickNearbyPrompt()
    if keypress and keyrelease then
        pcall(function()
            keypress(84) -- ASCII 84 = 'T'
            task.wait(0.18)
            keyrelease(84)
        end)
    elseif VirtualInputManager then
        pcall(function()
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.T, false, game)
            task.wait(0.18)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.T, false, game)
        end)
    end
end

local function getDialogueUI()
    local holder = lp.PlayerGui:FindFirstChild("ComponentsHolder")
    local frame = holder and holder:FindFirstChild("DialogueFrame")
    local actual = frame and frame:FindFirstChild("Actual")
    if not actual or not actual.Visible then return nil end
    return actual
end

local function collectChoices(actual)
    local holder = actual:FindFirstChild("ButtonHolder")
    local choices = {}
    if not holder then return choices end
    for _, f in ipairs(holder:GetChildren()) do
        if f.ClassName == "Frame" and f:FindFirstChild("TextButton") then
            local btn = f:FindFirstChild("TextButton")
            local txt = ""
            pcall(function() txt = btn.Actual.TextLabel.Text end)
            choices[#choices + 1] = { Frame = f, Button = btn, Text = txt }
        end
    end
    return choices
end

-- Avanza el diálogo seleccionando la opción deseada y evitando 'Close'
local function handleDialogue(preferredText)
    for _ = 1, 35 do
        local actual = getDialogueUI()
        if not actual then return true end

        local choices = collectChoices(actual)
        if #choices > 0 then
            local match = nil

            -- 1. Buscar si coincide con el texto esperado
            if preferredText then
                for _, c in ipairs(choices) do
                    if c.Text and c.Text:lower():find(preferredText:lower(), 1, true) then
                        match = c
                        break
                    end
                end
            end

            -- 2. Si no coincide, evitar cerrar la conversación por error
            if not match then
                for _, c in ipairs(choices) do
                    local t = c.Text and c.Text:lower() or ""
                    if not t:find("close") then
                        match = c
                        break
                    end
                end
            end

            if not match then match = choices[1] end

            if match then
                uiClick(match.Button)
            end
            task.wait(0.45)
        else
            -- Si es texto continuo de charla, hacer clic en ClickDetector para avanzar
            local cd = actual:FindFirstChild("ClickDetector")
            if cd then uiClick(cd) end
            task.wait(0.45)
        end
    end
    return false
end

-- =========================================================================
-- 5. LECTURA EXACTA DEL ESTADO DEL PAQUETE Y LA MISIÓN
-- =========================================================================

-- Comprueba si el jugador tiene el Supply Box físico en su inventario
local function hasSupplyBox()
    local pData = ReplicatedStorage:FindFirstChild("Player_Service")
        and ReplicatedStorage.Player_Service:FindFirstChild("Data")
        and ReplicatedStorage.Player_Service.Data:FindFirstChild(lp.Name)
    local inv = pData and pData:FindFirstChild("slots")
        and pData.slots:FindFirstChild("Slot1")
        and pData.slots.Slot1:FindFirstChild("Inventory")
        and pData.slots.Slot1.Inventory:FindFirstChild("Inventory")
    if inv and inv:FindFirstChild("Supply Box") then
        return true
    end
    return false
end

-- Obtiene la misión de entrega activa
local function getNikoQuest()
    local pData = ReplicatedStorage:FindFirstChild("Player_Service")
        and ReplicatedStorage.Player_Service:FindFirstChild("Data")
        and ReplicatedStorage.Player_Service.Data:FindFirstChild(lp.Name)
    local holder = pData and pData:FindFirstChild("slots")
        and pData.slots:FindFirstChild("Slot1")
        and pData.slots.Slot1:FindFirstChild("Quests")
        and pData.slots.Slot1.Quests:FindFirstChild("Holder")
    if not holder then return nil end

    for _, q in ipairs(holder:GetChildren()) do
        if q.Name:find("Deliver Niko") or q.Name:find("Supply Box") or q.Name:find("Niko") then
            local tasksFolder = q:FindFirstChild("Tasks")
            local tShiori = tasksFolder and tasksFolder:FindFirstChild("Deliver to Shiori")
            local tReport = tasksFolder and tasksFolder:FindFirstChild("Report back to Niko")

            local deliverDone = tShiori and (tShiori.Value.Value >= tShiori.Max.Value) or false
            local reportDone = tReport and (tReport.Value.Value >= tReport.Max.Value) or false

            return {
                Folder = q,
                Name = q.Name,
                DeliverDone = deliverDone,
                ReportDone = reportDone
            }
        end
    end
    return nil
end

-- =========================================================================
-- 6. BUCLE PRINCIPAL (EL CICLO INFINITO DE 3 PASOS)
-- =========================================================================
local function deliveryStep()
    if not Config.Enabled then return end

    local q = getNikoQuest()
    local carryingBox = hasSupplyBox()

    if not q then
        -- =================================================================
        -- PASO 1: No tienes la misión -> Ir con Niko a pedir el paquete
        -- =================================================================
        Stats.Phase = "Paso 1: Aceptando misión con Niko..."
        updateUI()
        print("[NikoDelivery]", Stats.Phase)

        teleportTo(Config.NikoPos, "Niko")
        task.wait(Config.InteractDelay)
        pressT()
        task.wait(0.8)

        if getDialogueUI() then
            -- Opción decompilada para aceptar: "Ill deliver the supply box(Lv 70)"
            handleDialogue("deliver the supply box")
        end
        task.wait(0.8)

    elseif q and (carryingBox or not q.DeliverDone) then
        -- =================================================================
        -- PASO 2: Tienes el paquete -> Llevarlo a Shiori en Butterfly Estate
        -- =================================================================
        Stats.Phase = "Paso 2: Entregando paquete a Shiori..."
        updateUI()
        print("[NikoDelivery]", Stats.Phase)

        teleportTo(Config.ShioriPos, "Shiori")
        task.wait(Config.InteractDelay)
        pressT()
        task.wait(0.8)

        if getDialogueUI() then
            -- Opción decompilada para entregar: "Niko sent it up"
            handleDialogue("Niko sent it up")
        end
        task.wait(0.8)

    elseif q and q.DeliverDone then
        -- =================================================================
        -- PASO 3: Paquete entregado -> Regresar con Niko a cobrar recompensa
        -- =================================================================
        Stats.Phase = "Paso 3: Cobrando recompensa con Niko..."
        updateUI()
        print("[NikoDelivery]", Stats.Phase)

        teleportTo(Config.NikoPos, "Niko")
        task.wait(Config.InteractDelay)
        pressT()
        task.wait(0.8)

        if getDialogueUI() then
            -- Opción decompilada para cobrar: "Shiori says thank you"
            handleDialogue("thank you")
        end
        task.wait(1.0)

        -- Verificar si la misión finalizó para actualizar contadores
        local afterQ = getNikoQuest()
        if not afterQ then
            Stats.Completed = Stats.Completed + 1
            Stats.ExpEarned = Stats.Completed * 1000
            Stats.MoneyEarned = Stats.Completed * 400
            Stats.Phase = string.format("¡Misión #%d cobrada! (+1k EXP)", Stats.Completed)
            updateUI()
            print(string.format("[NikoDelivery] ¡Ciclo #%d completado! (+1,000 EXP, +400 Dinero) | Total EXP: %d | Total Dinero: %d", 
                Stats.Completed, Stats.ExpEarned, Stats.MoneyEarned))
        end
        task.wait(0.5)
    end
end

-- Lanzar bucle
task.spawn(function()
    print("[NikoDelivery] Script en marcha.")
    print("[NikoDelivery] Haz clic al botón o presiona [K] para Pausar/Activar | Presiona [N] al lado de Niko para calibrar su posición.")

    while _G.NikoDeliveryActive do
        if Config.Enabled then
            deliveryStep()
        end
        task.wait(0.4)
    end
end)
