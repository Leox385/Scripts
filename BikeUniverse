local performRagdollRecovery
local isRecovering = false

performRagdollRecovery = function()
    if isRecovering then return end
    isRecovering = true

    local chassis, bike, seat = getPlayerBikeChassis()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")

    local ragdollEvent = ReplicatedStorage:FindFirstChild("RagdollEvent")
    if ragdollEvent then
        pcall(function() ragdollEvent:FireServer(false) end)
    end

    if char then
        for _, d in ipairs(char:GetDescendants()) do
            if (d.Name == "RagdollCollider" or string.find(d.Name, "Ragdoll", 1, true)) and (d.ClassName == "Part" or d.ClassName == "MeshPart") then
                pcall(function() d.CanCollide = false end)
            end
        end
    end

    if bike and hrp and seat then
        local pa = chassis and chassis:FindFirstChild("PromptAttachment")
        local prompt = pa and pa:FindFirstChild("RidePrompt")

        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        hrp.Position = seat.Position

        if prompt then
            pcall(function() fireproximityprompt(prompt) end)
        end

        pcall(function()
            keypress(0x45)
            task.wait(0.06)
            keyrelease(0x45)
        end)

        task.wait(0.2)
        if not seat:FindFirstChild("SeatWeld") and prompt then
            hrp.Position = seat.Position
            pcall(function() fireproximityprompt(prompt) end)
        end
    end

    task.wait(0.2)
    isRecovering = false
end

