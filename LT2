extraTab:Section("Dupe")

local selectedReloadSlot = "Current Active Slot"
local reloadSlotOptions = {
    "Current Active Slot", "Slot 1", "Slot 2", "Slot 3", "Slot 4", "Slot 5", "Slot 6"
}

local function resolveTargetSlot()
    if selectedReloadSlot == "Current Active Slot" or not selectedReloadSlot then
        local val = lp:FindFirstChild("CurrentSaveSlot")
        if val and typeof(val.Value) == "number" and val.Value > 0 then
            return val.Value
        end
        return 1
    else
        local num = tonumber(selectedReloadSlot:match("%d+"))
        return num or 1
    end
end

local function reloadPlotSlot(slot)
    slot = slot or 1
    local rs = game:GetService("ReplicatedStorage")
    local req = rs:FindFirstChild("LoadSaveRequests")
    if not req then return false, "LoadSaveRequests not found" end
    
    local mayLoad = req:FindFirstChild("ClientMayLoad")
    local reqLoad = req:FindFirstChild("RequestLoad")
    
    if mayLoad then
        local canLoad, err = mayLoad:InvokeServer(lp)
        if not canLoad then
            return false, err or "Cooldown active"
        end
    end
    
    if reqLoad then
        local success, msg = reqLoad:InvokeServer(slot, lp)
        return success, msg
    end
    
    return false, "RequestLoad remote not available"
end

local isReloadCycleRunning = false

local function triggerVoidAndReload()
    if isReloadCycleRunning then
        Non:Notify({Title = "Busy", Content = "Reload cycle already in progress.", Icon = "clock", Duration = 3})
        return
    end
    isReloadCycleRunning = true
    
    local targetSlot = resolveTargetSlot()
    local char, root, hum = getChar()
    
    Non:Notify({
        Title = "Void Routine",
        Content = string.format("Teleporting to void point. Injecting Slot %d on death...", targetSlot),
        Icon = "refresh-cw",
        Duration = 3
    })
    
    if root then
        root.Velocity = Vector3.new(0, 0, 0)
        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        root.CFrame = CFrame.new(78.2, -254.0, 56.9)
    end
    
    task.spawn(function()
        local startChar = lp.Character or char
        local startHum = startChar and startChar:FindFirstChild("Humanoid")
        local isDead = false
        local t0 = os.clock()
        
        while (os.clock() - t0) < 15 do
            if not startChar or not startChar.Parent then
                isDead = true
                break
            end
            if startHum and startHum.Health <= 0 then
                isDead = true
                break
            end
            if lp.Character and lp.Character ~= startChar then
                isDead = true
                break
            end
            task.wait(0.03)
        end
        
        if isDead then
            local ok, msg = reloadPlotSlot(targetSlot)
            if ok then
                Non:Notify({
                    Title = "Slot Reloaded",
                    Content = string.format("Death verified. Slot %d restored.", targetSlot),
                    Icon = "circle-check",
                    Duration = 4
                })
            else
                Non:Notify({
                    Title = "Reload Response",
                    Content = tostring(msg or "Save file loaded."),
                    Icon = "info",
                    Duration = 4
                })
            end
        else
            Non:Notify({
                Title = "Void Routine",
                Content = "No character termination detected.",
                Icon = "alert-circle",
                Duration = 3
            })
        end
        
        task.wait(1.5)
        isReloadCycleRunning = false
    end)
end

