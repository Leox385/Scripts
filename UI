-- Layout is implemented locally; no external library or game functions are emulated.
local STYLE_LIMITS = {
    Width={0.1,1}, Height={24,240}, TextSize={10,22}, Gap={0,24},
    Corner={0,20}, Border={0,4}, Cooldown={0.1,2},
}
local function styleTable(value)
    if value == "Compact" then return {Height=36, TextSize=13, Gap=4} end
    if value == nil or value == "Default" then return {} end
    if type(value) ~= "table" then return {} end
    local result = {}
    for key,limits in pairs(STYLE_LIMITS) do
        local n = finite(value[key])
        if n then result[key] = math.max(limits[1], math.min(limits[2], n)) end
    end
    return result
end
local function acceptAction(el, now, cooldown)
    if el.lastActionAt and now - el.lastActionAt < cooldown then return false end
    el.lastActionAt = now
    return true
end
local function sameValue(a,b)
    if type(a) ~= "table" or type(b) ~= "table" then return a == b end
    for k,v in pairs(a) do if b[k] ~= v then return false end end
    for k,v in pairs(b) do if a[k] ~= v then return false end end
    return true
end

local Kirin = { Version = "4.0.0", Flags = {}, _controls = {}, _watchers = {}, _alive = true, _windows = {}, _theme = Themes.Cosmos }

function Kirin:Set(flag, value, silent)
	local control = self._controls[flag]
	if control and not control.setting and not control.destroyed and control.handle.Set then
		local current = control.handle.Get and control.handle:Get()
		if not sameValue(current, value) then control.handle:Set(value, silent); return end
	end
	self.Flags[flag] = value
	local cbs = self._watchers[flag]
	if cbs and not silent and not (control and control.silent) then
		for _, entry in ipairs(cbs) do if entry.live then fire(function() if entry.live then entry.callback(value) end end) end end
	end
end
function Kirin:GetCapabilities()
    return {
        Drawing = Drawing ~= nil and type(safeGet(Drawing, "new")) == "function",
        Scheduler = type(spawnHost) == "function" and type(waitHost) == "function",
        KeyPolling = type(iskeypressed) == "function",
        MousePolling = type(ismouse1pressed) == "function" or type(iskeypressed) == "function",
        FileRead = type(readfile) == "function", FileWrite = type(writefile) == "function",
        Touch = type(firetouchinterest) == "function",
        ProximityPrompt = type(fireproximityprompt) == "function",
    }
end
function Kirin:SetLayout(value)
    self._layout = styleTable(value)
    for _,window in ipairs(self._windows) do window:SetLayout(self._layout) end
    return self
end
function Kirin:AddTab(options)
    if not self._defaultWindow or not self._defaultWindow:IsAlive() then
        self._defaultWindow = self:CreateWindow({Title="ASTRA", Layout=self._layout})
    end
    return self._defaultWindow:AddTab(options)
end
function Kirin:Get(flag) return self.Flags[flag] end
function Kirin:Watch(flag, cb)
	assert(type(cb) == "function", "Astra UI: Watch needs a function")
	local list = self._watchers[flag] or {}
	self._watchers[flag] = list
	local entry = { callback = cb, live = true }
	list[#list + 1] = entry
	return { Disconnect = function() entry.live = false end }
end
function Kirin:ExportConfig()
    local result={Version=1,Values={}}
    for flag,el in pairs(self._controls) do
        if not el.destroyed and el.handle.Get then
            local value=el.handle:Get()
            if el.type=="colorpicker" then value={R=value.R,G=value.G,B=value.B} end
            result.Values[flag]={Type=el.type,Value=value}
        end
    end
    local http=service("HttpService")
    local ok,json=pcall(function() return http:JSONEncode(result) end)
    if not ok then return nil,"JSONEncode no disponible" end
    return json
end
function Kirin:ImportConfig(json, silent)
    local http=service("HttpService")
    local ok,data=pcall(function() return http:JSONDecode(json) end)
    if not ok or type(data)~="table" or data.Version~=1 or type(data.Values)~="table" then
        return false,"Configuracion JSON invalida o version no compatible"
    end
    local applied=0
    for flag,entry in pairs(data.Values) do
        local el=self._controls[flag]
        if el and not el.destroyed and type(entry)=="table" and entry.Type==el.type and el.handle.Set then
            local value=entry.Value
            if el.type=="colorpicker" and type(value)=="table" and colorValid(value) then value=Color3.new(value.R,value.G,value.B) end
            local accepted=pcall(function() el.handle:Set(value,silent~=false) end)
            if accepted then applied=applied+1 end
        end
    end
    return true,applied
end
function Kirin:SaveConfig(path)
    if type(writefile)~="function" then return false,"writefile no disponible" end
    local json,err=self:ExportConfig()
    if not json then return false,err end
    return pcall(writefile,path,json)
end
function Kirin:LoadConfig(path,silent)
    if type(readfile)~="function" then return false,"readfile no disponible" end
    local ok,json=pcall(readfile,path)
    if not ok then return false,tostring(json) end
    return self:ImportConfig(json,silent)
end
function Kirin:GetThemes() return { "Cosmos", "Nebula", "Supernova", "Aurora" } end
function Kirin:SetTransparency(value)
    drawingOpacity = 1 - clamp(finite(value, 0), 0, 0.6)
    for _, update in ipairs(drawingAdapters) do update() end
end
function Kirin:Unload() self:Destroy() end
function Kirin:SetTheme(name)
	local t = Themes[name]
	if not t then return end
	self._theme = t
	for _, w in ipairs(self._windows) do
		if w._applyTheme then w:_applyTheme(t) end
	end
end

local notifs = {}
local notifConn = nil
local NW = 292

local function notifStep(dt)
	local vp = camera.ViewportSize
	local T = Kirin._theme
	local now = clock()
	local ty = 22
	local i = 1
	while i <= #notifs do
		local n = notifs[i]
		local age = now - n.t0
		local inT = clamp(age / 0.38, 0, 1)
		local outT = clamp((age - n.dur) / 0.32, 0, 1)
		if outT >= 1 then
			for _, d in pairs(n.d) do kill(d) end
			table.remove(notifs, i)
		else
			local slide = easeBack(inT) * (1 - easeOut(outT))
			n.y = n.y and lerp(n.y, ty, math.min(dt * 12, 1)) or ty
			local x = vp.X + 12 - (NW + 30) * slide
			local y = n.y
			local col = (n.kind == "success" and T.Ok) or (n.kind == "warning" and T.Warn) or (n.kind == "error" and T.Error) or T.Accent
			local d = n.d
			d.bg.Position = V(x, y); d.bg.Size = V(NW, n.h); d.bg.Color = T.BgAlt
			d.ol.Position = V(x, y); d.ol.Size = V(NW, n.h); d.ol.Color = mixC(T.Border, col, 0.45)
			d.bar.Position = V(x, y + 8); d.bar.Size = V(3, n.h - 16); d.bar.Color = col
			d.title.Position = V(x + 14, y + 9); d.title.Color = T.Text
			d.tag.Position = V(x + NW - 12 - textW(d.tag, 10, true), y + 11); d.tag.Color = col
			local chars = math.floor(math.max(0, age - 0.18) * 75)
			d.body.Text = string.sub(n.full, 1, chars)
			d.body.Position = V(x + 14, y + 28); d.body.Color = T.TextSub
			local life = 1 - clamp(age / n.dur, 0, 1)
			d.track.Position = V(x + 14, y + n.h - 7); d.track.Size = V(NW - 28, 2); d.track.Color = T.Border
			d.fill.Position = V(x + 14, y + n.h - 7); d.fill.Size = V((NW - 28) * life, 2); d.fill.Color = col
			local a = (1 - outT) * math.min(1, inT * 2.5)
			for _, dd in pairs(n.d) do
				dd.Visible = slide > 0.01
				if HAS_T then dd.Transparency = a end
			end
			ty = ty + n.h + 8
			i = i + 1
		end
	end
end

function Kirin:Notify(cfg)
	cfg = cfg or {}
	local kind = cfg.Type or "info"
	local body, lines = wrapText(tostring(cfg.Content or ""), 40)
	local tag = (kind == "success" and "[ OK ]") or (kind == "warning" and "[ WARN ]") or (kind == "error" and "[ ERR ]") or "[ INFO ]"
	local n = {
		t0 = clock(), dur = math.max(0.25, finite(cfg.Duration, 4)), kind = kind, full = body, h = 42 + lines * 14,
		d = {
			bg = newDraw("Square", { Filled = true, Rounding = 6 }),
			ol = newDraw("Square", { Filled = false, Thickness = 1, Rounding = 6 }),
			bar = newDraw("Square", { Filled = true, Rounding = 1 }),
			title = newDraw("Text", { Text = tostring(cfg.Title or "Notice"), Size = 13, Font = F_BOLD, Outline = true }),
			tag = newDraw("Text", { Text = tag, Size = 10, Font = F_MONO, Outline = true }),
			body = newDraw("Text", { Text = "", Size = 12, Font = F_UI, Outline = true }),
			track = newDraw("Square", { Filled = true }),
			fill = newDraw("Square", { Filled = true }),
		},
	}
	table.insert(notifs, n)
	if not notifConn then
		notifConn = connectFrame(function(dt)
			if not Kirin._alive or #notifs == 0 then
				local old = notifConn
				notifConn = nil
				if old then pcall(function() old:Disconnect() end) end
				return
			end
			pcall(notifStep, math.min(dt or 0.016, 0.05))
		end)
	end
end

