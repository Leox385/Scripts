local function equipFishingRod()
    local char = lp.Character
    if not char then return nil end
    for _, item in ipairs(char:GetChildren()) do
        if item.ClassName == "Tool" or item.Name:lower():find("rod") or item.Name:lower():find("fish") then
            return item
        end
    end
    local bp = lp:FindFirstChild("Backpack")
    if bp then
        for _, item in ipairs(bp:GetChildren()) do
            if item.ClassName == "Tool" and (item.Name:lower():find("rod") or item.Name:lower():find("fish")) then
                pcall(function() item.Parent = char end)
                task.wait(0.2)
                return item
            end
        end
        for _, item in ipairs(bp:GetChildren()) do
            if item.ClassName == "Tool" then
                pcall(function() item.Parent = char end)
                task.wait(0.2)
                return item
            end
        end
    end
    return nil
end

local function checkFishBite()
    local char = lp.Character
    if not char then return false end
    for _, desc in ipairs(char:GetDescendants()) do
        if desc.ClassName == "BillboardGui" or desc.Name:lower():find("bite") or desc.Name:lower():find("exclamation") or desc.Name:lower():find("alert") then
            return true
        end
        if desc.ClassName == "TextLabel" and desc.Text:find("!") then
            return true
        end
    end
    return false
end

local function solveFishingMinigame()
    local pg = lp:FindFirstChild("PlayerGui")
    if not pg then return false end
    
    local activeMinigame = false
    for _, gui in ipairs(pg:GetChildren()) do
        local gName = gui.Name:lower()
        if (gName:find("fish") or gName:find("reel") or gName:find("minigame") or gName:find("qte")) and gui.Enabled then
            activeMinigame = true
            
            local fishBar = nil
            local playerBar = nil
            
            for _, desc in ipairs(gui:GetDescendants()) do
                local dName = desc.Name:lower()
                if desc.ClassName == "Frame" or desc.ClassName == "ImageLabel" or desc.ClassName == "ImageButton" then
                    if dName:find("fish") or dName:find("target") or dName:find("indicator") then
                        fishBar = desc
                    elseif dName:find("bar") or dName:find("green") or dName:find("player") or dName:find("hook") or dName:find("zone") then
                        playerBar = desc
                    end
                end
                
                if (desc.ClassName == "TextLabel" or desc.ClassName == "TextButton") and desc.Visible then
                    local txt = desc.Text:upper():gsub("%s+", "")
                    if #txt == 1 and txt:match("%a") then
                        local byte = string.byte(txt)
                        if keypress and keyrelease then
                            keypress(byte)
                            task.wait(0.04)
                            keyrelease(byte)
                        end
                    end
                end
            end
            
            if fishBar and playerBar then
                pcall(function()
                    playerBar.Position = fishBar.Position
                end)
            end
            
            if mouse1click then
                mouse1click()
            elseif VirtualUser then
                VirtualUser:ClickButton1(Vector2.new(500, 500))
            end
        end
    end
    
    if activeMinigame and RemoteEvent then
        pcall(function()
            RemoteEvent:FireServer("Fish_Service", "Minigame", true, 100)
            RemoteEvent:FireServer("Fish_Service", "Success", true)
            RemoteEvent:FireServer("Fish_Service", "Reel", true)
        end)
    end
    
    return activeMinigame
end

