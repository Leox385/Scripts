task.spawn(function()
    local stuckCounter = 0
    local lastPos = Vector3.new(0, 0, 0)
    local trafficScanTimer = 0

    while State.alive do
        local isFarming = State.masterAutoFarm or (RetroUI and RetroUI.Flags and RetroUI.Flags["master_auto_farm"] == true)
        if not isFarming then
            stuckCounter = 0
            task.wait(0.2)
        else
            local chassis, bike, seat = getPlayerBikeChassis()
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")

            trafficScanTimer = trafficScanTimer + 0.1
            if trafficScanTimer >= 0.4 then
                trafficScanTimer = 0
                pcall(function()
                    local traffic = workspace:FindFirstChild("Traffic")
                    local myPos = chassis and chassis.Position
                    if traffic then
                        for _, car in ipairs(traffic:GetChildren()) do
                            if car:IsA("Model") then
                                local carPos = nil
                                for _, part in ipairs(car:GetDescendants()) do
                                    if part:IsA("BasePart") then
                                        if part.CanCollide then part.CanCollide = false end
                                        if not carPos and part.Position then carPos = part.Position end
                                    end
                                end
                                if myPos and carPos and (carPos - myPos).Magnitude < 25 then
                                    for _, part in ipairs(car:GetDescendants()) do
                                        if part:IsA("BasePart") then
                                            part.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                                        end
                                    end
                                end
                            end
                        end
                    end
                end)
            end

            if char then
                for _, d in ipairs(char:GetDescendants()) do
                    if (d.Name == "RagdollCollider" or string.find(d.Name, "Ragdoll", 1, true)) and d:IsA("BasePart") and d.CanCollide then
                        pcall(function() d.CanCollide = false end)
                    end
                end
            end

            local isMounted = (seat and seat:FindFirstChild("SeatWeld") ~= nil)
                or (seat and hrp and (hrp.Position - seat.Position).Magnitude < 15)

            if not isMounted or not chassis or not seat then
                if seat and hrp then
                    performRagdollRecovery()
                    task.wait(0.3)
                elseif SpawnBikeEvent then
                    local garage = LocalPlayer:FindFirstChild("Garage")
                    local sel = garage and garage:FindFirstChild("Selected")
                    local bName = (sel and sel.Value) or "KLM 350CC"
                    SpawnBikeEvent:FireServer(bName)
                    task.wait(1.5)
                else
                    task.wait(0.4)
                end
            else
                local pumpkins = getAvailablePumpkins()
                if #pumpkins == 0 then
                    cleanSmashedHistory()
                    task.wait(0.4)
                else
                    local target = pumpkins[1]
                    local tModel = target.model
                    local pPos = target.pos

                    smashedHistory[tModel] = tick() + 35
                    smashedHistory[target.posKey] = tick() + 35

                    local currentPos = chassis.Position
                    if (currentPos - lastPos).Magnitude < 1.0 then
                        stuckCounter = stuckCounter + 1
                    else
                        stuckCounter = 0
                    end
                    lastPos = currentPos

                    if stuckCounter >= 2 then
                        stuckCounter = 0
                        local forwardLook = chassis.CFrame.LookVector
                        chassis.Position = chassis.Position + Vector3.new(0, 4.2, 0) + forwardLook * 3
                        if hrp then hrp.Position = chassis.Position + Vector3.new(0, 2.5, 0) end
                        chassis.AssemblyLinearVelocity = forwardLook * 25 + Vector3.new(0, 8, 0)
                        task.wait(0.2)
                    end

                    if target.body then
                        pcall(function() target.body.CanCollide = false end)
                    end

                    local forward = (pPos - chassis.Position).Unit
                    local lookXZ = Vector3.new(forward.X, 0, forward.Z)
                    if lookXZ.Magnitude < 0.1 then lookXZ = Vector3.new(0, 0, 1) end

                    local bikeCF = CFrame.lookAt(pPos - forward * 7.5, pPos, Vector3.new(0, 1, 0))
                    chassis.CFrame = bikeCF
                    if hrp then
                        hrp.CFrame = bikeCF * CFrame.new(0, 2.5, 0)
                        hrp.AssemblyLinearVelocity = forward * 18
                    end
                    chassis.AssemblyLinearVelocity = forward * 18

                    if PumpkinsRemote and tModel and tModel.Parent then
                        pcall(function() PumpkinsRemote:FireServer(tModel) end)
                    end

                    if chassis then
                        local up = chassis.CFrame.UpVector
                        if up.Y < 0.35 then
                            local pos = chassis.Position
                            chassis.CFrame = CFrame.lookAt(pos + Vector3.new(0, 1.2, 0), pos + lookXZ * 5, Vector3.new(0, 1, 0))
                            chassis.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                        end
                    end

                    local waitSec = math.clamp(State.smashDelayMs / 1000, 0.8, 3.5)
                    local startWait = tick()
                    while (tick() - startWait) < waitSec do
                        local stillFarming = State.masterAutoFarm or (RetroUI and RetroUI.Flags and RetroUI.Flags["master_auto_farm"] == true)
                        if not stillFarming or not State.alive then break end
                        if tModel and not tModel.Parent then
                            break
                        end
                        task.wait(0.08)
                    end

                    State.smashedCount = State.smashedCount + 1
                    task.wait(0.08)
                end
            end
        end
    end
end)

_G.__HalloweenSuiteCleanup = function()
    State.alive = false
    State.masterAutoFarm = false
      landBikeSafely()
      pcall(function() espConnection:Disconnect() end)
    for i = 1, POOL_SIZE do
        local slot = espPool[i]
        if slot then
            pcall(function() slot.box:Remove() end)
            pcall(function() slot.line:Remove() end)
            pcall(function() slot.tag:Remove() end)
        end
    end
    pcall(function() RetroUI:Destroy() end)
end

