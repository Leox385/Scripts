local function resolveTargetSlot()
    if selectedReloadSlot == "Current Active Slot" or not selectedReloadSlot then
        local val = lp:FindFirstChild("CurrentSaveSlot")
        if val and typeof(val.Value) == "number" and val.Value > 0 then
            return val.Value
