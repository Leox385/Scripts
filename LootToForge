                    local trainFolder = remotes and remotes:FindFirstChild("Train")
                    local intoRE = trainFolder and trainFolder:FindFirstChild("IntoAutoTrainRE")
                    local trainRE = trainFolder and trainFolder:FindFirstChild("AutoTrainRE")
                    local rebirthFolder = remotes and remotes:FindFirstChild("Rebirth")
                    local rebirthRE = rebirthFolder and rebirthFolder:FindFirstChild("RebirthRE")

                    if lastMachineId ~= bestArea.id then
                        lastMachineId = bestArea.id
                        teleportTo(livePos)
                        task.wait(0.3)
                        if intoRE then
                            intoRE:FireServer(bestArea.id)
                        end
                        lp:SetAttribute("AutoTrainAreaID", bestArea.id)
                        say("Auto-Train", "Training at: " .. bestArea.name, "zap")
                    end

                    if trainRE then
                        trainRE:FireServer()
                    end

                    if clock() - STATE.LastRebirthTick > 2.0 then
                        STATE.LastRebirthTick = clock()
                        if rebirthRE then
                            rebirthRE:FireServer()
                        end
                    end
                end)
            else
                if lastMachineId ~= nil then
                    lastMachineId = nil
                    pcall(function()
                        local remotes = ReplicatedStorage:FindFirstChild("Remote")
                        local trainFolder = remotes and remotes:FindFirstChild("Train")
                        local exitRE = trainFolder and trainFolder:FindFirstChild("ExitAutoTrainRE")
                        if exitRE then
                            exitRE:FireServer()
                        end
                        lp:SetAttribute("AutoTrainAreaID", nil)
                    end)
                end
            end
        end
    end, "AutoRebirth")

    task.spawn(function()
        applyBarrierBypass()

        while STATE.Running do
            if STATE.GodMode then
                applyGodMode()
            end
            applyBarrierBypass()

            if (STATE.AutoFarm or STATE.InstaKill) and not STATE.Zone27Loop and not STATE.TowerFarm then
                killStageEnemies()
            end

            task.wait(0.35)
        end
    end)

    say("RealOrCake", "Loaded successfully", "circlecheck")
end

local ok, err = pcall(main)
if not ok then
    cleanup()
    report("No se pudo iniciar: " .. tostring(err))
end
