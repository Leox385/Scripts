if _G.CarSpeedModCleanup then
    pcall(_G.CarSpeedModCleanup)
end

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local lp = Players.LocalPlayer

local success, res = pcall(function()
    return httpget("https://raw.githubusercontent.com/9mfg/rem-ui/main/rem.lua")
end)
if not success or not res then
    res = game:HttpGet("https://raw.githubusercontent.com/9mfg/rem-ui/main/rem.lua")
end

loadstring(res)()

local UI = Rem or _G.Rem or getfenv().Rem
assert(UI and UI.Alive, "Failed to load REM UI")

local Config = {
    Enabled = true,
    TargetSpeed = 400,
    AccelRate = 180,
    InstantMode = false,
    BrakeAssist = true,
    StabilityAssist = true,
    Running = true
}

local STUDS_TO_KMH = 1.008

local function GetCurrentVehicle()
    local char = lp.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local vf = workspace:FindFirstChild("Vehicles")
    if not vf then return nil end

    local myCar = vf:FindFirstChild(tostring(lp.UserId))
    if myCar then
        local p = myCar:FindFirstChild("Primary") or myCar.PrimaryPart
        if p and p:IsA("BasePart") and (hrp.Position - p.Position).Magnitude < 18 then
            return myCar
        end
    end

    for _, car in ipairs(vf:GetChildren()) do
        local p = car:FindFirstChild("Primary") or car.PrimaryPart
        if p and p:IsA("BasePart") and (hrp.Position - p.Position).Magnitude < 18 then
            return car
        end
    end

    return nil
end

local Tab = UI:AddTab({
    Title = "Vehicle",
    Icon = "script"
})

local TelemetryLabel = Tab:AddLabel({
    Title = "Telemetry",
    Description = "Vehicle: None | Speed: 0 KM/H"
})

local EnableToggle = Tab:AddToggle({
    Title = "Speed Override",
    Description = "Enable custom speed modifier",
    Default = true,
    Callback = function(val)
        Config.Enabled = val
        UI:Notify({
            Title = "Speed Override",
            Content = val and string.format("Enabled: %d KM/H", Config.TargetSpeed) or "Disabled",
            Type = val and "success" or "info",
            Duration = 2
        })
    end
})

local SpeedSlider = Tab:AddSlider({
    Title = "Max Speed (KM/H)",
    Description = "Target vehicle speed",
    Min = 100,
    Max = 600,
    Step = 10,
    Default = 400,
    Callback = function(val)
        Config.TargetSpeed = val
    end
})

Tab:AddDropdown({
    Title = "Acceleration Mode",
    Description = "Acceleration rate",
    Options = {
        "Fast (+180 km/h/s)",
        "Smooth (+80 km/h/s)",
        "Extreme (+300 km/h/s)",
        "Instant"
    },
    Default = "Fast (+180 km/h/s)",
    Callback = function(mode)
        if mode == "Instant" then
            Config.InstantMode = true
        elseif mode == "Smooth (+80 km/h/s)" then
            Config.InstantMode = false
            Config.AccelRate = 80
        elseif mode == "Fast (+180 km/h/s)" then
            Config.InstantMode = false
            Config.AccelRate = 180
        elseif mode == "Extreme (+300 km/h/s)" then
            Config.InstantMode = false
            Config.AccelRate = 300
        end
    end
})

Tab:AddToggle({
    Title = "Brake Assist",
    Description = "Rapid stopping when braking",
    Default = true,
    Callback = function(val)
        Config.BrakeAssist = val
    end
})

Tab:AddToggle({
    Title = "Stability Assist",
    Description = "Keeps car grounded at high speeds",
    Default = true,
    Callback = function(val)
        Config.StabilityAssist = val
    end
})

Tab:AddButton({
    Title = "Set to 400 KM/H",
    Description = "Shortcut to 400 KM/H",
    ButtonText = "400 KM/H",
    Callback = function()
        SpeedSlider:SetValue(400)
        Config.TargetSpeed = 400
        if not Config.Enabled then
            EnableToggle:SetValue(true)
            Config.Enabled = true
        end
        UI:Notify({
            Title = "Speed",
            Content = "Target set to 400 KM/H",
            Type = "success",
            Duration = 2
        })
    end
})

Tab:AddButton({
    Title = "Reset to 200 KM/H",
    Description = "Shortcut to factory speed",
    ButtonText = "200 KM/H",
    Callback = function()
        SpeedSlider:SetValue(200)
        Config.TargetSpeed = 200
        UI:Notify({
            Title = "Speed",
            Content = "Reset to 200 KM/H",
            Type = "info",
            Duration = 2
        })
    end
})

Tab:Select()

task.spawn(function()
    local lastTick = os.clock()
    local lastTelemetry = 0

    while Config.Running do
        pcall(function()
            local now = os.clock()
            local dt = math.min(0.1, now - lastTick)
            lastTick = now

            local car = GetCurrentVehicle()
            if car then
                local primary = car:FindFirstChild("Primary") or car.PrimaryPart
                if primary and primary:IsA("BasePart") then
                    local currentVel = primary.AssemblyLinearVelocity or primary.Velocity or Vector3.new(0, 0, 0)
                    
                    local rawLook = -primary.CFrame.LookVector
                    local flatLook = Vector3.new(rawLook.X, 0, rawLook.Z)
                    if flatLook.Magnitude > 0.001 then
                        flatLook = flatLook.Unit
                    else
                        flatLook = rawLook
                    end

                    local forwardSpeedStuds = currentVel:Dot(flatLook)
                    local currentKmh = math.max(0, forwardSpeedStuds * STUDS_TO_KMH)

                    if now - lastTelemetry >= 0.25 then
                        lastTelemetry = now
                        TelemetryLabel:SetValue(string.format("Car: %s | Speed: %d KM/H | Target: %d KM/H", car.Name, math.round(currentKmh), Config.TargetSpeed))
                    end

                    if Config.Enabled then
                        local isAccel = UserInputService:IsKeyDown(119) or UserInputService:IsKeyDown(273) or UserInputService:IsKeyDown(1005) or (iskeypressed and (iskeypressed(87) or iskeypressed(38)))
                        local isBrake = UserInputService:IsKeyDown(115) or UserInputService:IsKeyDown(274) or UserInputService:IsKeyDown(32) or UserInputService:IsKeyDown(1004) or (iskeypressed and (iskeypressed(83) or iskeypressed(40) or iskeypressed(32)))

                        if isBrake and Config.BrakeAssist then
                            if currentKmh > 20 then
                                local brakePower = (350 / STUDS_TO_KMH) * dt
                                local deltaBrake = math.min(forwardSpeedStuds, brakePower)
                                primary.AssemblyLinearVelocity = currentVel - flatLook * deltaBrake
                            end
                        elseif isAccel then
                            local targetKmh = Config.TargetSpeed
                            local targetStuds = targetKmh / STUDS_TO_KMH

                            if currentKmh < targetKmh then
                                if Config.InstantMode then
                                    primary.AssemblyLinearVelocity = flatLook * targetStuds + Vector3.new(0, currentVel.Y, 0)
                                else
                                    local deltaKmh = Config.AccelRate * dt
                                    local newKmh = math.min(targetKmh, currentKmh + deltaKmh)
                                    local addedStuds = (newKmh - currentKmh) / STUDS_TO_KMH
                                    primary.AssemblyLinearVelocity = currentVel + flatLook * addedStuds
                                end
                            elseif currentKmh > targetKmh + 8 then
                                local excessStuds = (currentKmh - targetKmh) / STUDS_TO_KMH
                                local bleedStuds = math.min(excessStuds, (80 / STUDS_TO_KMH) * dt)
                                primary.AssemblyLinearVelocity = currentVel - flatLook * bleedStuds
                            end

                            if Config.StabilityAssist and currentKmh > 180 then
                                local liveVel = primary.AssemblyLinearVelocity or currentVel
                                if liveVel and liveVel.Y > 0.5 then
                                    primary.AssemblyLinearVelocity = Vector3.new(liveVel.X, math.max(-6, liveVel.Y - 15 * dt), liveVel.Z)
                                end
                            end
                        end
                    end
                end
            else
                if now - lastTelemetry >= 0.5 then
                    lastTelemetry = now
                    TelemetryLabel:SetValue("Not driving (enter driver seat)")
                end
            end
        end)

        task.wait(0.04)
    end
end)

_G.CarSpeedModCleanup = function()
    Config.Running = false
    if UI and UI.Destroy then
        pcall(function() UI:Destroy() end)
    end
end
