        return 1
    else
        local num = tonumber(selectedReloadSlot:match("%d+"))
        return num or 1
    end
end

local function reloadPlotSlot(slot)
    slot = slot or 1
    local rs = game:GetService("ReplicatedStorage")
    local req = rs:FindFirstChild("LoadSaveRequests")
    if not req then return false, "LoadSaveRequests not found" end
    
    local mayLoad = req:FindFirstChild("ClientMayLoad")
    local reqLoad = req:FindFirstChild("RequestLoad")
    
    if mayLoad then
        local canLoad, err = mayLoad:InvokeServer(lp)
        if not canLoad then
            return false, err or "Cannot load right now (Cooldown active)"
        end
    end
    
    if reqLoad then
        local success, msg = reqLoad:InvokeServer(slot, lp)
        return success, msg
    end
    
    return false, "RequestLoad remote not available"
end

