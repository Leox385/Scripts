						local selected = {}
						for _, option in ipairs(el.options) do
							if type(value) == "table" then
								if value[option] == true then selected[option] = true end
								for _, entry in ipairs(value) do if entry == option then selected[option] = true end end
							end
						end
						value = selected
					else
						local found = false
						for _, option in ipairs(el.options) do if option == value then found = true end end
						if not found then value = el.options[1] end
					end
