local output = warn or print
local function report(message)
    if type(output) == "function" then pcall(output, "[LootForge] " .. tostring(message)) end
end
local function safeGet(object, key)
    local ok, value = pcall(function() return object[key] end)
    if ok then return value end
end
local hostTask = task or {}
local hostSpawn, hostWait = hostTask.spawn or spawn, hostTask.wait or wait
local clock = tick or (os and os.clock)
if type(hostSpawn) ~= "function" or type(hostWait) ~= "function" or type(clock) ~= "function"
    or not Drawing or type(Drawing.new) ~= "function"
    or not coroutine or type(coroutine.create) ~= "function"
    or type(coroutine.resume) ~= "function" or type(coroutine.yield) ~= "function"
    or type(coroutine.running) ~= "function" or type(coroutine.status) ~= "function" then
    report("Entorno incompatible: se requieren Drawing.new, spawn/wait, coroutines y un reloj.")
    return
end
if type(_G.MatchaLootForgeHubCleanup) == "function" then pcall(_G.MatchaLootForgeHubCleanup) end
local alive, Non, Window, STATE = true, nil, nil, nil
local contexts, revisions = {}, {}
local WAIT = {}
local releaseInputs
local cleanup
local function validContext(ctx)
    return alive and (not ctx or not ctx.mode or
        (STATE and STATE[ctx.mode] and ctx.revision == (revisions[ctx.mode] or 0)))
end
local function check()
    return validContext(contexts[coroutine.running()])
end
local task = {}
function task.wait(seconds)
    local began = clock()
    local duration = math.max(0.01, tonumber(seconds) or 0.03)
    if contexts[coroutine.running()] then
        coroutine.yield(WAIT, duration)
    else
        hostWait(duration)
    end
    return clock() - began
end
local function spawnWorker(fn, mode)
    return hostSpawn(function()
        hostWait(0.03)
        local failures = 0
        while alive do
            if mode and (not STATE or not STATE[mode]) then
                hostWait(0.15)
            else
                local child = coroutine.create(fn)
                local ctx = mode and {mode=mode, revision=revisions[mode] or 0} or {}
                contexts[child] = ctx
                local failed, failure, finished = false, nil, false
                while validContext(ctx) do
                    local ok, signal, delay = coroutine.resume(child)
                    if not ok then failed, failure = true, signal; break end
                    if coroutine.status(child) == "dead" then finished = true; break end
                    if signal ~= WAIT then
                        failed, failure = true, "Espera externa no compatible en tarea administrada"
                        break
                    end
                    local deadline = clock() + delay
                    repeat
                        if not validContext(ctx) then break end
                        hostWait(math.min(0.05, math.max(0.01, deadline - clock())))
                    until clock() >= deadline
                end
                contexts[child] = nil
                child = nil
                if not finished and releaseInputs then releaseInputs() end
                if finished then break end
                if failed then
                    failures = failures + 1
                    report("Tarea " .. (mode or "general") .. ": " .. tostring(failure))
                    if failures >= 3 then
                        if mode then STATE[mode] = false end
                        report("Tarea detenida tras 3 errores; revisa la compatibilidad del juego.")
                        break
                    end
                    hostWait(1)
                end
            end
        end
    end)
end
function task.spawn(fn) return spawnWorker(fn) end
