local function say(title, body, icon)
    if Non and Non.Notify then
        pcall(function()
            Non:Notify({
                Title = title,
                Content = body,
                Icon = icon or "circlecheck",
                Duration = 3
            })
        end)
    end
end

local function getHRP()
    local char = lp.Character
    return char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso"))
end

local function teleportTo(pos)
    if not pos then return false end
    local hrp = getHRP()
    if not hrp then return false end
    local x, y, z = pos.X, pos.Y + 3.5, pos.Z
    pcall(function() hrp.CFrame = CFrame.new(x, y, z) end)
    pcall(function() hrp.Position = Vector3.new(x, y, z) end)
    return true
end

local function getStagePosition(stageNum)
    local targetPos = nil
    pcall(function()
        local sm = Workspace:FindFirstChild("WorldModel") and Workspace.WorldModel:FindFirstChild("StageMap")
        local ep = sm and sm:FindFirstChild("EnemyPoint")
        local stageModel = ep and ep:FindFirstChild("Stage_" .. stageNum)
        if stageModel then
            for _, child in ipairs(stageModel:GetChildren()) do
                if child.ClassName == "Part" or child:IsA("BasePart") then
                    targetPos = child.Position
                    break
                end
            end
        end
    end)
    if not targetPos then
        targetPos = STAGE_COORDS[stageNum]
    end
    return targetPos
end

local function teleportToStage(stageNum)
    local pos = getStagePosition(stageNum)
    if pos and teleportTo(pos) then
        say("Teleport", "Teleported to Zone " .. stageNum, "circlecheck")
    else
        say("Teleport", "Failed to teleport to Zone " .. stageNum, "circlex")
    end
end

local function getBestTrainArea()
    local rebirths = 0
    pcall(function()
        local eco = lp:FindFirstChild("Eco")
        if eco and eco:FindFirstChild("rebirth") then
            rebirths = tonumber(eco.rebirth.Value) or 0
        end
    end)

    local helper = nil
    pcall(function()
        helper = require(ReplicatedStorage.Config.TrainArea.Helper)
    end)

    for _, area in ipairs(AUTO_TRAIN_AREAS) do
        local need = area.needRebirth
        if helper and helper.GetNeedRebirth then
            pcall(function()
                need = helper.GetNeedRebirth(area.id) or need
            end)
        end
        if rebirths >= need then
            local livePos = area.pos
            pcall(function()
                local touched = Workspace:FindFirstChild("TOUCHED")
                local trainAreaFolder = touched and touched:FindFirstChild("AutoTrainArea")
                local part = trainAreaFolder and trainAreaFolder:FindFirstChild(tostring(area.id))
                if part and (part.ClassName == "Part" or part:IsA("BasePart")) then
                    livePos = part.Position
                end
            end)
            return area, livePos, rebirths
        end
    end

    local fallback = AUTO_TRAIN_AREAS[#AUTO_TRAIN_AREAS]
    return fallback, fallback.pos, rebirths
end

local function applyGodMode()
    if not STATE.GodMode then return end
    local hpVal = lp:FindFirstChild("HPValue")
    if hpVal then
        if hpVal.Value < 900000000 then hpVal.Value = 999999999 end
        local maxHp = hpVal:GetAttribute("MaxHP")
        if not maxHp or maxHp < 900000000 then hpVal:SetAttribute("MaxHP", 999999999) end
    end
end

local function applyBarrierBypass()
    local wm = Workspace:FindFirstChild("WorldModel")
    local sm = wm and wm:FindFirstChild("StageMap")
    local boards = sm and sm:FindFirstChild("Boards")
    if boards then
        for _, b in ipairs(boards:GetChildren()) do
            if b.ClassName == "Part" or b:IsA("BasePart") then
                b.CanCollide = not STATE.BypassBarriers
            end
        end
    end
end

local function killStageEnemies()
    local enemyFolder = Workspace:FindFirstChild("EnemyFolder")
    if not enemyFolder then return 0 end
    local count = 0
    for _, enemy in ipairs(enemyFolder:GetChildren()) do
        local hp = enemy:FindFirstChild("HPValue")
        if hp and hp.Value > 0 then
            hp.Value = 0
            count = count + 1
        end
    end
    return count
end

local function redeemAllRewards()
    task.spawn(function()
        if remotes and remotes:FindFirstChild("Code") and remotes.Code:FindFirstChild("TryUseCodeRF") then
            local codeRF = remotes.Code.TryUseCodeRF
            for _, code in ipairs(PROMO_CODES) do
                pcall(function() codeRF:InvokeServer(code) end)
                task.wait(0.08)
            end
        end
        pcall(function()
            if remotes.Dungeon then remotes.Dungeon.TryClaimDailyDunTicRE:FireServer() end
            if remotes.Offline then remotes.Offline.TryClaimOfflineRewardRE:FireServer() end
            if remotes.UpdateLog then remotes.UpdateLog.TryClaimUPDRewardRE:FireServer() end
            if remotes.Online then
                for i = 1, 12 do remotes.Online.TryClaimRE:FireServer(i) end
            end
        end)
    end)
end

