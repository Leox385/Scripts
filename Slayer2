local function findNearestTrainingPrompt(hrp, maxDist)
    local tr = Workspace:FindFirstChild("Training")
    if not tr or not hrp then return nil, nil end
    local bestPrompt = nil
    local bestPart = nil
    local bestDist = maxDist or 45.0
    
    for _, folder in ipairs(tr:GetChildren()) do
        for _, desc in ipairs(folder:GetDescendants()) do
            if desc.Name == "ProximityPrompt" or desc.ClassName == "ProximityPrompt" then
                local part = desc.Parent
                if part and (part.ClassName == "Part" or part.ClassName == "MeshPart") then
                    local d = (part.Position - hrp.Position).Magnitude
                    if d < bestDist then
                        bestDist = d
                        bestPrompt = desc
                        bestPart = part
                    end
                end
            end
        end
    end
    return bestPrompt, bestPart
end

