MagnetTab:Button({
    Title = "Attract Selected Item",
    Desc = "Brings all instances of the selected item in a compact circle at your feet",
    Icon = "target",
    Callback = function()
        if not itemsFolder or selectedItemName == "" or selectedItemName:find("No items") then
            Notify("Error", "Please select a valid item from the list first.", "trianglealert")
            return
        end

        local cleanName = selectedItemName:gsub("%s*%([%d]+%)%s*$", "")
        local selectedList = {}
        for _, item in ipairs(itemsFolder:GetChildren()) do
            if item.Name == cleanName then
                table.insert(selectedList, item)
            end
        end
        SafeBatchTeleport(selectedList, itemsDestination, cleanName)
    end
})

