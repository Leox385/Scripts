			minimized = false
			visible = true
		else
			visible = not visible
		end
	end
	local function pollKeys(now)
		if not POLL then return end
		if type(isrbxactive) == "function" and not isrbxactive() then return end
		if activeCaptor then
			if now - (activeCaptor.listenT or 0) > 0.12 then
				for vk = 0x02, 0xFE do
					if keyEdge(vk) then
						captureKey(vk)
						break
					end
				end
			end
			return
		end
		if activeInput then
			local shift = iskeypressed(0x10)
			for _, vk in ipairs(TYPE_KEYS) do
				if keyEdge(vk) then typeKey(vk, shift) end
			end
			return
		end
		if keyEdge(togKey) then toggleUI() end
		for _, tab in ipairs(tabs) do
			for _, el in ipairs(tab.elems) do
				if el.type == "keybind" then
					local down = el.key > 0 and iskeypressed(el.key) == true
					local hit = down and not el.keyDown
					el.keyDown = down
					local value = el.enabled
					if el.mode == "hold" then value = down elseif el.mode == "always" then value = true
					elseif hit then value = el.mode == "click" and true or not value
					elseif el.mode == "click" then value = false end
					if value ~= el.enabled then el.enabled = value; fire(el.onTriggered, value, el.key) end
				end
			end
		end
	end
	local function isDown()
		if type(isrbxactive) == "function" and not isrbxactive() then return false end
		if type(ismouse1pressed) == "function" then return ismouse1pressed() == true end
		if POLL then return iskeypressed(0x01) == true end
		if typeOf(ismouse1pressed) == "function" then
			local ok, r = pcall(ismouse1pressed)
			if ok then return r end
		end
		local ok, r = pcall(function() return UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) end)
		return ok and r or false
	end
	local function hideTab(tab)
		if not tab then return end
		for _, el in ipairs(tab.elems) do
