	local function fitLabel(el, room)
		local d = el.d.lbl
		local full = el.fullTitle or d.Text
		room = math.max(0, math.floor(room))
		if el.fitWidth == room and el.fitTitle == full and el.fitSize == d.Size then return end
        el.fitSize = d.Size
		el.fitWidth, el.fitTitle = room, full
		d.Text = full
		if textW(d, d.Size or 15, false) <= room then return end
		local lo, hi = 0, #full
		while lo < hi do
			local mid = math.floor((lo + hi + 1) / 2)
			d.Text = utf8Prefix(full, mid) .. "..."
			if textW(d, d.Size or 15, false) <= room then lo = mid else hi = mid - 1 end
		end
		d.Text = lo > 0 and (utf8Prefix(full, lo) .. "...") or ""
	end

