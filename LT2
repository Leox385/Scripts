local function getChar()
    local char = lp.Character or lp.CharacterAdded:Wait()
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")
    return char, root, hum
end

local function safeTeleport(target)
    local _, root = getChar()
    if not root then return false end
    local cf = nil
    if typeof(target) == "CFrame" then
        cf = target
    elseif typeof(target) == "Vector3" then
        cf = CFrame.new(target.X, target.Y, target.Z)
    end
    if cf then
        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        root.Velocity = Vector3.new(0, 0, 0)
        root.CFrame = cf
        return true
    end
    return false
end

local function getMyPlot()
    local props = workspace:FindFirstChild("Properties")
    if not props then return nil end
    for _, p in ipairs(props:GetChildren()) do
        local o = p:FindFirstChild("Owner")
        if o and o.Value then
            local str = tostring(o.Value)
            if str:find(lp.Name) or (pcall(function() return o.Value.UserId == lp.UserId end) and o.Value.UserId == lp.UserId) then
                return p
            end
        end
    end
    return nil
end

local function teleportToMyPlot()
    local plot = getMyPlot()
    if not plot then return false end
    local origin = plot:FindFirstChild("OriginSquare")
    local pos = origin and origin.Position or (plot:FindFirstChildWhichIsA("BasePart") and plot:FindFirstChildWhichIsA("BasePart").Position)
    if pos then
        return safeTeleport(pos + Vector3.new(0, 5, 0))
    end
    return false
end

local function isAxeTool(t)
    if not t or t.ClassName ~= "Tool" then return false end
    if t:FindFirstChild("CuttingTool") or t:FindFirstChild("ToolName") then return true end
    local name = t.Name:lower()
    if name:find("axe") or name:find("hatchet") then return true end
    local tip = ""
    pcall(function() tip = t.ToolTip:lower() end)
    if tip:find("axe") or tip:find("hatchet") then return true end
    return false
end

local function getToolAxeInfo(axe)
    if not axe then return "BasicHatchet", {damage = 0.20, cooldown = 0.65} end
    local tnObj = axe:FindFirstChild("ToolName")
    local tip = ""
    pcall(function() tip = axe.ToolTip end)
    
    local nameCandidates = {
        tnObj and tnObj.Value ~= "" and tnObj.Value or nil,
        tip ~= "" and tip or nil,
        (axe.Name ~= "Tool" and axe.Name ~= "") and axe.Name or nil
    }
    
    for _, cand in ipairs(nameCandidates) do
        if cand then
            if axeStats[cand] then
                return cand, axeStats[cand]
            end
            for name, data in pairs(axeStats) do
                if cand:lower():find(name:lower(), 1, true) or name:lower():find(cand:lower(), 1, true) then
                    return name, data
                end
            end
        end
    end
    return "BasicHatchet", {damage = 0.20, cooldown = 0.65}
end

local function ensureAxeEquipped()
    local char, root, hum = getChar()
    if not char then return nil end

    for _, t in ipairs(char:GetChildren()) do
        if isAxeTool(t) then
            return t
        end
    end

    local bp = lp:FindFirstChild("Backpack")
    if bp then
        for _, t in ipairs(bp:GetChildren()) do
            if isAxeTool(t) then
                t.Parent = char
                task.wait(0.3)
                return t
            end
        end
    end

    local pm = workspace:FindFirstChild("PlayerModels")
    if pm and root then
        for _, item in ipairs(pm:GetChildren()) do
            local o = item:FindFirstChild("Owner")
            local tn = item:FindFirstChild("ToolName")
            local iname = item:FindFirstChild("ItemName")
            local rawName = (iname and iname.Value ~= "" and iname.Value) or (tn and tn.Value ~= "" and tn.Value) or item.Name
            local isAxe = rawName:lower():find("axe") or rawName:lower():find("hatchet")
            if isAxe and o and tostring(o.Value):find(lp.Name) then
                local main = item:FindFirstChild("Main") or item:FindFirstChildWhichIsA("BasePart")
                if main and (main.Position - root.Position).Magnitude < 60 then
                    ClientInteracted:FireServer(item, "Pick up tool")
                    task.wait(0.3)
                    for _, t in ipairs(char:GetChildren()) do
                        if isAxeTool(t) then return t end
                    end
                    if bp then
                        for _, t in ipairs(bp:GetChildren()) do
                            if isAxeTool(t) then
                                t.Parent = char
                                task.wait(0.25)
                                return t
                            end
                        end
                    end
                end
            end
        end
    end

    return nil
end

local function findLowestSection(tree)
    if not tree or not tree.Parent then return nil end

    for _, p in ipairs(tree:GetChildren()) do
        if p.Name == "WoodSection" and p:FindFirstChild("ID") and p.ID.Value == 1 then
            return p
        end
    end

    local lowestSection, lowestY = nil, math.huge
    for _, p in ipairs(tree:GetChildren()) do
        if p.Name == "WoodSection" and p:FindFirstChild("ID") then
            if p.Position.Y < lowestY then
                lowestY = p.Position.Y
                lowestSection = p
            end
        end
    end
    return lowestSection
end

local function isSpecialTree(p, r, g, b, val)
    if val ~= "" and val ~= "oak" and val ~= "generic" then return true end
    if (p.Y > 300 and p.Z > 2500) or (r > 230 and g > 225 and b > 225) then return true end
    if (p.Y > 300 and p.X < -1400) or (r > 180 and g < 60 and b < 50) then return true end
    if (p.Y < -50) or (b > 80 and r < 30 and g < 40) then return true end
    if (p.Z > 650 and p.Z < 1550 and p.X > 50 and p.X < 450 and r > 90 and g < 80) then return true end
    if (p.X < -700 and p.X > -1500 and p.Z < -600 and p.Z > -1200) or (r > 220 and g > 160 and b < 80) then return true end
    if (p.Y < 5 and (p.X > 1800 or p.Z < -1400)) then return true end
    if (p.X > 4000 and p.Z > -1000) then return true end
    if (p.Z > 1800 and p.Z < 2500 and p.X > 1000) then return true end
    if (r > 240 and g > 240 and b < 215) then return true end
    return false
end

local function matchesTreeClass(tree, targetType)
    if not tree or not tree.Parent then return false end
    if targetType == "All (Nearest)" then return true end

    local tc = tree:FindFirstChild("TreeClass")
    local val = (tc and tc.Value or ""):lower()
    local target = (targetType or ""):lower()

    if val ~= "" then
        if target == "goldswampy" and (val:find("gold") or val:find("swamp")) then return true end
        if target == "cavecrawler" and (val:find("cave") or val:find("crawler")) then return true end
        if target == "snowglow" and (val:find("snow") or val:find("glow")) then return true end
        if val == target or val:find(target, 1, true) then return true end
    end

    local ws = tree:FindFirstChild("WoodSection")
    if not ws then return false end

    local p = ws.Position
    local r, g, b = ws.Color.R, ws.Color.G, ws.Color.B

    if target == "frost" or target == "snowglow" then
        return (p.Y > 300 and p.Z > 2500) or (r > 230 and g > 225 and b > 225)
    elseif target == "volcano" then
        return (p.Y > 300 and p.X < -1400) or (r > 180 and g < 60 and b < 50)
    elseif target == "cavecrawler" then
        return (p.Y < -50) or (b > 80 and r < 30 and g < 40)
    elseif target == "cherry" then
        return (p.Z > 650 and p.Z < 1550 and p.X > 50 and p.X < 450 and r > 90 and g < 80)
    elseif target == "goldswampy" then
        return (p.X < -700 and p.X > -1500 and p.Z < -600 and p.Z > -1200) or (r > 220 and g > 160 and b < 80)
    elseif target == "palm" then
        return (p.Y < 5 and (p.X > 1800 or p.Z < -1400))
    elseif target == "koa" then
        return (p.X > 4000 and p.Z > -1000)
    elseif target == "fir" then
        return (p.Z > 1800 and p.Z < 2500 and p.X > 1000)
    elseif target == "birch" then
        return (r > 240 and g > 240 and b < 215)
    elseif target == "oak" or target == "generic" then
        return not isSpecialTree(p, r, g, b, val)
    end

    return false
end

local function findTreeLowest(targetType, maxDist)
    local _, root = getChar()
    if not root then return nil, nil, math.huge end
    maxDist = maxDist or math.huge

    local bestTree, bestSection = nil, nil
    local shortestDist = maxDist

    for _, region in ipairs(workspace:GetChildren()) do
        if region.Name == "TreeRegion" then
            for _, tree in ipairs(region:GetChildren()) do
                if tree:FindFirstChild("CutEvent") and matchesTreeClass(tree, targetType) then
                    local lowestSection = findLowestSection(tree)
                    if lowestSection then
                        local d = (lowestSection.Position - root.Position).Magnitude
                        if d < shortestDist then
                            shortestDist = d
                            bestTree = tree
                            bestSection = lowestSection
                        end
                    end
                end
            end
        end
    end
    return bestTree, bestSection, shortestDist
end

local function strikeSectionLegit(tree, section, axe)
    if not tree or not section or not axe then return false, 0.5 end
    local cutEvent = tree:FindFirstChild("CutEvent")
    local sectionId = section:FindFirstChild("ID")
    if not cutEvent or not sectionId then return false, 0.5 end

    local char = lp.Character
    if not char then return false, 0.5 end

    if axe.Parent ~= char then
        axe.Parent = char
        task.wait(0.25)
    end
    if axe.Parent ~= char then return false, 0.5 end

    local _, stats = getToolAxeInfo(axe)

    local height = 0.5
    if section.ClassName == "Part" or section.ClassName == "MeshPart" then
        local sy = section.Size and section.Size.Y or 2
        height = math.clamp(sy * 0.3, 0.2, math.max(0.4, sy - 0.2))
    end

    local waitTime = stats.cooldown or 0.65

    RemoteProxy:FireServer(cutEvent, {
        ["sectionId"] = sectionId.Value,
        ["faceVector"] = Vector3.new(0, 0, -1),
        ["height"] = height,
        ["hitPoints"] = stats.damage,
        ["cooldown"] = stats.cooldown,
        ["cuttingClass"] = "Axe",
        ["tool"] = axe
    })
    return true, waitTime
end

local function smartBringLog(log, savedPos)
    local main = nil
    for _, p in ipairs(log:GetChildren()) do
        if p.ClassName == "Part" or p.ClassName == "MeshPart" then
            main = p
            break
        end
    end
    if not main then return false end

    local _, root = getChar()
    if not root then return false end

    local dist = (main.Position - root.Position).Magnitude
    if dist > 200 then
        safeTeleport(main.CFrame + Vector3.new(0, 3, 0))
        task.wait(0.12)
    end

    ClientIsDragging:FireServer(log)
    task.wait(0.08)

    if dist > 200 then
        safeTeleport(savedPos)
        task.wait(0.08)
    end

    local targetLanding = savedPos.Position + Vector3.new(math.random(-3, 3), 3, math.random(-3, 3))
    local delta = targetLanding - main.Position

    for _, p in ipairs(log:GetChildren()) do
        if p.ClassName == "Part" or p.ClassName == "MeshPart" then
            p.CFrame = p.CFrame + delta
            p.Velocity = Vector3.new(0, 0, 0)
            p.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end
    end
    return true
end

local function executeWoodMagnet()
    local _, root = getChar()
    if not root then return end

    local lm = workspace:FindFirstChild("LogModels")
    if not lm then return end

    local logs = lm:GetChildren()
    local savedPos = root.CFrame
    local broughtCount = 0

    Non:Notify({Title = "Tree", Content = "Executing log fetch sequence...", Icon = "magnet", Duration = 2})

    task.spawn(function()
        for _, log in ipairs(logs) do
            local o = log:FindFirstChild("Owner")
            local ownerStr = o and tostring(o.Value) or ""
            local isEligible = false

            if bringFilterMode == "All Logs (of all the players)" then
                isEligible = true
            else
                if not o or not o.Value or ownerStr:find("Unreadable") or ownerStr == "nil" or ownerStr:find(lp.Name) then
                    isEligible = true
                end
            end

            if isEligible then
                local success = smartBringLog(log, savedPos)
                if success then
                    broughtCount = broughtCount + 1
                    task.wait(0.15)
                end
            end
        end

        safeTeleport(savedPos)
        Non:Notify({
            Title = "Fetch Complete",
            Content = string.format("Successfully brought %d logs.", broughtCount),
            Icon = "circle-check",
            Duration = 4
        })
    end)
end

local function sellLogsAtWoodRUs()
    local lm = workspace:FindFirstChild("LogModels")
    if not lm then return end
    local sellPos = Vector3.new(315, -1.5, 85.5)
    local count = 0

    Non:Notify({Title = "Auto-Sell", Content = "Routing logs to vendor chute...", Duration = 2})

    task.spawn(function()
        for _, log in ipairs(lm:GetChildren()) do
            local o = log:FindFirstChild("Owner")
            local ownerStr = o and tostring(o.Value) or ""
            local isEligible = false

            if bringFilterMode == "All Logs (Forced)" then
                isEligible = true
            else
                if not o or not o.Value or ownerStr:find(lp.Name) or ownerStr:find("Unreadable") or ownerStr == "nil" then
                    isEligible = true
                end
            end

            if isEligible then
                ClientIsDragging:FireServer(log)
                task.wait(0.04)
                local main = nil
                for _, p in ipairs(log:GetChildren()) do
                    if p.ClassName == "Part" or p.ClassName == "MeshPart" then
                        main = p
                        break
                    end
                end
                if main then
                    local delta = sellPos - main.Position
                    for _, p in ipairs(log:GetChildren()) do
                        if p.ClassName == "Part" or p.ClassName == "MeshPart" then
                            p.CFrame = p.CFrame + delta
                            p.Velocity = Vector3.new(0, -10, 0)
                            p.AssemblyLinearVelocity = Vector3.new(0, -10, 0)
                        end
                    end
                    count = count + 1
                    task.wait(0.08)
                end
            end
        end
        Non:Notify({
            Title = "Logs Sold",
            Content = string.format("Injected %d logs into Wood R Us.", count),
            Icon = "circle-check",
            Duration = 4
        })
    end)
end

local function expandPlotToMax()
    local myProp = getMyPlot()
    if not myProp then
        return Non:Notify({Title = "Error", Content = "No active plot found in server.", Icon = "alert-triangle", Duration = 3})
    end

    local origin = myProp:FindFirstChild("OriginSquare")
    if not origin then
        return Non:Notify({Title = "Error", Content = "OriginSquare missing from plot.", Icon = "alert-triangle", Duration = 3})
    end

    Non:Notify({Title = "Plot Expansion", Content = "Bypassing parcel grid limits...", Icon = "maximize-2", Duration = 3})

    task.spawn(function()
        local count = 0
        for dx = -2, 2 do
            for dz = -2, 2 do
                if not (dx == 0 and dz == 0) then
                    local cf = origin.CFrame * CFrame.new(dx * 40, 0, dz * 40)
                    ClientExpandedProperty:FireServer(myProp, cf)
                    count = count + 1
                    task.wait(0.04)
                end
            end
        end
        Non:Notify({
            Title = "Expansion Complete",
            Content = string.format("Unlocked 5x5 grid (%d parcels).", count),
            Icon = "circle-check",
            Duration = 4
        })
    end)
end

local function chopUntilFell(targetType)
    if isManualChopping then
        Non:Notify({Title = "Execution", Content = "Active. Please wait.", Icon = "info", Duration = 2})
        return
    end

    local axe = ensureAxeEquipped()
    if not axe then
        Non:Notify({Title = "Error", Content = "No valid axe found in inventory.", Icon = "alert-triangle", Duration = 3})
        return
    end

    local tree, section, dist = findTreeLowest(targetType)
    local char, root, hum = getChar()
    if not tree or not section or not root then
        Non:Notify({Title = "Not Found", Content = "No matching targets for: " .. targetType, Icon = "alert-triangle", Duration = 3})
        return
    end

    isManualChopping = true
    local tc = tree:FindFirstChild("TreeClass")
    local treeClassName = (tc and tc.Value ~= "") and tc.Value or "Standard"

    local cutPos = section.Position

    if dist > 14 then
        local targetPos = cutPos + Vector3.new(2.8, 0, 2.8)
        local lookTarget = Vector3.new(cutPos.X, targetPos.Y, cutPos.Z)
        safeTeleport(CFrame.lookAt(targetPos, lookTarget))
        task.wait(0.2)
    end

    Non:Notify({
        Title = "Active", 
        Content = string.format("Targeting %s until destruction...", treeClassName), 
        Icon = "zap", 
        Duration = 3
    })

    task.spawn(function()
        local startTime = tick()
        local maxDuration = 240
        local hits = 0

        while isManualChopping and (tick() - startTime < maxDuration) do
            if not tree or not tree.Parent or not tree:IsDescendantOf(workspace) then
                break
            end

            if not section or not section.Parent or not section:IsDescendantOf(tree) then
                section = findLowestSection(tree)
                if not section then
                    break
                end
            end

            local liveChar, liveRoot, liveHum = getChar()
            if not liveHum or liveHum.Health <= 0 or not liveRoot then
                break
            end

            local activeAxe = ensureAxeEquipped()
            if not activeAxe then break end

            local ok, waitTime = strikeSectionLegit(tree, section, activeAxe)
            if not ok then break end
            hits = hits + 1

            task.wait(waitTime or 0.4)
        end

        isManualChopping = false

        if not tree or not tree.Parent or not tree:IsDescendantOf(workspace) or not findLowestSection(tree) then
            Non:Notify({
                Title = "Target Destroyed",
                Content = string.format("Felled %s tree in %d hits.", treeClassName, hits),
                Icon = "circle-check",
                Duration = 4
            })
        else
            Non:Notify({
                Title = "Halted",
                Content = "Process interrupted.",
                Icon = "info",
                Duration = 3
            })
        end
    end)
end

