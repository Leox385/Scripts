        Icon = "refresh-cw",
        Duration = 3
    })
    
    -- 1. Send player directly to the exact point (78.2, -254.0, 56.9)
    if root then
        root.Velocity = Vector3.new(0, 0, 0)
        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        root.CFrame = CFrame.new(78.2, -254.0, 56.9)
    end
    
    task.spawn(function()
        local startChar = lp.Character or char
        local startHum = startChar and startChar:FindFirstChild("Humanoid")
        local isDead = false
        local t0 = os.clock()
        
        -- 2. Detect death
        while (os.clock() - t0) < 15 do
            if not startChar or not startChar.Parent then
                isDead = true
                break
            end
            if startHum and startHum.Health <= 0 then
                isDead = true
                break
            end
            if lp.Character and lp.Character ~= startChar then
                isDead = true
                break
            end
            task.wait(0.03)
        end
        
        -- 3. If death occurred, reload the plot immediately
        if isDead then
            local ok, msg = reloadPlotSlot(targetSlot)
            if ok then
                Non:Notify({
                    Title = "Plot Reloaded",
                    Content = string.format("Death detected! Slot %d reloaded.", targetSlot),
                    Icon = "circle-check",
                    Duration = 4
                })
            else
                Non:Notify({
                    Title = "Plot Reload Response",
                    Content = tostring(msg or "Slot reloaded. Place plot manually if prompted."),
                    Icon = "info",
                    Duration = 4
                })
            end
        else
            Non:Notify({
                Title = "Void & Reload",
                Content = "No death detected at destination.",
                Icon = "alert-circle",
                Duration = 3
            })
        end
        
        task.wait(1.5)
        isReloadCycleRunning = false
    end)
end

