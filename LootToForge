    local function tweenToPosition(targetPos, duration, isLoop)
        local startPos, hrp = getHRPPosition()
        if not startPos or not targetPos then return false end
        local began, d = clock(), math.max(0.1, duration or 1.5)
        repeat
            check()
            if isLoop and not STATE.Zone27Loop then return false end
            if getHRP() ~= hrp then return false end
            local alpha = math.min(1, (clock() - began) / d)
            local t = (1 - math.cos(alpha * math.pi)) / 2
            local pos = startPos + (targetPos - startPos) * t
            local ok = pcall(function() hrp.CFrame = CFrame.new(pos.X, pos.Y, pos.Z) end)
            if not ok then return false end
            if alpha >= 1 then return true end
            task.wait(0.04)
        until not STATE.Running
        return false
    end

