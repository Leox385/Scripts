local function clamp(v, a, b)
	if v < a then return a elseif v > b then return b end
	return v
end
local function lerp(a, b, t) return a + (b - a) * t end
local function approach(a, b, s)
	if a < b then return math.min(a + s, b) end
	return math.max(a - s, b)
end
local function easeOut(t)
	t = 1 - clamp(t, 0, 1)
	return 1 - t * t * t
end
local function easeBack(t)
	t = clamp(t, 0, 1) - 1
	local c = 1.70158
	return 1 + (c + 1) * t * t * t + c * t * t
end
local function mixC(a, b, t)
	if t <= 0 then return a elseif t >= 1 then return b end
	return Color3.fromRGB(
		math.floor((a.R + (b.R - a.R) * t) * 255 + 0.5),
		math.floor((a.G + (b.G - a.G) * t) * 255 + 0.5),
		math.floor((a.B + (b.B - a.B) * t) * 255 + 0.5)
	)
end
local function colorEq(a, b)
	return math.abs(a.R - b.R) < 0.01 and math.abs(a.G - b.G) < 0.01 and math.abs(a.B - b.B) < 0.01
end
local function toHex(c)
	return string.format("#%02X%02X%02X", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
end
local function inRect(px, py, x, y, w, h)
	return px >= x and px <= x + w and py >= y and py <= y + h
end
local function V(x, y) return Vector2.new(x, y) end
local function fmtNum(v, step)
	if step and step % 1 ~= 0 then
		return string.format((step < 0.1) and "%.2f" or "%.1f", v)
	end
	return tostring(math.floor(v + 0.5))
end
local function wrapText(str, maxChars)
	local lines, cur = {}, ""
	for word in string.gmatch(str, "%S+") do
		if cur == "" then
			cur = word
		elseif #cur + 1 + #word <= maxChars then
			cur = cur .. " " .. word
		else
			table.insert(lines, cur)
			cur = word
		end
	end
	if cur ~= "" then table.insert(lines, cur) end
	if #lines == 0 then lines = { "" } end
	return table.concat(lines, "\n"), #lines
end
local function fire(cb, ...)
	if type(cb) ~= "function" then return end
	local args, count = { ... }, select("#", ...)
	background(function()
		local ok, err = pcall(cb, unpackf(args, 1, count))
		if not ok then report("Callback: " .. tostring(err)) end
	end)
end

-- Cache host-facing Drawing writes. Animated values are still updated every frame.
local drawingOpacity, drawingAdapters = 1, {}
local function newDraw(kind, props)
	local raw = Drawing.new(kind)
	assert(raw, "Astra UI: Drawing.new failed for " .. tostring(kind))
	local cache, removed, measured, unsupported = {}, false, nil, {}
	local proxy = {}
	setmetatable(proxy, {
		__index = function(_, key)
			if key == "Remove" then
				return function()
					if not removed then raw:Remove(); removed = true end
				end
			end
			if key == "TextBounds" then
				if not measured then measured = safeGet(raw, "TextBounds") end
				return measured
			end
			if cache[key] ~= nil then return cache[key] end
			return raw[key]
		end,
		__newindex = function(_, key, value)
			if removed then return end
			local old = cache[key]
			if old == value then return end
			if old ~= nil and value ~= nil then
				if key == "Position" or key == "Size" or key == "From" or key == "To" then
					if type(value) ~= "number" and old.X == value.X and old.Y == value.Y then return end
				elseif key == "Color" or key == "OutlineColor" then
					if old.R == value.R and old.G == value.G and old.B == value.B then return end
				end
			end
			local target = key
			if kind == "Text" and key == "Size" and HAS_FONTSIZE then target = "FontSize" end
			if kind == "Square" and key == "Rounding" and HAS_CORNER then target = "Corner" end
			if unsupported[target] then return end
			local hostValue = key == "Transparency" and value * drawingOpacity or value
			local ok = pcall(function() raw[target] = hostValue end)
			if not ok then unsupported[target] = true; return end
			cache[key] = value
			if key == "Text" or key == "Size" or key == "Font" then measured = nil end
		end,
	})
	for k, v in pairs(props or {}) do pcall(function() proxy[k] = v end) end
	if HAS_T and cache.Transparency == nil then proxy.Transparency = 1 end
    drawingAdapters[#drawingAdapters + 1] = function()
        if not removed and HAS_T then pcall(function() raw.Transparency = (cache.Transparency or 1) * drawingOpacity end) end
    end
	return proxy
end
local function kill(d)
	pcall(function()
		d.Visible = false
		d:Remove()
	end)
end
local function textW(d, size, mono)
	if HAS_BOUNDS then
		local b = d.TextBounds
		if b and b.X > 1 then return b.X end
	end
	return #d.Text * (size or 13) * (mono and 0.6 or 0.54)
end

