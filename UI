			local sx = x + w - 46
			d.swOut.Position = V(sx - 2, y + 13); d.swOut.Size = V(34, 18); d.swOut.Color = mixC(T.Border, T.Text, el.hov * 0.6); d.swOut.Visible = v
			d.sw.Position = V(sx, y + 15); d.sw.Size = V(30, 14); d.sw.Color = el.color; d.sw.Visible = v
			d.hex.Text = toHex(el.color)
			d.hex.Position = V(sx - 12 - textW(d.hex, 10, true), y + 16); d.hex.Color = T.TextDim; d.hex.Visible = v
			local ty = y + hh + 6
			for i, c in ipairs(el.presets) do
				local t = el.tiles[i]
				local tx = x + 14 + (i - 1) * 34
				local tv = el.o > 0.6 and vis(ty, 20, cy, ch) and tx + 28 <= x + w
				local thot = tv and hoverOK and inRect(mx, my, tx, ty, 28, 20)
				if click and thot then
					el.color = c
					if el.flag then Kirin:Set(el.flag, c) end
					fire(el.callback, c)
				end
				t.sq.Position = V(tx, ty - (thot and 1 or 0)); t.sq.Size = V(28, 20); t.sq.Color = c; t.sq.Visible = tv
				t.ol.Position = V(tx - 2, ty - 2); t.ol.Size = V(32, 24); t.ol.Color = T.Text; t.ol.Visible = tv and colorEq(c, el.color)
			end
			return h

		elseif el.type == "input" then
			local h = el.height
			local v = vis(y, h, cy, ch)
			local bw = w - 28
			local bx, byy = x + 14, y + 37
			local hotBox = hoverOK and v and inRect(mx, my, bx, byy, bw, 27)
			local hot = hoverOK and v and inRect(mx, my, x, y, w, h)
			if click and hotBox then
				if activeInput ~= el then
					finishInput()
					if activeCaptor then activeCaptor.listening = false; activeCaptor = nil end
					activeInput = el
					el.focused = true
					snapshotKeys(0x08, 0xFE)
				end
			elseif rawClick and el.focused and not hotBox then
				finishInput()
			end
			row(el, x, y, w, h, v, hot or el.focused, dt)
			d.lbl.Position = V(x + 38, y + 11)
			el.f = lerp(el.f, el.focused and 1 or 0, math.min(dt * 12, 1))
			d.box.Position = V(bx, byy); d.box.Size = V(bw, 27); d.box.Color = mixC(T.BgAlt, T.Bg, el.f); d.box.Visible = v
			d.boxOl.Position = V(bx, byy); d.boxOl.Size = V(bw, 27); d.boxOl.Color = mixC(T.Border, T.Accent, el.f); d.boxOl.Visible = v
			local maxC = math.max(4, math.floor((bw - 16) / 6.6))
			local shown
			if el.text == "" and not el.focused then
				shown = el.placeholder
				if #shown > maxC then shown = string.sub(shown, 1, maxC - 2) .. ".." end
				d.txt.Color = T.TextDim
			else
				local s = el.text
				if #s > maxC - 1 then s = ".." .. string.sub(s, -(maxC - 3)) end
				shown = s .. ((el.focused and math.floor(now * 2.2) % 2 == 0) and "|" or "")
				d.txt.Color = T.Text
			end
			d.txt.Text = shown
			d.txt.Position = V(bx + 8, byy + 6); d.txt.Visible = v
			return h

		elseif el.type == "progressbar" then
			local h = el.height
			local v = vis(y, h, cy, ch)
			local hot = hoverOK and v and inRect(mx, my, x, y, w, h)
			row(el, x, y, w, h, v, hot, dt)
			d.lbl.Position = V(x + 38, y + 9)
			el.disp = lerp(el.disp, clamp(el.progress, 0, 1), math.min(dt * 6, 1))
			d.pct.Text = tostring(math.floor(el.disp * 100 + 0.5)) .. "%"
			d.pct.Position = V(x + w - 14 - textW(d.pct, 11, true), y + 10); d.pct.Color = T.Accent; d.pct.Visible = v
			local tx, tw_, ty = x + 14, w - 28, y + 38
			local fw = tw_ * el.disp
			d.track.Position = V(tx, ty); d.track.Size = V(tw_, 5); d.track.Color = T.Border; d.track.Visible = v
			d.fill.Position = V(tx, ty); d.fill.Size = V(fw, 5); d.fill.Color = T.Accent; d.fill.Visible = v and fw > 1
			local sx = tx + ((now * 90) % (fw + 40)) - 30
			local l, r = math.max(sx, tx), math.min(sx + 30, tx + fw)
			d.shine.Position = V(l, ty); d.shine.Size = V(math.max(0, r - l), 5); d.shine.Color = mixC(T.Accent, T.AccentGlow, 0.7)
			d.shine.Visible = v and r - l > 1
			return h

		elseif el.type == "paragraph" then
			local h = el.height
			local v = vis(y, h, cy, ch)
			d.txt.Position = V(x + 4, y + 3); d.txt.Color = T.TextSub; d.txt.Visible = v
			return h

		elseif el.type == "divider" then
			local h = 14
			local v = vis(y, h, cy, ch)
			local yy = y + 7
			d.l1.From = V(x + 6, yy); d.l1.To = V(x + w / 2 - 9, yy); d.l1.Color = T.Border; d.l1.Visible = v
			d.l2.From = V(x + w / 2 + 9, yy); d.l2.To = V(x + w - 6, yy); d.l2.Color = T.Border; d.l2.Visible = v
			d.dot.Position = V(x + w / 2, yy); d.dot.Color = T.AccentDim; d.dot.Visible = v
			return h
		end
		return el.height or 8
	end

	local function renderMini(now, dt, mx, my, down, clicked)
		if miniAppear <= 0.01 then
			for _, d in ipairs(miniList) do d.Visible = false end
			return
		end
		local a = clamp(miniAppear, 0, 1)
		local pop = easeBack(a)
		local cx, cy = miniX, miniY + math.sin(now * 1.7) * 3
		local docked = minimized and visible
		local hov = docked and ((mx - cx) ^ 2 + (my - cy) ^ 2) <= 900
		miniHover = lerp(miniHover, hov and 1 or 0, math.min(dt * 10, 1))
		local s = pop * (1 + 0.07 * miniHover)
		local R = 28 * s
		if docked and miniAppear > 0.6 then
			if clicked and hov then
				miniDrag = true
				miniSX, miniSY = mx, my
				miniDX, miniDY = mx - miniX, my - miniY
			end
			if miniDrag then
				if down then
					local v2 = camera.ViewportSize
					miniX = clamp(mx - miniDX, 30, v2.X - 30)
					miniY = clamp(my - miniDY, 30, v2.Y - 30)
				else
					miniDrag = false
					if (mx - miniSX) ^ 2 + (my - miniSY) ^ 2 < 36 then minimized = false end
				end
			end
		end
		for k = 1, 2 do
			local ring = mSonar[k]
			local ph = (now * 0.55 + k * 0.5) % 1
			ring.Position = V(cx, cy)
			ring.Radius = R + 4 + ph * 18
			ring.Color = mixC(T.AccentGlow, T.AccentDim, ph)
			if HAS_T then
				ring.Transparency = (1 - ph) * 0.7 * a
				ring.Visible = true
			else
				ring.Visible = ph < 0.7
			end
		end
		mDisc.Position = V(cx, cy); mDisc.Radius = R; mDisc.Color = T.BgAlt; mDisc.Visible = true
		if not miniImgSet then
			local data = iconData or bobData or loadBob()
			if data then
				miniImgSet = pcall(function() mImage.Data = data end)
			end
		end
		if miniImgSet then
			mImage.Size = V(46 * s, 52 * s)
			mImage.Position = V(cx - 23 * s, cy - 26 * s)
			mImage.Visible = true
			mLetter.Visible = false
		else
			mImage.Visible = false
			mLetter.Position = V(cx, cy - 11 * s); mLetter.Color = T.Text; mLetter.Visible = true
		end
		mInner.Position = V(cx, cy); mInner.Radius = math.max(1, R - 3); mInner.Color = T.Border; mInner.Visible = true
		mRing.Position = V(cx, cy); mRing.Radius = R; mRing.Color = mixC(T.Accent, T.AccentGlow, miniHover); mRing.Visible = true
		local rot = -0.35
		local cr, sr = math.cos(rot), math.sin(rot)
		for k = 1, 2 do
			local dot = mDots[k]
			local ang = now * ((k == 1) and 1.5 or -1.1) + k * 2
			local ex, ey = math.cos(ang) * (R + 10), math.sin(ang) * (R * 0.36)
			local rx, ry = ex * cr - ey * sr, ex * sr + ey * cr
			dot.Position = V(cx + rx, cy + ry)
			dot.Radius = ((k == 1) and 2.4 or 1.7) * math.max(s, 0.1)
			dot.Color = (k == 1) and T.AccentGlow or T.TextSub
			dot.Visible = not (math.sin(ang) < 0 and (rx * rx + ry * ry) < R * R)
		end
		mHint.Position = V(cx, cy + R + 8); mHint.Color = T.TextSub; mHint.Visible = miniHover > 0.4
		if HAS_T then
			mDisc.Transparency = a; mImage.Transparency = a; mInner.Transparency = a; mRing.Transparency = a
			mLetter.Transparency = a; mDots[1].Transparency = a; mDots[2].Transparency = a
			mHint.Transparency = miniHover * a
		end
	end

	local function renderWindow(now, dt, mx, my, down, clicked)
		local e = easeOut(clamp(appear, 0, 1))
		local live = visible and not minimized and appear > 0.01
		if HAS_T and math.abs(e - lastAlpha) > 0.003 then
			for _, r in ipairs(registry) do r.d.Transparency = r.a * e end
			lastAlpha = e
		end
		if not resizing then
			W = lerp(W, tW, math.min(dt * 12, 1))
			H = lerp(H, tH, math.min(dt * 12, 1))
			if math.abs(W - tW) < 0.5 then W = tW end
			if math.abs(H - tH) < 0.5 then H = tH end
		end
		local X = math.floor(winX + 0.5)
		local Y = math.floor(winY + (1 - e) * 18 + 0.5)
		local w, h = math.floor(W + 0.5), math.floor(H + 0.5)

		local by = Y + TITLE_H / 2
		local bx = { X + w - 22, X + w - 42, X + w - 62 }
		local overBtns = inRect(mx, my, X + w - 72, Y + 8, 62, TITLE_H - 16)
		btnHover = lerp(btnHover, overBtns and 1 or 0, math.min(dt * 12, 1))
		local gripHot = inRect(mx, my, X + w - 18, Y + h - 18, 18, 18)

		if live and clicked then
			if gripHot then
				resizing = true
				resDX, resDY = mx - W, my - H
			elseif inRect(mx, my, X, Y, w, TITLE_H) then
				local hit = 0
				for i = 1, 3 do
					if (mx - bx[i]) ^ 2 + (my - by) ^ 2 <= 81 then hit = i end
				end
				if hit == 1 then
					visible = false
					Kirin:Notify({ Title = "Panel hidden", Content = "Press " .. getKeyName(togKey) .. " to bring it back.", Type = "info", Duration = 3 })
				elseif hit == 2 then
					minimized = true
				elseif hit == 3 then
					expanded = not expanded
					if expanded then
						tW, tH = math.min(MAX_W, 790), math.min(MAX_H, 570)
					else
						tW, tH = normalW, normalH
					end
				else
					dragging = true
					dragDX, dragDY = mx - winX, my - winY
				end
			end
		end
		if resizing then
			if down then
				W = clamp(mx - resDX, MIN_W, MAX_W)
				H = clamp(my - resDY, MIN_H, MAX_H)
				tW, tH = W, H
			else
				resizing = false
				normalW, normalH = tW, tH
				expanded = false
			end
		end
		if dragging then
			if down then
				local v2 = camera.ViewportSize
				winX = clamp(mx - dragDX, 80 - w, v2.X - 80)
				winY = clamp(my - dragDY, 0, v2.Y - 40)
			else
				dragging = false
			end
		end

		-- Fit visible bounds to the current viewport, including resolution changes.
        local vp = camera.ViewportSize
        W=math.min(W,math.max(320,vp.X-20))
        H=math.min(H,math.max(260,vp.Y-20))
        winX=clamp(winX,0,math.max(0,vp.X-W))
        winY=clamp(winY,0,math.max(0,vp.Y-H))
        -- Apply drag/resize coordinates in the same frame as the input.
		X, Y = math.floor(winX + 0.5), math.floor(winY + (1 - e) * 18 + 0.5)
		w, h = math.floor(W + 0.5), math.floor(H + 0.5)
		if HAS_T then
			shadows[1].Position = V(X - 6, Y - 2); shadows[1].Size = V(w + 12, h + 14)
			shadows[2].Position = V(X - 2, Y + 1); shadows[2].Size = V(w + 4, h + 5)
		else
			shadows[1].Position = V(X + 2, Y + 3); shadows[1].Size = V(w, h)
		end
		for _, s in ipairs(shadows) do s.Visible = true end
		winBg.Position = V(X, Y); winBg.Size = V(w, h); winBg.Color = T.Bg; winBg.Visible = true

		local areaX, areaY = X + SIDE_W, Y + TITLE_H
		local areaW, areaH = w - SIDE_W, h - TITLE_H - FOOT_H
		local scaleR = math.min(1, h / 470)
		local maxR = NEB_R[1] * scaleR
		for _, n in ipairs(nebula) do
			local c = NEB[n.c]
			local px = areaX + areaW * c.rx + math.sin(now * 0.08 + c.ph) * 14
			local py = areaY + areaH * c.ry + math.cos(now * 0.06 + c.ph) * 10
			px = clamp(px, areaX + 10, X + w - maxR - 4)
			py = clamp(py, Y + maxR + 4, Y + h - maxR - 4)
			local off = (4 - n.r) * 1.2
			n.d.Position = V(px + math.sin(now * 0.3 + n.r) * off, py + math.cos(now * 0.25 + n.r) * off)
			n.d.Radius = NEB_R[n.r] * scaleR
			n.d.Color = mixC(T.Bg, T[c.key], NEB_K[n.r])
			n.d.Visible = true
		end

		paintGarden(now, areaX + 4, areaY + 4, areaW - 8, areaH - 8, e)
		local pmx = clamp((mx - (X + w / 2)) / w, -1, 1)
		local pmy = clamp((my - (Y + h / 2)) / h, -1, 1)
		local sw, sh = math.max(areaW - 12, 1), math.max(areaH - 12, 1)
		for _, s in ipairs(stars) do
			s.u = (s.u + s.sp * s.depth * dt / sw) % 1
			local sx = areaX + 6 + ((s.u * sw - pmx * 10 * s.depth) % sw)
			local sy = areaY + 6 + ((s.v * sh - pmy * 7 * s.depth) % sh)
			local tw = (math.sin(now * s.tw + s.ph) + 1) * 0.5
			s.d.Position = V(sx, sy)
			s.d.Radius = 0.7 + s.depth * 0.8 + tw * 0.35
			s.d.Color = mixC(T.Bg, STAR_TINT[s.tint], (0.25 + 0.75 * tw) * (0.35 + 0.65 * s.depth))
			s.d.Visible = true
			setA(s.d, e)
			if s.g1 then
				local gl = 1 + tw * tw * 4
				local gc = mixC(T.Bg, STAR_TINT[s.tint], tw * 0.8)
				s.g1.From = V(sx - gl, sy); s.g1.To = V(sx + gl, sy); s.g1.Color = gc; s.g1.Visible = tw > 0.35
				s.g2.From = V(sx, sy - gl); s.g2.To = V(sx, sy + gl); s.g2.Color = gc; s.g2.Visible = tw > 0.35
				setA(s.g1, e); setA(s.g2, e)
			end
		end

		if not shoot.active and now > shoot.nextAt then
			shoot.active = true
			shoot.t0 = now
			shoot.u = 0.35 + math.random() * 0.6
			shoot.v = 0.05 + math.random() * 0.3
			shoot.speed = 300 + math.random() * 160
		end
		if shoot.active then
			local age = now - shoot.t0
			local dx, dy = -0.89, 0.45
			local hx = areaX + shoot.u * areaW + dx * shoot.speed * age
			local hy = areaY + shoot.v * areaH + dy * shoot.speed * age
			local fade = clamp(1 - age / 1.3, 0, 1)
			local any = false
			for k = 1, 7 do
				local seg = shoot.segs[k]
				local x1, y1 = hx - dx * (k - 1) * 10, hy - dy * (k - 1) * 10
				local x2, y2 = hx - dx * k * 10, hy - dy * k * 10
				local ok = inRect(x1, y1, areaX + 2, areaY + 2, areaW - 4, areaH - 4) and inRect(x2, y2, areaX + 2, areaY + 2, areaW - 4, areaH - 4)
				if ok then any = true end
				seg.From = V(x1, y1); seg.To = V(x2, y2)
				seg.Color = mixC(T.Bg, T.AccentGlow, (1 - (k - 1) / 7) * fade)
				seg.Visible = ok
				setA(seg, e)
			end
			if (not any and age > 0.2) or age > 1.5 then
				shoot.active = false
				shoot.nextAt = now + 3.5 + math.random() * 6
				for k = 1, 7 do shoot.segs[k].Visible = false end
			end
		end

		titleBg.Position = V(X, Y); titleBg.Size = V(w, TITLE_H); titleBg.Color = T.BgAlt; titleBg.Visible = true
		titleFill.Position = V(X, Y + TITLE_H - 12); titleFill.Size = V(w, 12); titleFill.Color = T.BgAlt; titleFill.Visible = true
		topGlass.From = V(X + 12, Y + 1); topGlass.To = V(X + w - 12, Y + 1); topGlass.Color = mixC(T.BgAlt, T.BorderLit, 0.55); topGlass.Visible = true
		local hx = X + 12 + (w - 24) * ((now * 0.32) % 1.6)
		local function edgeSeg(line, a, b, col)
			a = clamp(a, X + 12, X + w - 12)
			b = clamp(b, X + 12, X + w - 12)
			line.From = V(a, Y + 1); line.To = V(b, Y + 1); line.Color = col; line.Visible = b - a > 1
		end
		edgeSeg(beamTail, hx - 150, hx, T.AccentDim)
		edgeSeg(beam, hx - 50, hx, T.AccentGlow)
		for i, glow in ipairs(beamGlow) do
			edgeSeg(glow, hx - 62 + i * 4, hx, HAS_T and T.Accent or mixC(T.BgAlt, T.Accent, i * 0.08))
			setA(glow, e * (0.06 + i * 0.045))
		end
		beamSpark.Position = V(clamp(hx, X + 12, X + w - 12), Y + 1)
		beamSpark.Color = T.AccentGlow
		beamSpark.Visible = hx > X + 12 and hx < X + w - 12
		setA(beamSpark, e * 0.85)
		for i = 1, 10 do
			local l = titleGrad[i]
			l.From = V(X + (i - 1) * w / 10, Y + TITLE_H); l.To = V(X + i * w / 10, Y + TITLE_H)
			l.Color = mixC(T.AccentDim, T.Border, math.min(1, (i - 1) / 4))
			l.Visible = true
		end
		sidePanel.Position = V(X, Y + TITLE_H + 1); sidePanel.Size = V(SIDE_W, h - TITLE_H - FOOT_H - 1); sidePanel.Color = T.Panel; sidePanel.Visible = true
		sideLine.From = V(X + SIDE_W, Y + TITLE_H + 1); sideLine.To = V(X + SIDE_W, Y + h - FOOT_H); sideLine.Color = T.Border; sideLine.Visible = true

		local pcx, pcy = X + 23, Y + TITLE_H / 2
		local rot = -0.38 + math.sin(now * 0.5) * 0.06
		local cr, sr = math.cos(rot), math.sin(rot)
		for i = 1, 16 do
			local a0 = (i - 1) / 16 * math.pi * 2
			local a1 = i / 16 * math.pi * 2
			local ex0, ey0 = math.cos(a0) * 14, math.sin(a0) * 3.8
			local ex1, ey1 = math.cos(a1) * 14, math.sin(a1) * 3.8
			local l = ringSegs[i]
			l.From = V(pcx + ex0 * cr - ey0 * sr, pcy + ex0 * sr + ey0 * cr)
			l.To = V(pcx + ex1 * cr - ey1 * sr, pcy + ex1 * sr + ey1 * cr)
			l.Color = (i <= 8) and T.AccentGlow or T.AccentDim
			l.Visible = true
		end
		planet.Position = V(pcx, pcy); planet.Radius = 7; planet.Color = T.Accent; planet.Visible = true
		planetShade.Position = V(pcx + 3, pcy - 2.5); planetShade.Radius = 6; planetShade.Color = T.BgAlt; planetShade.Visible = true
		planetSpec.Position = V(pcx - 3, pcy + 2); planetSpec.Radius = 1.5; planetSpec.Color = T.AccentGlow; planetSpec.Visible = true
		local ma = now * 1.25
		local mex, mey = math.cos(ma) * 19, math.sin(ma) * 5.5
		local mxp, myp = pcx + mex * cr - mey * sr, pcy + mex * sr + mey * cr
		moon.Position = V(mxp, myp); moon.Radius = 1.8; moon.Color = T.TextSub
		moon.Visible = not (math.sin(ma) < 0 and ((mxp - pcx) ^ 2 + (myp - pcy) ^ 2) < 81)

		if now > glitchAt then
			glitchUntil = now + 0.08 + math.random() * 0.08
			glitchAt = now + 7 + math.random() * 9
		end
		local gl = now < glitchUntil
		local jx = gl and math.random(-1, 1) or 0
		ghostA.Position = V(X + 46, Y + 8); ghostA.Color = T.Error; ghostA.Visible = gl
		ghostB.Position = V(X + 42, Y + 9); ghostB.Color = T.Accent; ghostB.Visible = gl
		titleText.Position = V(X + 44 + jx, Y + 8); titleText.Color = T.Text; titleText.Visible = true
		subText.Text = author .. ((math.floor(now * 1.4) % 2 == 0) and " _" or "")
		subText.Position = V(X + 44, Y + 25); subText.Color = T.TextDim; subText.Visible = true

		for i = 1, 3 do
			local b = tBtns[i]
			local hot = (mx - bx[i]) ^ 2 + (my - by) ^ 2 <= 81
			local tone = i == 1 and T.Error or T.Accent
