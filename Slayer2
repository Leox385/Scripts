local function getActiveChests()
    local list = {}
    local chests = Workspace:FindFirstChild("Chests")
    if chests then
        for _, ch in ipairs(chests:GetChildren()) do
            local p = ch:FindFirstChildWhichIsA("BasePart", true)
            if p then
                table.insert(list, { Instance = ch, Part = p, Pos = p.Position, Name = ch.Name })
            end
        end
    end
    return list
end

