local function getChar()
    local char = lp.Character or lp.CharacterAdded:Wait()
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")
    return char, root, hum
end

local function safeTeleport(target)
    local _, root = getChar()
    if not root then return false end
    local cf = nil
    if typeof(target) == "CFrame" then
        cf = target
    elseif typeof(target) == "Vector3" then
        cf = CFrame.new(target.X, target.Y, target.Z)
    end
    if cf then
        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        root.Velocity = Vector3.new(0, 0, 0)
        root.CFrame = cf
        return true
    end
    return false
end

local function getMyPlot()
    local props = workspace:FindFirstChild("Properties")
    if not props then return nil end
    for _, p in ipairs(props:GetChildren()) do
        local o = p:FindFirstChild("Owner")
        if o and o.Value then
            local str = tostring(o.Value)
            if str:find(lp.Name) or (pcall(function() return o.Value.UserId == lp.UserId end) and o.Value.UserId == lp.UserId) then
                return p
            end
        end
    end
    return nil
end

local function isRealBasePart(obj)
    if not obj or typeof(obj) ~= "Instance" then return false end
    local cn = obj.ClassName
    return cn == "Part" or cn == "MeshPart" or cn == "UnionOperation" or cn == "WedgePart" or cn == "CornerWedgePart" or cn == "TrussPart"
end

local function getItemMainPart(item)
    if not item or not item.Parent then return nil end
    local main = item:FindFirstChild("Main")
    if main and isRealBasePart(main) and typeof(main.Position) == "Vector3" then
        return main
    end
    for _, ch in ipairs(item:GetChildren()) do
        if isRealBasePart(ch) and typeof(ch.Position) == "Vector3" then
            return ch
        end
    end
    for _, ch in ipairs(item:GetDescendants()) do
        if isRealBasePart(ch) and typeof(ch.Position) == "Vector3" then
            return ch
        end
    end
    return nil
end

local function isPlayerOwnedItem(item)
    if not item then return false end
    local o = item:FindFirstChild("Owner")
    if not o or not o.Value then return false end
    local str = tostring(o.Value)
    if str:find("Unreadable") then return false end
    if str:find(lp.Name) or (pcall(function() return o.Value.UserId == lp.UserId end) and o.Value.UserId == lp.UserId) then
        return true
    end
    return false
end

local function teleportToMyPlot()
    local plot = getMyPlot()
    if not plot then return false end
    local origin = plot:FindFirstChild("OriginSquare")
    local mainPart = getItemMainPart(plot)
    local pos = (origin and origin.Position) or (mainPart and mainPart.Position)
    if pos then
        return safeTeleport(pos + Vector3.new(0, 5, 0))
    end
    return false
end

local function isAxeTool(t)
    if not t or t.ClassName ~= "Tool" then return false end
    if t:FindFirstChild("CuttingTool") or t:FindFirstChild("ToolName") then return true end
    local name = t.Name:lower()
    if name:find("axe") or name:find("hatchet") then return true end
    local tip = ""
    pcall(function() tip = t.ToolTip:lower() end)
    if tip:find("axe") or tip:find("hatchet") then return true end
    return false
end

local function getToolAxeInfo(axe, treeClassName)
    if not axe then return "BasicHatchet", {damage = 0.20, cooldown = 0.65, swingCooldown = 0.65, wireCooldown = 0.32, range = 10} end
    local tnObj = axe:FindFirstChild("ToolName")
    local tip = ""
    pcall(function() tip = axe.ToolTip end)
    
    local nameCandidates = {
        tnObj and tnObj.Value ~= "" and tnObj.Value or nil,
        tip ~= "" and tip or nil,
        (axe.Name ~= "Tool" and axe.Name ~= "") and axe.Name or nil
    }
    
    local matchedKey = nil
    local matchedData = nil
    for _, cand in ipairs(nameCandidates) do
        if cand then
            if axeStats[cand] then
                matchedKey = cand
                matchedData = axeStats[cand]
                break
            end
            for name, data in pairs(axeStats) do
                if cand:lower():find(name:lower(), 1, true) or name:lower():find(cand:lower(), 1, true) then
                    matchedKey = name
                    matchedData = data
                    break
                end
            end
            if matchedData then break end
        end
    end
    
    if not matchedData then
        matchedKey = "BasicHatchet"
        matchedData = {damage = 0.20, cooldown = 0.65, range = 10}
    end
    
    local effectiveDmg = matchedData.damage
    local effectiveCd = matchedData.cooldown
    if treeClassName and matchedData.special and matchedData.special[treeClassName] then
        effectiveDmg = matchedData.special[treeClassName].damage or effectiveDmg
        effectiveCd = matchedData.special[treeClassName].cooldown or effectiveCd
    end
    
    local wireCd = math.max(0.05, 0.65 * effectiveCd - 0.1)
    return matchedKey, {
        damage = effectiveDmg,
        cooldown = effectiveCd,
        swingCooldown = effectiveCd,
        wireCooldown = wireCd,
        range = matchedData.range or 10
    }
end

local function ensureAxeEquipped()
    local char, root, hum = getChar()
    if not char then return nil end

    for _, t in ipairs(char:GetChildren()) do
        if isAxeTool(t) then
            return t
        end
    end

    local bp = lp:FindFirstChild("Backpack")
    if bp then
        for _, t in ipairs(bp:GetChildren()) do
            if isAxeTool(t) then
                t.Parent = char
                task.wait(0.25)
                return t
            end
        end
    end

    local pm = workspace:FindFirstChild("PlayerModels")
    if pm and root then
        for _, item in ipairs(pm:GetChildren()) do
            local o = item:FindFirstChild("Owner")
            local tn = item:FindFirstChild("ToolName")
            local iname = item:FindFirstChild("ItemName")
            local rawName = (iname and iname.Value ~= "" and iname.Value) or (tn and tn.Value ~= "" and tn.Value) or item.Name
            local isAxe = rawName:lower():find("axe") or rawName:lower():find("hatchet")
            if isAxe and o and tostring(o.Value):find(lp.Name) then
                local main = item:FindFirstChild("Main") or item:FindFirstChildWhichIsA("BasePart")
                if main and (main.Position - root.Position).Magnitude < 60 then
                    ClientInteracted:FireServer(item, "Pick up tool")
                    task.wait(0.3)
                    for _, t in ipairs(char:GetChildren()) do
                        if isAxeTool(t) then return t end
                    end
                    if bp then
                        for _, t in ipairs(bp:GetChildren()) do
                            if isAxeTool(t) then
                                t.Parent = char
                                task.wait(0.25)
                                return t
                            end
                        end
                    end
                end
            end
        end
    end

    return nil
end

local function findLowestSection(tree)
    if not tree or not tree.Parent then return nil end

    for _, p in ipairs(tree:GetChildren()) do
        if p.Name == "WoodSection" and p:FindFirstChild("ID") and p.ID.Value == 1 then
            return p
        end
    end

    local lowestSection, lowestY = nil, math.huge
    for _, p in ipairs(tree:GetChildren()) do
        if p.Name == "WoodSection" and p:FindFirstChild("ID") then
            if p.Position.Y < lowestY then
                lowestY = p.Position.Y
                lowestSection = p
            end
        end
    end
    return lowestSection
end

local function isSpecialTree(p, r, g, b, val)
    if val ~= "" and val ~= "oak" and val ~= "generic" then return true end
    if (p.Y > 300 and p.Z > 2500) or (r > 210 and g > 210 and b > 210) then return true end -- Frost
    if (p.Y >= -30 and p.Y <= 30 and p.X >= -1350 and p.X <= -950 and p.Z >= -1250 and p.Z <= -700) or (r > 210 and g > 150 and b < 100) then return true end -- SnowGlow
    if (p.Y > 500 and p.X < -1300) or (r > 170 and g < 70 and b < 60) then return true end -- Volcano
    if (p.Y < -40) or (b > 70 and r < 40 and g < 50) then return true end -- CaveCrawler
    if (p.Z > 600 and p.Z < 1600 and p.X > 0 and p.X < 700 and r > 90 and r < 130 and g < 80) then return true end -- Cherry
    if (p.Y >= 115 and p.Y <= 170 and p.X >= -1500 and p.X <= -750 and p.Z >= -1550 and p.Z <= -450) then return true end -- Swamp (Gold/Green)
    if (p.Y < 25 and (p.X > 1700 or p.Z < -1300) and r > 185 and g > 175) then return true end -- Palm
    if (p.X > 4200 and p.Z > -1000 and p.Z < 600 and r > 160 and r < 190) then return true end -- Koa
    if (p.Z < -1000 and p.X > -600 and p.X < 900 and r > 140 and r < 180 and g > 80 and g < 115) then return true end -- Walnut
    if (r > 240 and g > 240 and b > 180) then return true end -- Birch
    return false
end

local function matchesTreeClass(tree, targetType)
    if not tree or not tree.Parent then return false end
    if targetType == "All (Nearest)" or targetType == "All" then return true end

    local tc = tree:FindFirstChild("TreeClass")
    local val = (tc and tc.Value or ""):lower()
    local target = (targetType or ""):lower()

    if val ~= "" then
        if target == "frost" then
            return val:find("frost") ~= nil or val:find("ice") ~= nil
        elseif target == "snowglow" then
            return val:find("snowglow") ~= nil or (val:find("glow") ~= nil and not val:find("frost"))
        elseif target == "volcano" then
            return val:find("volcano") ~= nil or val:find("lava") ~= nil
        elseif target == "goldswampy" then
            return val:find("gold") ~= nil
        elseif target == "greenswampy" then
            return val:find("greenswamp") ~= nil or (val:find("swamp") ~= nil and not val:find("gold"))
        elseif target == "cavecrawler" then
            return val:find("cave") ~= nil or val:find("crawler") ~= nil
        elseif target == "spooky" then
            return val:find("spook") ~= nil
        elseif target == "sinister" then
            return val:find("sinister") ~= nil
        elseif target == "phantom" then
            return val:find("phantom") ~= nil or val:find("endtimes") ~= nil
        elseif target == "zombie" then
            return val:find("zombie") ~= nil
        elseif target == "bluespruce" then
            return val:find("spruce") ~= nil or val:find("bspruce") ~= nil
        elseif target == "elm" then
            return val:find("elm") ~= nil
        elseif target == "birch" then
            return val:find("birch") ~= nil
        elseif target == "cherry" then
            return val:find("cherry") ~= nil
        elseif target == "koa" then
            return val:find("koa") ~= nil
        elseif target == "palm" then
            return val:find("palm") ~= nil
        elseif target == "walnut" then
            return val:find("walnut") ~= nil
        elseif target == "fir" then
            return val:find("fir") ~= nil
        elseif target == "pine" then
            return val:find("pine") ~= nil
        elseif target == "oak" then
            return val == "oak" or val == "generic"
        elseif target == "generic" then
            return val == "generic" or val == "oak"
        else
            return val == target or val:find(target, 1, true) ~= nil
        end
    end

    local ws = tree:FindFirstChild("WoodSection")
    if not ws or not ws:IsA("BasePart") then return false end

    local p = ws.Position
    local r, g, b = ws.Color.R, ws.Color.G, ws.Color.B

    if target == "frost" then
        return (p.Y > 300 and p.Z > 2500) and (r > 210 and g > 210 and b > 210)
    elseif target == "snowglow" then
        return (p.Y >= -30 and p.Y <= 30 and p.X >= -1350 and p.X <= -950 and p.Z >= -1250 and p.Z <= -700) or (r > 210 and g > 150 and b < 100)
    elseif target == "volcano" then
        return (p.Y > 500 and p.X < -1300) or (r > 170 and g < 70 and b < 60)
    elseif target == "cavecrawler" then
        return (p.Y < -40) or (b > 70 and r < 40 and g < 50)
    elseif target == "cherry" then
        return (p.Z > 600 and p.Z < 1600 and p.X > 0 and p.X < 700 and r > 90 and r < 130 and g < 80)
    elseif target == "goldswampy" then
        return (p.Y >= 115 and p.Y <= 170 and p.X >= -1500 and p.X <= -750 and p.Z >= -1550 and p.Z <= -450 and r > 95 and r < 125 and g > 75 and g < 100)
    elseif target == "greenswampy" then
        return (p.Y >= 115 and p.Y <= 170 and p.X >= -1500 and p.X <= -750 and p.Z >= -1550 and p.Z <= -450 and g > 55 and r < 50)
    elseif target == "palm" then
        return (p.Y < 25 and (p.X > 1700 or p.Z < -1300) and r > 185 and g > 175)
    elseif target == "koa" then
        return (p.X > 4200 and p.Z > -1000 and p.Z < 600 and r > 160 and r < 190)
    elseif target == "walnut" then
        return (p.Z < -1000 and p.X > -600 and p.X < 900 and r > 140 and r < 180 and g > 80 and g < 115)
    elseif target == "birch" then
        return (r > 240 and g > 240 and b > 180)
    elseif target == "fir" then
        return (p.Z > 1000 and p.Z < 2600 and p.X > 200 and p.X < 1600)
    elseif target == "pine" then
        return (p.Z > 1000 and p.Z < 2600 and p.X > 300 and p.X < 1600)
    elseif target == "oak" or target == "generic" then
        return not isSpecialTree(p, r, g, b, val)
    end

    return false
end

local function isUncutTree(tree)
    if not tree or not tree.Parent or not tree:IsDescendantOf(workspace) then return false end
    if not tree:FindFirstChild("CutEvent") then return false end
    if tree:FindFirstChild("RootCut") then return false end
    for _, ch in ipairs(tree:GetChildren()) do
        if ch.Name == "WoodSection" then
            return true
        end
    end
    return false
end

local function findTreeLowest(targetType, maxDist)
    local _, root = getChar()
    if not root then return nil, nil, math.huge end
    maxDist = maxDist or math.huge

    local bestTree, bestSection = nil, nil
    local shortestDist = maxDist

    for _, region in ipairs(workspace:GetChildren()) do
        if region.Name == "TreeRegion" then
            for _, tree in ipairs(region:GetChildren()) do
                if tree:FindFirstChild("CutEvent") and isUncutTree(tree) and matchesTreeClass(tree, targetType) then
                    local lowestSection = findLowestSection(tree)
                    if lowestSection then
                        local d = (lowestSection.Position - root.Position).Magnitude
                        if d < shortestDist then
                            shortestDist = d
                            bestTree = tree
                            bestSection = lowestSection
                        end
                    end
                end
            end
        end
    end
    return bestTree, bestSection, shortestDist
end

local function strikeSectionLegit(tree, section, axe, treeClassName, hitIndex)
    if not tree or not section or not axe then return false, 0.5 end
    local cutEvent = tree:FindFirstChild("CutEvent")
    local sectionId = section:FindFirstChild("ID")
    if not cutEvent or not sectionId then return false, 0.5 end
    if tree:FindFirstChild("RootCut") then return false, 0.5 end

    local char = lp.Character
    if not char then return false, 0.5 end

    if axe.Parent ~= char then
        axe.Parent = char
        task.wait(0.25)
    end
    if axe.Parent ~= char then return false, 0.5 end

    local _, stats = getToolAxeInfo(axe, treeClassName)

    local height = 0.5
    if section.ClassName == "Part" or section.ClassName == "MeshPart" then
        local sy = section.Size and section.Size.Y or 2
        height = math.clamp(sy * 0.35, 0.2, math.max(0.4, sy - 0.2))
    end

    local idx = hitIndex or 1
    local face = (idx % 2 == 1) and Vector3.new(0, 0, -1) or Vector3.new(0, 0, 1)

    RemoteProxy:FireServer(cutEvent, {
        ["sectionId"] = sectionId.Value,
        ["faceVector"] = face,
        ["height"] = height,
        ["hitPoints"] = stats.damage,
        ["cooldown"] = stats.wireCooldown,
        ["cuttingClass"] = "Axe",
        ["tool"] = axe
    })
    return true, stats.swingCooldown + 0.05
end

local function smartBringLog(log, savedPos)
    local main = log:FindFirstChild("WoodSection") or log:FindFirstChild("Main")
    if not main then
        for _, p in ipairs(log:GetChildren()) do
            if isRealBasePart(p) then
                main = p
                break
            end
        end
    end
    if not main then return false end

    local _, root = getChar()
    if not root then return false end

    local targetLanding = savedPos.Position + Vector3.new(math.random(-3, 3), 2.5, math.random(-3, 3))

    for attempt = 1, 3 do
        local curDist = (main.Position - savedPos.Position).Magnitude
        if curDist <= 12 then
            return true
        end

        -- 1. Teleport player on top of the log to enter interaction range
        safeTeleport(CFrame.new(main.Position.X, main.Position.Y + 3.5, main.Position.Z))
        task.wait(0.12)

        -- 2. Claim drag on the log twice to solidly claim network ownership
        ClientIsDragging:FireServer(log)
        task.wait(0.06)
        ClientIsDragging:FireServer(log)
        task.wait(0.06)

        -- 3. Teleport player back to destination
        safeTeleport(savedPos)
        task.wait(0.06)

        -- 4. Move all parts of the log to landing spot
        local delta = targetLanding - main.Position
        for _, p in ipairs(log:GetChildren()) do
            if isRealBasePart(p) then
                p.CFrame = p.CFrame + delta
                p.Velocity = Vector3.new(0, 0, 0)
                p.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            end
        end

        -- 5. Confirm drag at landing spot while player is standing right next to it
        ClientIsDragging:FireServer(log)
        task.wait(0.08)
        ClientIsDragging:FireServer(log)
        task.wait(0.1)

        -- 6. Verify if it arrived successfully
        if (main.Position - savedPos.Position).Magnitude <= 18 then
            return true
        end
    end

    safeTeleport(savedPos)
    return (main.Position - savedPos.Position).Magnitude <= 18
end

local function executeWoodMagnet()
    local _, root = getChar()
    if not root then return end

    local lm = workspace:FindFirstChild("LogModels")
    if not lm then return end

    local logs = lm:GetChildren()
    local savedPos = root.CFrame
    local broughtCount = 0

    Non:Notify({Title = "Bring log", Content = "Bringing logs to your position (100% Guaranteed)...", Icon = "magnet", Duration = 2})

    task.spawn(function()
        for _, log in ipairs(logs) do
            local o = log:FindFirstChild("Owner")
            local ownerStr = o and tostring(o.Value) or ""
            local isEligible = false

            if bringFilterMode == "All Players Logs" then
                isEligible = true
            elseif bringFilterMode == "My Logs Only" then
                if isPlayerOwnedItem(log) then
                    isEligible = true
                end
            else
                if isPlayerOwnedItem(log) or not o or not o.Value or ownerStr:find("Unreadable") or ownerStr == "nil" or ownerStr == "" then
                    isEligible = true
                end
            end

            if isEligible then
                local success = smartBringLog(log, savedPos)
                if success then
                    broughtCount = broughtCount + 1
                    task.wait(0.08)
                end
            end
        end

        safeTeleport(savedPos)
        Non:Notify({
            Title = "Bring Complete",
            Content = string.format("Successfully brought %d logs (100%% guaranteed).", broughtCount),
            Icon = "circle-check",
            Duration = 4
        })
    end)
end

