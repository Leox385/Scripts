task.spawn(function()
    local lastMachineId = nil

    while STATE.Running do
        task.wait(0.35)
        if STATE.AutoRebirth then
            pcall(function()
                local bestArea, areaPos, currentRebirths = getBestTrainArea()
                local trainFolder = remotes and remotes:FindFirstChild("Train")
                local rebirthFolder = remotes and remotes:FindFirstChild("Rebirth")

                local intoRE = trainFolder and trainFolder:FindFirstChild("IntoAutoTrainRE")
                local trainRE = trainFolder and trainFolder:FindFirstChild("TrainOnceRE")
                local rebirthRE = rebirthFolder and rebirthFolder:FindFirstChild("TryRebirthRE")

                if bestArea and bestArea.id ~= lastMachineId then
                    lastMachineId = bestArea.id
                    teleportTo(areaPos)
                    task.wait(0.2)
                    if intoRE then
                        intoRE:FireServer(bestArea.id)
                    end
                    lp:SetAttribute("AutoTrainAreaID", bestArea.id)
                    say("Auto-Train", "Training at: " .. bestArea.name, "zap")
                end

                if trainRE then
                    trainRE:FireServer()
                end

                if tick() - STATE.LastRebirthTick > 2.0 then
                    STATE.LastRebirthTick = tick()
                    if rebirthRE then
                        rebirthRE:FireServer()
                    end
                end
            end)
        else
            if lastMachineId ~= nil then
                lastMachineId = nil
                pcall(function()
                    local trainFolder = remotes and remotes:FindFirstChild("Train")
                    local exitRE = trainFolder and trainFolder:FindFirstChild("ExitAutoTrainRE")
                    if exitRE then
                        exitRE:FireServer()
                    end
                    lp:SetAttribute("AutoTrainAreaID", nil)
                end)
            end
        end
    end
end)

task.spawn(function()
    applyBarrierBypass()

    while STATE.Running do
        if STATE.GodMode then
            applyGodMode()
        end
        applyBarrierBypass()

        if STATE.AutoFarm then
            killStageEnemies()
        end

        task.wait(0.2)
    end
end)

_G.MatchaLootForgeHubCleanup = function()
    STATE.Running = false
    pcall(function()
        local trainFolder = remotes and remotes:FindFirstChild("Train")
        local exitRE = trainFolder and trainFolder:FindFirstChild("ExitAutoTrainRE")
        if exitRE then exitRE:FireServer() end
        lp:SetAttribute("AutoTrainAreaID", nil)
    end)
    if inputConn then pcall(function() inputConn:Disconnect() end) end
    if Non and Non.Unload then
        pcall(function() Non:Unload() end)
    elseif Window and Window.Destroy then
        pcall(function() Window:Destroy() end)
    end
end

