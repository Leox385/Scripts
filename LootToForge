    local function getOreMainPart(ore)
        if not ore then return nil end
        if ore:IsA("BasePart") then return ore end
        local pp = ore:IsA("Model") and ore.PrimaryPart or nil
        if pp and (pp.ClassName == "Part" or pp.ClassName == "MeshPart" or pp.ClassName == "UnionOperation") then
            return pp
        end
        for _, name in ipairs({"MAIN", "Main", "Part", "RootPart", "Handle"}) do
            local child = ore:FindFirstChild(name)
            if child and (child.ClassName == "Part" or child.ClassName == "MeshPart" or child.ClassName == "UnionOperation") then
                return child
            end
        end
        for _, child in ipairs(ore:GetChildren()) do
            if child.ClassName == "Part" or child.ClassName == "MeshPart" or child.ClassName == "UnionOperation" then
                return child
            end
        end
        for _, desc in ipairs(ore:GetDescendants()) do
            if desc.ClassName == "Part" or desc.ClassName == "MeshPart" or desc.ClassName == "UnionOperation" then
                return desc
            end
        end
        return nil
    end

    local function getOrePosition(ore)
        if not ore then return nil end
        local main = getOreMainPart(ore)
        if main then
            local pos = getPartPosition(main)
            if pos then return pos end
        end
        for _, desc in ipairs(ore:GetDescendants()) do
            local pos = getPartPosition(desc)
            if pos then return pos end
        end
        return nil
    end

    local function freezeOre(ore)
        if not ore then return end
        for _, p in ipairs(ore:GetDescendants()) do
            if p.ClassName == "Part" or p.ClassName == "MeshPart" or p.ClassName == "UnionOperation" then
                pcall(function()
                    p.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    p.Velocity = Vector3.new(0, 0, 0)
                end)
            end
        end
    end

    local function getBackpackInfo()
        local isFull = false
        local cur = nil
        local maxNum = nil

        pcall(function()
            local hud = lp:FindFirstChild("PlayerGui") and lp.PlayerGui:FindFirstChild("Hud")
            local leftInfos = hud and hud:FindFirstChild("LeftInfos")
            local orePack = leftInfos and leftInfos:FindFirstChild("OrePack")
            local title = orePack and orePack:FindFirstChild("Title")
            if title and title.Text then
                local cStr, mStr = tostring(title.Text):match("(%d+)%s*/%s*(%d+)")
                if cStr and mStr then
                    cur = tonumber(cStr)
                    maxNum = tonumber(mStr)
                end
            end
        end)

        if cur == nil or maxNum == nil then
            pcall(function()
                local pgui = lp:FindFirstChild("PlayerGui")
                if pgui then
                    local orePack = pgui:FindFirstChild("OrePack", true)
                    if orePack then
                        for _, desc in ipairs(orePack:GetDescendants()) do
                            if desc:IsA("TextLabel") and desc.Text then
                                local cStr, mStr = tostring(desc.Text):match("(%d+)%s*/%s*(%d+)")
                                if cStr and mStr then
                                    cur = tonumber(cStr)
                                    maxNum = tonumber(mStr)
                                    break
                                end
                            end
                        end
                    end
                end
            end)
        end

        if cur and maxNum and maxNum > 0 then
            isFull = (cur >= maxNum)
        end

        return isFull, cur or 0, maxNum or 0
    end

