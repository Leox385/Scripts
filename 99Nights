    Callback = function()
        if not itemsFolder then return end
        local logs = {}
        for _, item in ipairs(itemsFolder:GetChildren()) do
            if item.Name == "Log" then
                table.insert(logs, item)
            end
        end
        SafeBatchTeleport(logs, woodDestination, "logs")
    end
})

WoodTab:Section("Fuel Management")
WoodTab:Button({
    Title = "Send All Fuel to Campfire",
    Desc = "Moves oil barrels, canisters, coal, and wood straight into the fire",
    Icon = "flame",
    Callback = function()
        if not itemsFolder then return end
        task.spawn(function()
            local count = 0
            for _, item in ipairs(itemsFolder:GetChildren()) do
                if IsFuelItem(item) then
                    count = count + 1
                    MoveAllItemParts(item, CAMPFIRE_POS + Vector3.new(0, 1.5, 0))
                    task.wait(0.08)
                end
            end
            Notify("Fuel", "Sent " .. count .. " fuels to the campfire.", "flame")
        end)
    end
})

WoodTab:Toggle({
    Title = "Auto-Feed Campfire Loop",
    Desc = "Automatically burns any new fuel dropped on the ground",
    Default = false,
    Callback = function(on)
        autoFeedCampfire = on
        if on then
            task.spawn(function()
                while autoFeedCampfire do
                    if itemsFolder then
                        for _, item in ipairs(itemsFolder:GetChildren()) do
                            if not autoFeedCampfire then break end
                            if IsFuelItem(item) then
                                MoveAllItemParts(item, CAMPFIRE_POS + Vector3.new(0, 1.5, 0))
                                task.wait(0.12)
                            end
                        end
                    end
                    task.wait(2)
                end
            end)
            Notify("Campfire", "Auto-feed enabled.", "flame")
        end
    end
})

