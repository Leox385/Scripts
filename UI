-- Runtime adapter for Drawing-based Matcha LuaVM interfaces.
local typeOf = typeof or type
local function safeGet(object, key)
    if object == nil then return nil end
    local ok, value = pcall(function() return object[key] end)
    return ok and value or nil
end
local function service(name)
    local ok, value = pcall(function() return game:GetService(name) end)
    return ok and value or nil
end
local function startupFailure(message)
    local out=warn or print
    if type(out)=="function" then pcall(out,"[Astra] "..message) end
end
if not Drawing or type(safeGet(Drawing,"new"))~="function" or not Vector2 or not Color3 then
    startupFailure("Entorno incompatible: Drawing.new, Vector2 y Color3 son necesarios")
    return nil
end
local taskHost = task or {}
local spawnHost = taskHost.spawn or spawn
local waitHost = taskHost.wait or wait
if type(spawnHost)~="function" or type(waitHost)~="function" then
    startupFailure("Entorno incompatible: falta spawn/wait")
    return nil
end
local clock = (os and os.clock) or tick
if type(clock)~="function" then startupFailure("Falta un reloj compatible"); return nil end
local unpackf = table.unpack or unpack
local runtimeAlive = true
local function background(fn)
    spawnHost(function()
        waitHost() -- Matcha spawn begins immediately; yield before optional work.
        if runtimeAlive then fn() end
    end)
end
local function report(message)
    local out = warn or print
    if type(out) == "function" then pcall(out, "[Astra] " .. tostring(message)) end
end
