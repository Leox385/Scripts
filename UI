				el.multi = c.Multi == true
				if el.multi then
					el.selected = {}
					if type(c.Default) == "table" then
						for k, v in pairs(c.Default) do
							if type(k) == "number" then el.selected[v] = true elseif v then el.selected[k] = true end
						end
					end
				else
					el.selected = el.options[1]
                    for _, option in ipairs(el.options) do if option == c.Default then el.selected = option end end
				end
				if el.multi then
                    local filtered = {}
                    for _, option in ipairs(el.options) do if el.selected[option] then filtered[option] = true end end
                    el.selected = filtered
                end
                el.open, el.o = false, 0
                el.flag, el.callback = c.Flag, c.Callback
