local function unlockAllLocations()
    if State.UnlockingLocations then
        UI:Notify({ Title = "Unlock Locations", Content = "Already in progress...", Type = "warn", Duration = 2 })
        return
    end
    State.UnlockingLocations = true
    task.spawn(function()
        UI:Notify({ Title = "Unlock Locations", Content = "Starting automatic crystal discovery...", Type = "info", Duration = 3 })
        local total = #CrystalWaypoints
        for idx, cw in ipairs(CrystalWaypoints) do
            if not State.Running or not State.UnlockingLocations then break end
            UI:Notify({
                Title = "Unlocking (" .. idx .. "/" .. total .. ")",
                Content = cw.Region .. " (" .. cw.Name .. ")",
                Type = "info",
                Duration = 2
            })
            smartTeleportToEntity(cw.Name, cw.Pos)
            task.wait(1.5)
            
            local char = lp.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then
                local deb = Workspace:FindFirstChild("Debree")
                local prompt = nil
                if deb and deb:FindFirstChild("Regions") then
                    for _, r in ipairs(deb.Regions:GetChildren()) do
                        local sc = r:FindFirstChild("SpawnCrystal")
                        if sc then
                            local p = sc:FindFirstChildWhichIsA("ProximityPrompt", true)
                            if p then
                                local rootP = sc:FindFirstChild("Root") or sc:FindFirstChildWhichIsA("BasePart")
                                if rootP and (rootP.Position - hrp.Position).Magnitude < 25 then
                                    prompt = p
                                    break
                                end
                            end
                        end
                    end
                end
                
                if prompt and fireproximityprompt then
                    pcall(function() fireproximityprompt(prompt) end)
                    task.wait(0.5)
                else
                    pcall(function()
                        if setrobloxinput then setrobloxinput(true) end
                        keypress(84)
                        keypress(116)
                    end)
                    task.wait(1.2)
                    pcall(function()
                        keyrelease(84)
                        keyrelease(116)
                    end)
                end
            end
            task.wait(1.0)
        end
        State.UnlockingLocations = false
        UI:Notify({ Title = "Unlock Locations", Content = "All waypoints processed!", Type = "success", Duration = 4 })
    end)
end

