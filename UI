local function fetchImage(src)
	if not src or src == "" then return nil end
	local raw
	if typeOf(readfile) == "function" then
		local ok, d = pcall(readfile, src)
		if ok and type(d) == "string" and #d > 200 then raw = d end
	end
	if not raw and string.sub(src, 1, 4) == "http" then
		if typeOf(httpget) == "function" then pcall(function() raw = httpget(src) end) end
		if not raw then pcall(function() raw = game:HttpGet(src) end) end
	end
	if type(raw) == "string" and #raw > 200 then return raw end
	return nil
end

