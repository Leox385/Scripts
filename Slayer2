                                    local headPos = tPos + Vector3.new(0, State.MobHeightOffset or 3.8, 0)
                                    hrp.CFrame = CFrame.lookAt(headPos, tPos)
                                elseif State.MobDefenseMode == "Sky God-Hover (Directly Above)" then
                                    local skyPos = tPos + Vector3.new(0, 10.0, 0)
                                    hrp.CFrame = CFrame.lookAt(skyPos, tPos)
                                else
                                    local behindPos = (tRoot.CFrame * CFrame.new(0, 0.8, State.MobBehindDistance or 2.4)).Position
                                    hrp.CFrame = CFrame.lookAt(behindPos, tPos)
                                end
                                hrp.AssemblyLinearVelocity = Vector3.zero
                                
                                pcall(function()
                                    char:SetAttribute("last_cmbat", 0)
                                end)
                                
                                local hitCount = State.FastAttack and (State.FastAttackBurst or 3) or 1
                                for _ = 1, hitCount do
                                    if RemoteEvent then
                                        RemoteEvent:FireServer("Combat_Service", style, combo, false, 0, false, nil)
                                    end
                                    combo = combo % 5 + 1
                                end
                                if mouse1click then mouse1click() end
                                
                                if State.MobAttackDelay and State.MobAttackDelay > 0 then
                                    task.wait(State.MobAttackDelay)
                                else
                                    task.wait()
                                end
                            end
                            if State.AutoParry and keyrelease then
                                pcall(function()
                                    keyrelease(102)
                                    keyrelease(70)
                                end)
                            end
                        else
                            local spawnPos = RegionSpawns[targetMob]
                            if spawnPos then
                                smartTeleportToEntity(targetMob, spawnPos)
                                task.wait(1.0)
                            else
                                task.wait(0.3)
                            end
                        end
                    else
                        task.wait(0.5)
                    end
                end
            end
        else
            task.wait(0.2)
        end
    end
end)

