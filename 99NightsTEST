                    local initialHoverPos = curAnimalPos + Vector3.new(0, huntHoverHeight, 0)
                    curRoot.AssemblyLinearVelocity = Vector3.zero
                    curRoot.Velocity = Vector3.zero
                    curRoot.CFrame = CFrame.lookAt(initialHoverPos, curAnimalPos)

                    local isHoveringTarget = true
                    task.spawn(function()
                        while autoHuntEnabled and mySession == huntSession and isHoveringTarget and bestAnimal.Parent and aRoot.Parent do
                            local c = lp.Character
                            local r = c and c:FindFirstChild("HumanoidRootPart")
                            if r and aRoot.Parent then
                                local tPos = aRoot.Position
                                local safeHoverPos = tPos + Vector3.new(0, huntHoverHeight, 0)
                                r.AssemblyLinearVelocity = Vector3.zero
                                r.Velocity = Vector3.zero
                                r.CFrame = CFrame.lookAt(safeHoverPos, tPos)
                            end
                            task.wait()
                        end
                    end)

                    local huntTimeout = 0
                    while autoHuntEnabled and mySession == huntSession and bestAnimal.Parent and aHum.Health > 0 and not bestAnimal:GetAttribute("Dead") and not bestAnimal:GetAttribute("LocalDestroyed") and aRoot.Parent and huntTimeout < 45 do
                        huntTimeout = huntTimeout + 1

                        EnsureToolEquipped(weapon)
                        DisarmAndExpandAnimal(bestAnimal, huntHitboxSize)

                        if mouse1click then
                            mouse1click()
                        end

                        if damageRemote then
                            task.spawn(function()
                                local hitId = tostring(math.random(1000, 99999)) .. "_" .. math.abs(lp.UserId)
                                pcall(function()
                                    damageRemote:InvokeServer(bestAnimal, weapon, hitId, curRoot.CFrame, false)
                                end)
                            end)
                        end

                        task.wait(0.24)
                    end

                    isHoveringTarget = false

                    if curRoot and curRoot.Parent then
                        curRoot.AssemblyLinearVelocity = Vector3.zero
                        curRoot.Velocity = Vector3.zero
                    end

                    task.wait(0.1)
                end
            end)
        else
            if root then
                root.AssemblyLinearVelocity = Vector3.zero
                root.Velocity = Vector3.zero
            end
            Notify("Auto-Hunt", "Auto-hunt disabled.", "circlecheck")
        end
    end
})

