    local function redeemAllRewards()
        if rewardsBusy then return end
        rewardsBusy = true
        task.spawn(function()
            local ok, err = pcall(function()
                local r = ReplicatedStorage:FindFirstChild("Remote")
                if not r then report("Remote no disponible"); return end
                local codeFolder = r:FindFirstChild("Code")
                local codeRF = codeFolder and codeFolder:FindFirstChild("TryUseCodeRF")
                if codeRF then
                    for _,code in ipairs(PROMO_CODES) do
                        if not invokeBounded(codeRF, code) then break end
                        task.wait(0.3)
                    end
                end
                local paths = {{"Dungeon","TryClaimDailyDunTicRE"}, {"Offline","TryClaimOfflineRewardRE"},
                    {"UpdateLog","TryClaimUPDRewardRE"}}
                for _,path in ipairs(paths) do
                    check()
                    local folder = r:FindFirstChild(path[1])
                    local event = folder and folder:FindFirstChild(path[2])
                    if event then pcall(function() event:FireServer() end) end
                    task.wait(0.3)
                end
                local online = r:FindFirstChild("Online")
                local claim = online and online:FindFirstChild("TryClaimRE")
                if claim then
                    for i=1,12 do check(); pcall(function() claim:FireServer(i) end); task.wait(0.3) end
                end
            end)
            rewardsBusy = false
            if not ok then report(err) end
        end)
    end

