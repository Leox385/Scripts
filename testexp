local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local lp = Players.LocalPlayer
local mouse = lp:GetMouse()

-- Global Script State
_G.State = _G.State or {
    FullAutoFarm = true,
    SelectedQuest = "NikoDelivery",
    AutoQuestTasks = false,
}
local State = _G.State

-- NPC Registry & Default Coordinates
local QuestRegistry = {
    ["NikoDelivery"] = {
        NpcName = "Niko",
        NpcPos = Vector3.new(407.3, 875.0, 978.9),             -- Niko's location (Mistfall Harbor)
        TargetNpcName = "Shiori",
        TargetNpcPos = Vector3.new(-1814.34, 311.80, -101.07), -- Shiori's location (Butterfly Estate)
    }
}

-- Session Statistics
local Stats = {
    Completed = 0,
    ExpEarned = 0,
    MoneyEarned = 0,
}

-- =========================================================================
-- 1. CLEANUP PREVIOUS UI INSTANCES UPON RE-EXECUTION
-- =========================================================================
if _G.NikoFarmUI then
    pcall(function()
        for _, elem in pairs(_G.NikoFarmUI) do
            if elem and elem.Remove then elem:Remove() end
        end
    end)
    if _G.NikoFarmInputConn then
        pcall(function() _G.NikoFarmInputConn:Disconnect() end)
    end
    _G.NikoFarmActive = false
    task.wait(0.1)
end
_G.NikoFarmActive = true

-- =========================================================================
-- 2. INTERACTIVE FLOATING BUTTON (DRAWING API)
-- =========================================================================
local btnX, btnY = 30, 220
local btnW, btnH = 210, 60

local bg = Drawing.new("Square")
bg.Position = Vector2.new(btnX, btnY)
bg.Size = Vector2.new(btnW, btnH)
bg.Filled = true
bg.Color = State.FullAutoFarm and Color3.fromRGB(40, 160, 60) or Color3.fromRGB(180, 40, 40)
bg.Visible = true

local border = Drawing.new("Square")
border.Position = Vector2.new(btnX, btnY)
border.Size = Vector2.new(btnW, btnH)
border.Filled = false
border.Thickness = 2
border.Color = Color3.fromRGB(255, 255, 255)
border.Visible = true

local label = Drawing.new("Text")
label.Position = Vector2.new(btnX + btnW / 2, btnY + 8)
label.Size = 15
label.Center = true
label.Outline = true
label.Color = Color3.fromRGB(255, 255, 255)
label.Text = State.FullAutoFarm and "[ ON ] AUTOFARM NIKO" or "[ OFF ] AUTOFARM (PAUSED)"
label.Visible = true

local sublabel = Drawing.new("Text")
sublabel.Position = Vector2.new(btnX + btnW / 2, btnY + 26)
sublabel.Size = 12
sublabel.Center = true
sublabel.Outline = true
sublabel.Color = Color3.fromRGB(220, 220, 220)
sublabel.Text = "Click or press [K] to toggle"
sublabel.Visible = true

local statsLabel = Drawing.new("Text")
statsLabel.Position = Vector2.new(btnX + btnW / 2, btnY + 42)
statsLabel.Size = 11
statsLabel.Center = true
statsLabel.Outline = true
statsLabel.Color = Color3.fromRGB(255, 220, 100)
statsLabel.Text = "Quests: 0 | EXP: +0"
statsLabel.Visible = true

_G.NikoFarmUI = { bg = bg, border = border, label = label, sublabel = sublabel, statsLabel = statsLabel }

local function updateUI()
    if State.FullAutoFarm then
        bg.Color = Color3.fromRGB(40, 160, 60)
        label.Text = "[ ON ] AUTOFARM NIKO"
    else
        bg.Color = Color3.fromRGB(180, 40, 40)
        label.Text = "[ OFF ] AUTOFARM (PAUSED)"
    end
    statsLabel.Text = string.format("Quests: %d | EXP: +%d", Stats.Completed, Stats.ExpEarned)
end

local function toggleFarm()
    State.FullAutoFarm = not State.FullAutoFarm
    updateUI()
    print("[NikoAutoFarm] State:", State.FullAutoFarm and "ACTIVE (ON)" or "PAUSED (OFF)")
end

-- Mouse click detection on the floating button
task.spawn(function()
    while _G.NikoFarmActive do
        if ismouse1pressed and ismouse1pressed() then
            local mx, my = mouse.X, mouse.Y
            if mx >= btnX and mx <= (btnX + btnW) and my >= btnY and my <= (btnY + btnH) then
                toggleFarm()
                -- Debounce wait until mouse release
                while ismouse1pressed and ismouse1pressed() do
                    task.wait(0.05)
                end
            end
        end
        task.wait(0.04)
    end
end)

-- Keyboard shortcuts: [K] = Toggle ON/OFF | [N] = Save current position as Niko's
_G.NikoFarmInputConn = UserInputService.InputBegan:Connect(function(input)
    if not input or not input.KeyCode then return end
    if input.KeyCode == Enum.KeyCode.K or input.KeyCode == 107 then
        toggleFarm()
    elseif input.KeyCode == Enum.KeyCode.N or input.KeyCode == 110 then
        local char = lp.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            QuestRegistry["NikoDelivery"].NpcPos = hrp.Position
            print(string.format("[NikoAutoFarm] Niko's position updated to: Vector3.new(%.1f, %.1f, %.1f)", 
                hrp.Position.X, hrp.Position.Y, hrp.Position.Z))
        end
    end
end)

-- =========================================================================
-- 3. ENVIRONMENT & TELEPORT UTILITIES (CFRAME FIX)
-- =========================================================================

local function smartTeleportToEntity(npcName, npcPos)
    local char = lp.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local target = npcPos

    -- Search if the NPC Model is loaded within the Workspace
    if npcName and npcName ~= "" then
        for _, m in ipairs(workspace:GetDescendants()) do
            if m.ClassName == "Model" and m.Name:lower():find(npcName:lower(), 1, true) then
                local part = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart or m:FindFirstChild("Head")
                if part then
                    target = part.Position
                    break
                end
            end
        end
    end

    if target then
        pcall(function()
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            -- CFrame.new receives the 3 discrete coordinates (X, Y, Z)
            hrp.CFrame = CFrame.new(target.X, target.Y + 2.5, target.Z)
        end)
    end
    task.wait(0.2)
end

local function uiClick(btn)
    if not btn then return end
    if firesignal then
        pcall(function() firesignal(btn.MouseButton1Click) end)
        pcall(function() firesignal(btn.Activated) end)
        return
    end
    if VirtualInputManager and btn.AbsolutePosition then
        local pos = btn.AbsolutePosition
        local size = btn.AbsoluteSize
        local cx = math.floor(pos.X + size.X / 2)
        local cy = math.floor(pos.Y + size.Y / 2)
        pcall(function()
            VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, true, game, 0)
            task.wait(0.04)
            VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 0)
        end)
        return
    end
    if mousemoveabs and mouse1click and btn.AbsolutePosition then
        local pos = btn.AbsolutePosition
        local size = btn.AbsoluteSize
        local cx = math.floor(pos.X + size.X / 2)
        local cy = math.floor(pos.Y + size.Y / 2)
        pcall(function()
            mousemoveabs(cx, cy)
            task.wait(0.04)
            mouse1click()
        end)
    end
end

local function clickNearbyPrompt()
    local char = lp.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    for _, p in ipairs(workspace:GetDescendants()) do
        if p.ClassName == "ProximityPrompt" and p.Enabled then
            local parent = p.Parent
            local pPos = parent and (parent:IsA("BasePart") and parent.Position or (parent:IsA("Model") and parent.PrimaryPart and parent.PrimaryPart.Position))
            if pPos and (pPos - hrp.Position).Magnitude <= (p.MaxActivationDistance or 15) then
                if fireproximityprompt then
                    fireproximityprompt(p)
                end
            end
        end
    end
end

-- =========================================================================
-- 4. QUEST LOGIC & DIALOGUE HANDLING
-- =========================================================================

-- 1. Read the player's active quest data from ReplicatedStorage
local function getActiveQuest()
    local pData = ReplicatedStorage:FindFirstChild("Player_Service")
        and ReplicatedStorage.Player_Service:FindFirstChild("Data")
        and ReplicatedStorage.Player_Service.Data:FindFirstChild(lp.Name)
    local holder = pData and pData:FindFirstChild("slots")
        and pData.slots:FindFirstChild("Slot1")
        and pData.slots.Slot1:FindFirstChild("Quests")
        and pData.slots.Slot1.Quests:FindFirstChild("Holder")
    if not holder then return nil end
    local first = nil
    for _, q in ipairs(holder:GetChildren()) do
        local tasksFolder = q:FindFirstChild("Tasks")
        if tasksFolder then
            local tasks = {}
            local isAllComplete = true
            for _, t in ipairs(tasksFolder:GetChildren()) do
                local val = t:FindFirstChild("Value") and t.Value.Value or 0
                local max = t:FindFirstChild("Max") and t.Max.Value or 1
                table.insert(tasks, {
                    Name = t.Name,
                    Value = val,
                    Max = max,
                    Code = t:FindFirstChild("Code") and t.Code.Value or ""
                })
                if val < max then
                    isAllComplete = false
                end
            end
            local qStr = q:FindFirstChild("QuestString") and q.QuestString.Value or q.Name
            local entry = {
                Folder = q,
                Name = qStr,
                Id = q.Name,
                Tasks = tasks,
                Complete = isAllComplete
            }
            if not isAllComplete then
                return entry
            end
            if not first then first = entry end
        end
    end
    return first
end

-- 2. Dialogue UI retrieval
local function getDialogueUI()
    local holder = lp.PlayerGui:FindFirstChild("ComponentsHolder")
    local frame = holder and holder:FindFirstChild("DialogueFrame")
    local actual = frame and frame:FindFirstChild("Actual")
    if not actual then return nil end
    local bh = actual:FindFirstChild("ButtonHolder")
    if bh then
        for _, f in ipairs(bh:GetChildren()) do
            if f.ClassName == "Frame" and f:FindFirstChild("TextButton") then
                return actual
            end
        end
    end
    return nil
end

local function collectChoices(actual)
    local holder = actual:FindFirstChild("ButtonHolder")
    local choices = {}
    if not holder then return choices end
    for _, f in ipairs(holder:GetChildren()) do
        if f.ClassName == "Frame" and f:FindFirstChild("TextButton") then
            local btn = f:FindFirstChild("TextButton")
            local txt = ""
            pcall(function() txt = btn.Actual.TextLabel.Text end)
            choices[#choices + 1] = { Frame = f, Button = btn, Text = txt }
        end
    end
    return choices
end

-- Simulate button clicks on NPC dialogues (avoids 'Close' accidentally)
local function handleQuestDialogue(pickBoss)
    for _ = 1, 45 do
        local actual = getDialogueUI()
        if not actual then return true end
        local choices = collectChoices(actual)
        if #choices > 0 then
            local match = nil
            -- Prioritize valid choices over 'Close'
            for _, c in ipairs(choices) do
                local t = c.Text and c.Text:lower() or ""
                if not t:find("close") then
                    match = c
                    break
                end
            end
            if not match then match = choices[1] end
            
            if match then
                uiClick(match.Button)
            end
            task.wait(0.45)
        else
            local cd = actual:FindFirstChild("ClickDetector")
            if cd then uiClick(cd) end
            task.wait(0.45)
        end
    end
    return false
end

-- 3. Teleport to NPC and press interaction key (T) to accept quest
local function autoAcceptQuest(npcName, npcPos)
    for round = 1, 3 do
        smartTeleportToEntity(npcName, npcPos)
        task.wait(0.9)
        clickNearbyPrompt()
        pcall(function() keypress(84); task.wait(0.35); keyrelease(84) end) -- Press 'T'
        task.wait(0.8)
        if getDialogueUI() then
            if handleQuestDialogue(false) then
                task.wait(1.0)
                if getActiveQuest() then return true end
            end
        end
        task.wait(0.6)
    end
    return false
end

-- 4. Main State Machine step (Accept -> Deliver -> Claim -> Repeat)
local function fafStep()
    if not State.FullAutoFarm then return end

    local activeQ = getActiveQuest()
    local data = QuestRegistry[State.SelectedQuest]
    if not data then return end

    if activeQ then
        -- Check if package has already been delivered to Shiori
        local isDelivered = false
        if activeQ.Tasks then
            for _, t in ipairs(activeQ.Tasks) do
                if t.Name:find("Deliver to Shiori") and t.Value >= t.Max then
                    isDelivered = true
                    break
                end
            end
        end

        if not isDelivered and not activeQ.Complete then
            -- Case A: Active quest -> Teleport to Shiori at Butterfly Estate to deliver
            State.AutoQuestTasks = true
            print("[NikoAutoFarm] Delivering supply box to Shiori at Butterfly Estate...")
            smartTeleportToEntity(data.TargetNpcName, data.TargetNpcPos)
            task.wait(0.9)
            clickNearbyPrompt()
            pcall(function() keypress(84); task.wait(0.35); keyrelease(84) end)
            task.wait(0.8)
            if getDialogueUI() then
                handleQuestDialogue(nil)
            end
            task.wait(0.5)

        else
            -- Case B: Package delivered or quest ready -> Return to Niko to report and claim rewards
            State.AutoQuestTasks = false
            print("[NikoAutoFarm] Claiming reward from Estate Worker Niko...")
            smartTeleportToEntity(data.NpcName, data.NpcPos)
            task.wait(0.9)
            clickNearbyPrompt()
            pcall(function() keypress(84); task.wait(0.35); keyrelease(84) end)
            task.wait(0.8)
            if getDialogueUI() then
                handleQuestDialogue(nil)
            end
            task.wait(1.0)

            -- Check if quest completed and claim registered
            local checkQ = getActiveQuest()
            if not checkQ or checkQ.Id ~= activeQ.Id then
                Stats.Completed = Stats.Completed + 1
                Stats.ExpEarned = Stats.Completed * 1000
                Stats.MoneyEarned = Stats.Completed * 400
                updateUI()
                print(string.format("[NikoAutoFarm] Quest #%d claimed! (+1,000 EXP, +400 Money) | Total EXP: +%d", 
                    Stats.Completed, Stats.ExpEarned))
            end
            task.wait(0.5)
        end
    else
        -- Case C: No active quest -> Teleport to Niko and accept the quest
        State.AutoQuestTasks = false
        print("[NikoAutoFarm] Accepting quest from Estate Worker Niko...")
        autoAcceptQuest(data.NpcName, data.NpcPos)
        task.wait(0.8)
    end
end

-- =========================================================================
-- 5. RUN MAIN LOOP
-- =========================================================================
task.spawn(function()
    print("[NikoAutoFarm] System running.")
    print("[NikoAutoFarm] Controls: Click the on-screen button or press [K] to toggle | Press [N] to save Niko's position.")
    
    while _G.NikoFarmActive do
        if State.FullAutoFarm then
            fafStep()
        end
        task.wait(0.5)
    end
end)
