local function GetDestinationCenter(destType)
    local char = lp.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if destType == "At Campfire" then
        return CAMPFIRE_POS
    elseif destType == "At Crafting Table" then
        return CRAFTING_POS
    else
        return root and root.Position or Vector3.new(0, 0, 0)
    end
end

local function GetItemWorldPos(item)
    if not item or not item.Parent then return nil end
    local p = item.PrimaryPart or item:FindFirstChild("Main") or item:FindFirstChild("HumanoidRootPart")
    if p and p:IsA("BasePart") then
        return p.Position
    end
    local bp = item:FindFirstChildWhichIsA("BasePart")
    if bp then
        return bp.Position
    end
    for _, d in ipairs(item:GetDescendants()) do
        if d:IsA("BasePart") then
            return d.Position
        end
    end
    return nil
end

local function GetTargetPosition(destType, count)
    local char = lp.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local idx = count or 1

    if destType == "At Campfire" then
        local ring = math.floor((idx - 1) / 10)
        local posInRing = (idx - 1) % 10
        local radius = 4.5 + (ring * 1.5)
        local angle = (posInRing / 10) * (math.pi * 2)
        return CAMPFIRE_POS + Vector3.new(math.cos(angle) * radius, 0.2, math.sin(angle) * radius)
    elseif destType == "At Crafting Table" then
        local ring = math.floor((idx - 1) / 8)
        local posInRing = (idx - 1) % 8
        local radius = 3.5 + (ring * 1.2)
        local angle = (posInRing / 8) * (math.pi * 2)
        return CRAFTING_POS + Vector3.new(math.cos(angle) * radius, 0.2, math.sin(angle) * radius)
    else
        local pPos = root and root.Position or Vector3.new(0, 4, 0)
        local ring = math.floor((idx - 1) / 8)
        local posInRing = (idx - 1) % 8
        local radius = playerCircleRadius + (ring * 1.1)
        local angle = (posInRing / 8) * (math.pi * 2) + (ring * 0.4)
        return pPos + Vector3.new(math.cos(angle) * radius, -1.8, math.sin(angle) * radius)
    end
end

local function MoveAllItemParts(item, targetPos)
    if not item or not item.Parent then return false end
    local isCoin = item.Name:find("Coin") or item:GetAttribute("Interaction") == "Currency"
    local moved = false

    for _, p in ipairs(item:GetDescendants()) do
        if p:IsA("BasePart") then
            p.Position = targetPos
            p.AssemblyLinearVelocity = Vector3.zero
            p.Velocity = Vector3.zero
            moved = true
        end
    end

    if not isCoin and startDrag and stopDrag then
        pcall(function()
            startDrag:FireServer(item)
            stopDrag:FireServer(item)
        end)
    end
    return moved
end

local function SafeBatchTeleport(rawList, destType, label)
    task.spawn(function()
        local destCenter = GetDestinationCenter(destType)
        local itemsToMove = {}

        for _, item in ipairs(rawList) do
            if ignoreNearItems then
                local pos = GetItemWorldPos(item)
                if pos and (pos - destCenter).Magnitude <= ignoreDistance then
                    -- already close, skip
                else
                    table.insert(itemsToMove, item)
                end
            else
                table.insert(itemsToMove, item)
            end
        end

        local total = #itemsToMove
        if total == 0 then
            Notify("Magnet", "All " .. (label or "items") .. " are already at destination.", "circlecheck")
            return
        end

        Notify("Attracting", "Bringing " .. total .. " " .. (label or "items") .. "...", "zap")

        local count = 0
        for _, item in ipairs(itemsToMove) do
            count = count + 1
            local targetPos = GetTargetPosition(destType, count)
            MoveAllItemParts(item, targetPos)

            if count % 7 == 0 then
                task.wait(0.02)
            end
        end

        Notify("Completed", "Brought " .. count .. " " .. (label or "items") .. " in a compact circle.", "circlecheck")
    end)
end

local function IsFuelItem(item)
    if item:GetAttribute("BurnFuel") ~= nil then return true end
    local n = item.Name:lower()
    return n:find("fuel") or n:find("oil") or n:find("barrel") or n:find("canister") or n:find("coal") or n:find("log") or n:find("wood")
end

local function ScanNearbyItemsList()
    local char = lp.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local pPos = root and root.Position or Vector3.new(0, 0, 0)

    local counts = {}
    if itemsFolder then
        for _, it in ipairs(itemsFolder:GetChildren()) do
            local pos = GetItemWorldPos(it)
            if pos and (pos - pPos).Magnitude <= scanRadius then
                counts[it.Name] = (counts[it.Name] or 0) + 1
            end
        end
    end

    local list = {}
    for name, count in pairs(counts) do
        table.insert(list, name .. " (" .. count .. ")")
    end
    table.sort(list)

    if #list == 0 then
        table.insert(list, "No items in range")
    end
    return list
end

local function GetAllPlayerTools()
    local tools = {}
    local seen = {}

    local function addToolsFrom(container)
        if not container then return end
        for _, item in ipairs(container:GetChildren()) do
            if not seen[item] then
                seen[item] = true
                table.insert(tools, item)
            end
        end
    end

    addToolsFrom(lp:FindFirstChild("Inventory"))
    addToolsFrom(lp:FindFirstChild("ItemBag"))
    addToolsFrom(lp:FindFirstChild("Backpack"))
    addToolsFrom(lp.Character)

    return tools
end

local function GetBestAxe()
    local allTools = GetAllPlayerTools()
    local bestAxe = nil
    local bestDamage = 0

    for _, item in ipairs(allTools) do
        local n = item.Name:lower()
        local tName = (item:GetAttribute("ToolName") or ""):lower()
        local resDmg = item:GetAttribute("WeaponResourceDamage")
        local wepDmg = item:GetAttribute("WeaponDamage")

        local isAxe = tName:find("axe") ~= nil or tName:find("chainsaw") ~= nil 
            or n:find("axe") ~= nil or n:find("chainsaw") ~= nil

        if isAxe then
            local dmg = resDmg or wepDmg or 4
            if dmg > bestDamage then
                bestDamage = dmg
                bestAxe = item
            end
        end
    end

    if not bestAxe then
        for _, item in ipairs(allTools) do
            local resDmg = item:GetAttribute("WeaponResourceDamage")
            if resDmg and resDmg > bestDamage then
                bestDamage = resDmg
                bestAxe = item
            end
        end
    end

    return bestAxe, (bestDamage > 0 and bestDamage or 4)
end

local function GetBestWeapon()
