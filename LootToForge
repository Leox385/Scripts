local function getBestTrainArea()
    local rebirths = 0
    pcall(function()
        local eco = lp:FindFirstChild("Eco")
        if eco and eco:FindFirstChild("rebirth") then
            rebirths = tonumber(eco.rebirth.Value) or 0
        end
    end)

    local helper = nil
    pcall(function()
        helper = require(ReplicatedStorage.Config.TrainArea.Helper)
    end)

    for _, area in ipairs(AUTO_TRAIN_AREAS) do
        local need = area.needRebirth
        if helper and helper.GetNeedRebirth then
            pcall(function()
                need = helper.GetNeedRebirth(area.id) or need
            end)
        end
        if rebirths >= need then
            local livePos = area.pos
            pcall(function()
                local touched = Workspace:FindFirstChild("TOUCHED")
                local trainAreaFolder = touched and touched:FindFirstChild("AutoTrainArea")
                local part = trainAreaFolder and trainAreaFolder:FindFirstChild(tostring(area.id))
                if part and (part.ClassName == "Part" or part.ClassName == "MeshPart") then
                    local s, pPos = pcall(function() return part.Position end)
                    if s and typeof(pPos) == "Vector3" then
                        livePos = pPos
                    end
                end
            end)
            return area, livePos, rebirths
        end
    end

    local fallback = AUTO_TRAIN_AREAS[#AUTO_TRAIN_AREAS]
    return fallback, fallback.pos, rebirths
end

local function killStageEnemies()
    local remotes = ReplicatedStorage:FindFirstChild("Remote")
    local attackFolder = remotes and remotes:FindFirstChild("Attack")
    local enemyHitBE = attackFolder and attackFolder:FindFirstChild("EnemyHitBE")
    local attackEnemyBE = attackFolder and attackFolder:FindFirstChild("AttackEnemyBE")
    local dummyHitBE = attackFolder and attackFolder:FindFirstChild("DummyHitBE")
    local atkOnceBE = attackFolder and attackFolder:FindFirstChild("ATKOnceBE")

    local EnemyCTRL = nil
    pcall(function()
        local ctrl = ReplicatedStorage:FindFirstChild("CTRL")
        if ctrl and ctrl:FindFirstChild("EnemyCTRL") then
            EnemyCTRL = require(ctrl.EnemyCTRL)
        end
    end)

    local HPCTRL = nil
    pcall(function()
        local ctrl = ReplicatedStorage:FindFirstChild("CTRL")
        if ctrl and ctrl:FindFirstChild("HPCTRL") then
            HPCTRL = require(ctrl.HPCTRL)
        end
    end)

    local StageUtils = nil
    pcall(function()
        local mgr = lp:FindFirstChild("PlayerScripts") and lp.PlayerScripts:FindFirstChild("Manager")
        local sm = mgr and mgr:FindFirstChild("StageManager")
        if sm and sm:FindFirstChild("StageUtils") then
            StageUtils = require(sm.StageUtils)
        end
    end)

    local count = 0

    local enemyFolder = Workspace:FindFirstChild("EnemyFolder")
    if enemyFolder then
        local enemyNames = {}
        for _, enemy in ipairs(enemyFolder:GetChildren()) do
            local hp = enemy:FindFirstChild("HPValue") or enemy:FindFirstChild("HPValue", true)
            local isDead = enemy:GetAttribute("Dead")
            if (hp and hp.Value > 0) or (not isDead) then
                table.insert(enemyNames, enemy.Name)
                count = count + 1

                if enemyHitBE then
                    pcall(function()
                        enemyHitBE:Fire(enemy.Name, 999999999999, {
                            SkillID = "Player_ATK_1",
                            Damage = 999999999999,
                            IsCrit = true
                        })
                    end)
                end

                if StageUtils and StageUtils.HurtEnemy then
                    pcall(function()
                        StageUtils.HurtEnemy(enemy.Name, 999999999999, { Damage = 999999999999 })
                    end)
                end

                if EnemyCTRL and EnemyCTRL.HurtEnemy then
                    pcall(function()
                        EnemyCTRL.HurtEnemy(enemy.Name, 999999999999, { Damage = 999999999999 })
                    end)
                end
                if EnemyCTRL and EnemyCTRL.DeadEnemyData then
                    pcall(function()
                        EnemyCTRL.DeadEnemyData(enemy.Name)
                    end)
                end

                if HPCTRL and HPCTRL.DamageOnce then
                    pcall(function()
                        HPCTRL.DamageOnce(enemy, 999999999999)
                    end)
                end
                if HPCTRL and HPCTRL.SetCurrentHP then
                    pcall(function()
                        HPCTRL.SetCurrentHP(enemy, 0)
                    end)
                end

                pcall(function()
                    if hp then hp.Value = 0 end
                    local hum = enemy:FindFirstChild("Humanoid")
                    if hum then hum.Health = 0 end
                    enemy:SetAttribute("Dead", true)
                end)
            end
        end

        if #enemyNames > 0 and attackEnemyBE then
            pcall(function()
                attackEnemyBE:Fire(enemyNames, {
                    Attacker = lp,
                    SkillID = "Player_ATK_1"
                })
            end)
        end
    end

    local canAttackFolder = Workspace:FindFirstChild("CanAttackFolder")
    if canAttackFolder then
        for _, obj in ipairs(canAttackFolder:GetChildren()) do
            local hp = obj:FindFirstChild("HPValue") or obj:FindFirstChild("HPValue", true)
            if hp and hp.Value > 0 then
                count = count + 1
                if dummyHitBE then
                    pcall(function()
                        dummyHitBE:Fire(obj, 999999999999, {
                            SkillID = "Player_ATK_1",
                            Damage = 999999999999
                        })
                    end)
                end
                if HPCTRL and HPCTRL.DamageOnce then
                    pcall(function()
                        HPCTRL.DamageOnce(obj, 999999999999)
                    end)
                end
                pcall(function()
                    hp.Value = 0
                end)
            end
        end
    end

    if count > 0 and atkOnceBE then
        pcall(function() atkOnceBE:Fire() end)
    end

    return count
end

local function getPartPosition(part)
    if not part then return nil end
    local s, pos = pcall(function() return part.Position end)
    if s and typeof(pos) == "Vector3" then
        return pos
    end
    return nil
end

local function getOreMainPart(ore)
    if not ore then return nil end
    local pp = ore.PrimaryPart
    if pp and (pp.ClassName == "Part" or pp.ClassName == "MeshPart" or pp.ClassName == "UnionOperation") then
        return pp
    end
    for _, name in ipairs({"MAIN", "Main", "Part", "RootPart", "Handle"}) do
        local child = ore:FindFirstChild(name)
        if child and (child.ClassName == "Part" or child.ClassName == "MeshPart" or child.ClassName == "UnionOperation") then
            return child
        end
    end
    for _, child in ipairs(ore:GetChildren()) do
        if child.ClassName == "Part" or child.ClassName == "MeshPart" or child.ClassName == "UnionOperation" then
            return child
        end
    end
    for _, desc in ipairs(ore:GetDescendants()) do
        if desc.ClassName == "Part" or desc.ClassName == "MeshPart" or desc.ClassName == "UnionOperation" then
            return desc
        end
    end
    return nil
end

local function getOrePosition(ore)
    if not ore then return nil end
    local main = getOreMainPart(ore)
    if main then
        local pos = getPartPosition(main)
        if pos then return pos end
    end
    for _, desc in ipairs(ore:GetDescendants()) do
        local pos = getPartPosition(desc)
        if pos then return pos end
    end
    return nil
end

local function freezeOre(ore)
    if not ore then return end
    for _, p in ipairs(ore:GetDescendants()) do
        if p.ClassName == "Part" or p.ClassName == "MeshPart" or p.ClassName == "UnionOperation" then
            pcall(function()
                p.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                p.Velocity = Vector3.new(0, 0, 0)
            end)
        end
    end
end

local function spinInPlace(duration)
    local curPos, hrp = getHRPPosition()
    if not curPos or not hrp then return end
    local x, y, z = curPos.X, curPos.Y, curPos.Z

    local startTime = tick()
    local angle = 0
    while tick() - startTime < (duration or 3.0) do
        if not STATE.Running or not STATE.Zone27Loop then break end

        angle = (angle + 30) % 360
        local rad = math.rad(angle)

        pcall(function()
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            hrp.Velocity = Vector3.new(0, 0, 0)
            local ok = pcall(function()
                hrp.CFrame = CFrame.new(x, y, z) * CFrame.Angles(0, rad, 0)
            end)
            if not ok then
                hrp.CFrame = CFrame.lookAt(Vector3.new(x, y, z), Vector3.new(x + math.sin(rad), y, z + math.cos(rad)))
            end
            hrp.Position = Vector3.new(x, y, z)
        end)

        killStageEnemies()
        task.wait(0.08)
    end
end

local function goToAndCollectOre(ore, oreCache)
    if not ore or ore.Parent ~= oreCache then return false end

    local orePos = getOrePosition(ore)
    if not orePos then return false end

    local curPos, hrp = getHRPPosition()
    if not curPos or not hrp then return false end

    freezeOre(ore)

    pcall(function()
        local freshOrePos = getOrePosition(ore) or orePos
        if freshOrePos and hrp then
            local tx, ty, tz = freshOrePos.X, freshOrePos.Y + 1.2, freshOrePos.Z
            hrp.CFrame = CFrame.new(tx, ty, tz)
            hrp.Position = Vector3.new(tx, ty, tz)
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            hrp.Velocity = Vector3.new(0, 0, 0)
        end
    end)
    task.wait(0.12)

    pcall(function()
        if fireproximityprompt then
            for _, desc in ipairs(ore:GetDescendants()) do
                if desc.ClassName == "ProximityPrompt" then
                    fireproximityprompt(desc, 0)
                    break
                end
            end
        end
    end)

    if keypress and keyrelease then
        pcall(function()
            keypress(0x45)
            local t0 = tick()
            while tick() - t0 < 1.35 do
                if not ore or ore.Parent ~= oreCache or not STATE.Running or not (STATE.AutoCollectOres or STATE.Zone27Loop) then
                    break
                end
                local _, curHRP = getHRPPosition()
                if curHRP then
                    curHRP.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    curHRP.Velocity = Vector3.new(0, 0, 0)
                end
                task.wait(0.05)
            end
        end)
        pcall(function() keyrelease(0x45) end)
    else
        task.wait(1.2)
    end

    task.wait(0.08)
    return true
end

local function collectAllOresThoroughly()
    local oreCache = Workspace:FindFirstChild("OreCache")
    if not oreCache then return 0 end

    local totalCollected = 0
    local maxPasses = 5
    local pass = 0

    while STATE.Running and (STATE.AutoCollectOres or STATE.Zone27Loop) and pass < maxPasses do
        pass = pass + 1
        local ores = oreCache:GetChildren()
        if #ores == 0 then
            break
        end

        for _, ore in ipairs(ores) do
            if not STATE.Running or not (STATE.AutoCollectOres or STATE.Zone27Loop) then break end
            if ore and ore.Parent == oreCache then
                if goToAndCollectOre(ore, oreCache) then
                    totalCollected = totalCollected + 1
                end
                task.wait(0.12)
            end
        end
        task.wait(0.3)
    end

    return totalCollected
end

