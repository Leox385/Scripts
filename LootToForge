    local function spinInPlace(duration, conditionCheck, fixedPos)
        local curPos, hrp = getHRPPosition()
        if not hrp then return end

        local x, y, z
        if fixedPos and typeof(fixedPos) == "Vector3" then
            x, y, z = fixedPos.X, fixedPos.Y, fixedPos.Z
        elseif curPos then
            x, y, z = curPos.X, curPos.Y, curPos.Z
        else
            return
        end

        local startTime = clock()
        local angle = 0
        while clock() - startTime < (duration or 3.0) do
            if not STATE.Running then break end
            if conditionCheck then
                if not conditionCheck() then break end
            else
                if not STATE.Zone27Loop and not STATE.TowerFarm then break end
            end

            local _, liveHRP = getHRPPosition()
            if not liveHRP then break end

            angle = (angle + 30) % 360
            local rad = math.rad(angle)

            pcall(function()
                liveHRP.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                liveHRP.CFrame = CFrame.new(x, y, z) * CFrame.Angles(0, rad, 0)
            end)

            killStageEnemies()
            task.wait(0.08)
        end
    end

    local function goToAndCollectOre(ore, oreCache)
        if not ore or ore.Parent ~= oreCache then return false end

        local isFull = getBackpackInfo()
        if isFull then return false end

        local orePos = getOrePosition(ore)
        if not orePos then return false end

        local curPos, hrp = getHRPPosition()
        if not curPos or not hrp then return false end

        freezeOre(ore)

        pcall(function()
            local freshOrePos = getOrePosition(ore) or orePos
            if freshOrePos and hrp then
                local tx, ty, tz = freshOrePos.X, freshOrePos.Y + 1.2, freshOrePos.Z
                hrp.CFrame = CFrame.new(tx, ty, tz)
                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                hrp.Velocity = Vector3.new(0, 0, 0)
            end
        end)
        task.wait(0.12)

        pcall(function()
            if fireproximityprompt then
                for _, desc in ipairs(ore:GetDescendants()) do
                    if desc.ClassName == "ProximityPrompt" then
                        fireproximityprompt(desc, 0)
                        break
                    end
                end
            end
        end)

        if type(keypress) == "function" and type(keyrelease) == "function" and
            type(isrbxactive) == "function" and select(2, pcall(isrbxactive)) == true then
            pcall(function()
                keypress(0x45)
                local t0 = clock()
                while clock() - t0 < 1.35 do
                    if not validContext(contexts[coroutine.running()]) or not select(2, pcall(isrbxactive)) or
                        not ore or ore.Parent ~= oreCache or not STATE.Running or not (STATE.AutoCollectOres or STATE.Zone27Loop) then
                        break
                    end
                    local isFullNow = getBackpackInfo()
                    if isFullNow then break end

                    local _, curHRP = getHRPPosition()
                    if curHRP then
                        curHRP.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                        curHRP.Velocity = Vector3.new(0, 0, 0)
                    end
                    task.wait(0.05)
                end
            end)
            pcall(function() keyrelease(0x45) end)
        else
            task.wait(1.2)
        end

        task.wait(0.08)
        return ore.Parent ~= oreCache
    end

    local function collectAllOresThoroughly()
        local oreCache = Workspace:FindFirstChild("OreCache")
        if not oreCache then return 0 end

        local totalCollected = 0
        local maxPasses = 5
        local pass = 0

        while STATE.Running and (STATE.AutoCollectOres or STATE.Zone27Loop) and pass < maxPasses do
            local isFull = getBackpackInfo()
            if isFull then break end

            pass = pass + 1
            local ores = oreCache:GetChildren()
            if #ores == 0 then
                break
            end

            for _, ore in ipairs(ores) do
                if not STATE.Running or not (STATE.AutoCollectOres or STATE.Zone27Loop) then break end
                local isFullNow = getBackpackInfo()
                if isFullNow then break end

                if ore and ore.Parent == oreCache then
                    if goToAndCollectOre(ore, oreCache) then
                        totalCollected = totalCollected + 1
                    end
                    task.wait(0.12)
                end
            end
            task.wait(0.3)
        end

        return totalCollected
    end

    local pendingCalls = {}
    local function invokeBounded(remote, ...)
        check()
        if not remote or pendingCalls[remote] then return false end
        local args, n = {...}, select("#", ...)
        local unpackf = table.unpack or unpack
        local call = {done=false}
        pendingCalls[remote] = call
        hostSpawn(function()
            if not alive then pendingCalls[remote] = nil; return end
            call.ok, call.result = pcall(function() return remote:InvokeServer(unpackf(args,1,n)) end)
            call.done = true
            pendingCalls[remote] = nil
        end)
        local deadline = clock() + 5
        while not call.done and clock() < deadline do task.wait(0.05) end
        if not call.done then report("Tiempo agotado en " .. tostring(remote)); return false end
        return call.ok, call.result
    end

