	local function makeIcon(name, create)
		local segments = ICONS[name] or ICONS.button
		local icon = { segments = segments, draws = {} }
		for i = 1, #segments do icon.draws[i] = create("Line", { Thickness = 1.4, Visible = false }) end
		return icon
	end
	local function paintIcon(icon, x, y, size, color, visible)
		if not icon then return end
		local r = size / 2
		for i, segment in ipairs(icon.segments) do
			local d = icon.draws[i]
			d.Visible = visible
			if visible then
				d.From = V(x + segment[1] * r, y + segment[2] * r)
				d.To = V(x + segment[3] * r, y + segment[4] * r)
				d.Color = color
			end
		end
	end
