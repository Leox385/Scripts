        local char = lp.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")

        if on then
            if not root then
                Notify("AFK Mode", "Character not found.", "trianglealert")
                afkSkyHaven = false
                return
            end

            savedGroundPos = root.Position
            local havenPos = CAMPFIRE_POS + Vector3.new(0, 14, 0)
            root.AssemblyLinearVelocity = Vector3.zero
            root.CFrame = CFrame.new(havenPos.X, havenPos.Y, havenPos.Z)
            Notify("AFK Sky Haven", "Suspended above campfire. Safe from cold and ground enemies.", "shield")

            task.spawn(function()
                while afkSkyHaven and mySession == afkSession do
                    local c = lp.Character
                    local r = c and c:FindFirstChild("HumanoidRootPart")
                    if r then
                        r.AssemblyLinearVelocity = Vector3.zero
                        r.Velocity = Vector3.zero
                        r.CFrame = CFrame.new(havenPos.X, havenPos.Y, havenPos.Z)
                    end
                    task.wait(0.04)
                end
                local c = lp.Character
                local r = c and c:FindFirstChild("HumanoidRootPart")
                if r then
                    r.AssemblyLinearVelocity = Vector3.zero
                    if savedGroundPos then
                        r.CFrame = CFrame.new(savedGroundPos.X, savedGroundPos.Y + 2, savedGroundPos.Z)
                    end
                end
            end)
        else
            local c = lp.Character
            local r = c and c:FindFirstChild("HumanoidRootPart")
            if r then
                r.AssemblyLinearVelocity = Vector3.zero
                if savedGroundPos then
                    r.CFrame = CFrame.new(savedGroundPos.X, savedGroundPos.Y + 2, savedGroundPos.Z)
