local function getActiveChests()
    local list = {}
    local chests = Workspace:FindFirstChild("Chests")
    if chests then
        for _, ch in ipairs(chests:GetChildren()) do
            local p = ch:FindFirstChildWhichIsA("BasePart") or ch:FindFirstChild("HumanoidRootPart") or ch:FindFirstChild("Root")
            if p then
                table.insert(list, { Instance = ch, Name = ch.Name, Position = p.Position })
            end
        end
    end
    local deb = Workspace:FindFirstChild("Debree")
    if deb then
        for _, ch in ipairs(deb:GetChildren()) do
            if ch.Name:lower():find("chest") and ch.ClassName == "Model" then
                local p = ch:FindFirstChildWhichIsA("BasePart") or ch:FindFirstChild("HumanoidRootPart")
                if p then
                    table.insert(list, { Instance = ch, Name = ch.Name, Position = p.Position })
                end
            end
        end
    end
    return list
end

