local function chopUntilFell(targetType)
    if isManualChopping then
        Non:Notify({Title = "Execution", Content = "Active. Please wait.", Icon = "info", Duration = 2})
        return
    end

    local axe = ensureAxeEquipped()
    if not axe then
        Non:Notify({Title = "Error", Content = "No valid axe found in inventory.", Icon = "alert-triangle", Duration = 3})
        return
    end

    local tree, section, dist = findTreeLowest(targetType)
    local char, root, hum = getChar()
    if not tree or not section or not root then
        Non:Notify({Title = "Not Found", Content = "No matching targets for: " .. tostring(targetType), Icon = "alert-triangle", Duration = 3})
        return
    end

    isManualChopping = true
    local tc = tree:FindFirstChild("TreeClass")
    local treeClassName = (tc and tc.Value ~= "") and tc.Value or "Standard"

    local cutPos = section.Position

    if dist > 14 then
        local targetPos = cutPos + Vector3.new(2.5, 0.5, 2.5)
        local lookTarget = Vector3.new(cutPos.X, targetPos.Y, cutPos.Z)
        safeTeleport(CFrame.lookAt(targetPos, lookTarget))
        task.wait(0.25)
    end

    Non:Notify({
        Title = "Active", 
        Content = string.format("Targeting %s until destruction...", treeClassName), 
        Icon = "zap", 
        Duration = 3
    })

    task.spawn(function()
        local startTime = tick()
        local maxDuration = 240
        local hits = 0

        while isManualChopping and (tick() - startTime < maxDuration) do
            if not tree or not tree.Parent or not tree:IsDescendantOf(workspace) then
                break
            end

            if tree:FindFirstChild("RootCut") then
                break
            end

            if not section or not section.Parent or not section:IsDescendantOf(tree) then
                section = findLowestSection(tree)
                if not section then
                    break
                end
            end

            local liveChar, liveRoot, liveHum = getChar()
            if not liveHum or liveHum.Health <= 0 or not liveRoot then
                break
            end

            local activeAxe = ensureAxeEquipped()
            if not activeAxe then break end

            local ok, waitTime = strikeSectionLegit(tree, section, activeAxe, treeClassName, hits + 1)
            if not ok then break end
            hits = hits + 1

            task.wait(waitTime or 0.4)
        end

        isManualChopping = false

        local felled = not tree or not tree.Parent or not tree:IsDescendantOf(workspace) or (tree:FindFirstChild("RootCut") ~= nil) or (findLowestSection(tree) == nil)

        if felled then
            Non:Notify({
                Title = "Target Destroyed",
                Content = string.format("Felled %s tree in %d hits.", treeClassName, hits),
                Icon = "circle-check",
                Duration = 4
            })
        else
            Non:Notify({
                Title = "Halted",
                Content = "Process interrupted.",
                Icon = "info",
                Duration = 3
            })
        end
    end)
end

