    local function isSafeToClick()
        if not STATE.Running then return false end
        if not (STATE.InstaKill or STATE.AutoFarm or STATE.Zone27Loop or STATE.TowerFarm) then return false end

        if type(isrbxactive) ~= "function" then return false end
        if isrbxactive then
            local ok, active = pcall(isrbxactive)
            if not ok or active ~= true then return false end
        end

        local mouse = lp:GetMouse()
        local mx, my = mouse and mouse.X, mouse and mouse.Y
        if type(mx) ~= "number" or type(my) ~= "number" then return false end

        local cam = Workspace.CurrentCamera
        local vp = (cam and cam.ViewportSize) or Vector2.new(1920, 1080)

        local w = Window
        if w and w.IsPointerOver and w:IsPointerOver(mx, my) then return false end
        if w and w.open and w.x and w.y and w.w and w.h then
            if mx >= w.x - 10 and mx <= w.x + w.w + 10 and my >= w.y - 10 and my <= w.y + w.h + 10 then
                return false
            end
        end

        if my <= 130 then return false end
        if my >= vp.Y - 140 then return false end
        if mx <= 280 and my <= 780 then return false end
        if mx >= vp.X - 280 and my <= vp.Y - 140 then return false end

        local pg = lp:FindFirstChild("PlayerGui")
        local hud = pg and pg:FindFirstChild("Hud")
        local left = hud and hud:FindFirstChild("Left")
        local buttons = left and left:FindFirstChild("Buttons")
        if buttons then
            for _, btn in ipairs(buttons:GetChildren()) do
                local pos = safeGet(btn, "AbsolutePosition")
                if pos and pos.X and pos.Y then
                    if mx >= pos.X - 15 and mx <= pos.X + 115 and my >= pos.Y - 15 and my <= pos.Y + 115 then
                        return false
                    end
                end
            end
        end

        local mainGui = pg and pg:FindFirstChild("Main")
        if mainGui then
            for _, name in ipairs({ "Backpack", "Index", "Rebirth" }) do
                local win = mainGui:FindFirstChild(name)
                local p = win and safeGet(win, "AbsolutePosition")
                if p and p.Y and p.Y > 0 and p.Y < vp.Y then
                    return false
                end
            end
        end

        return true
    end

    local function killStageEnemies()
        local now = clock()
        check()
        if now - lastKillTime < 0.3 then return 0 end
        lastKillTime = now

        local remotes = ReplicatedStorage:FindFirstChild("Remote")
        local attackFolder = remotes and remotes:FindFirstChild("Attack")
        local enemyHitBE = attackFolder and attackFolder:FindFirstChild("EnemyHitBE")
        local attackEnemyBE = attackFolder and attackFolder:FindFirstChild("AttackEnemyBE")
        local dummyHitBE = attackFolder and attackFolder:FindFirstChild("DummyHitBE")
        local atkOnceBE = attackFolder and attackFolder:FindFirstChild("ATKOnceBE")
        local killRE = attackFolder and attackFolder:FindFirstChild("KillEnemyRE")
        local useAtkRE = attackFolder and attackFolder:FindFirstChild("UseAnyATKRE")

        local EnemyCTRL, HPCTRL, StageUtils = nil, nil, nil
        local count = 0

        local enemyFolder = Workspace:FindFirstChild("EnemyFolder")
        local enemyNames = {}
        if enemyFolder then
            for _, enemy in ipairs(enemyFolder:GetChildren()) do
                local hp = enemy:FindFirstChild("HPValue") or enemy:FindFirstChild("HPValue", true)
                local isDead = enemy:GetAttribute("Dead")
                if count >= 20 then break end
                if not isDead and (not hp or (tonumber(safeGet(hp, "Value")) or 0) > 0) then
                    table.insert(enemyNames, enemy.Name)
                    count = count + 1

                    if enemyHitBE then
                        pcall(function()
                            enemyHitBE:Fire(enemy.Name, 999999999999, {
                                SkillID = "Player_ATK_1",
                                Damage = 999999999999,
                                IsCrit = true
                            })
                        end)
                    end

                    if StageUtils and StageUtils.HurtEnemy then
                        pcall(function()
                            StageUtils.HurtEnemy(enemy.Name, 999999999999, { Damage = 999999999999 })
                        end)
                    end

                    if EnemyCTRL and EnemyCTRL.HurtEnemy then
                        pcall(function()
                            EnemyCTRL.HurtEnemy(enemy.Name, 999999999999, { Damage = 999999999999 })
                        end)
                    end
                    if EnemyCTRL and EnemyCTRL.DeadEnemyData then
                        pcall(function()
                            EnemyCTRL.DeadEnemyData(enemy.Name)
                        end)
                    end

                    if HPCTRL and HPCTRL.DamageOnce then
                        pcall(function()
                            HPCTRL.DamageOnce(enemy, 999999999999)
                        end)
                    end
                    if HPCTRL and HPCTRL.SetCurrentHP then
                        pcall(function()
                            HPCTRL.SetCurrentHP(enemy, 0)
                        end)
                    end

                    pcall(function()
                        if hp then hp.Value = 0 end
                        local hum = enemy:FindFirstChild("Humanoid")
                        if hum then hum.Health = 0 end
                        enemy:SetAttribute("Dead", true)
                    end)
                end
            end

            if #enemyNames > 0 and attackEnemyBE then
                pcall(function()
                    attackEnemyBE:Fire(enemyNames, {
                        Attacker = lp,
                        SkillID = "Player_ATK_1"
                    })
                end)
            end
        end

        local canAttackFolder = Workspace:FindFirstChild("CanAttackFolder")
        if canAttackFolder then
            for _, obj in ipairs(canAttackFolder:GetChildren()) do
                local hp = obj:FindFirstChild("HPValue") or obj:FindFirstChild("HPValue", true)
                if count >= 20 then break end
                if hp and (tonumber(safeGet(hp, "Value")) or 0) > 0 then
                    count = count + 1
                    if dummyHitBE then
                        pcall(function()
                            dummyHitBE:Fire(obj, 999999999999, {
                                SkillID = "Player_ATK_1",
                                Damage = 999999999999
                            })
                        end)
                    end
                    if HPCTRL and HPCTRL.DamageOnce then
                        pcall(function()
                            HPCTRL.DamageOnce(obj, 999999999999)
                        end)
                    end
                    pcall(function()
                        hp.Value = 0
                    end)
                end
            end
        end

        if count > 0 and atkOnceBE then
            pcall(function() atkOnceBE:Fire() end)
        end

        pcall(function()
            if mouse1click and isSafeToClick() then mouse1click() end
        end)

        pcall(function()
            if killRE and #enemyNames > 0 then
                for _, name in ipairs(enemyNames) do
                    killRE:FireServer(name)
                end
            end
        end)

        pcall(function()
            if useAtkRE then
                local wType = lp:GetAttribute("WeaponType") or "Katana"
                local prefix = (wType == "Great") and "G_ATK_" or "K_ATK_"
                useAtkRE:FireServer(prefix .. "1", workspace:GetServerTimeNow())
            end
        end)

        return count
    end

