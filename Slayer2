local targetHitboxParts = {"HumanoidRootPart", "UpperTorso", "LowerTorso", "Torso", "Head", "Hitbox"}

local function expandModelHitbox(m, size)
    local hum = m:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end
    
    if State.InvisibleHitbox then
        local hrp = m:FindFirstChild("HumanoidRootPart")
        if hrp and (hrp.ClassName == "Part" or hrp.ClassName == "MeshPart") then
            if hrp.Size.X ~= size then
                hrp.Size = Vector3.new(size, size, size)
                hrp.CanCollide = false
                pcall(function() hrp.Transparency = 1 end)
            end
        end
        for _, ch in ipairs(m:GetChildren()) do
            if (ch.ClassName == "Part" or ch.ClassName == "MeshPart") and ch.Name:lower():find("hitbox") then
                if ch.Size.X ~= size then
                    ch.Size = Vector3.new(size, size, size)
                    ch.CanCollide = false
                    pcall(function() ch.Transparency = 1 end)
                end
            end
        end
    else
        for _, partName in ipairs(targetHitboxParts) do
            local p = m:FindFirstChild(partName)
            if p and (p.ClassName == "Part" or p.ClassName == "MeshPart") then
                if p.Size.X ~= size then
                    p.Size = Vector3.new(size, size, size)
                    p.CanCollide = false
                end
            end
        end
        for _, ch in ipairs(m:GetChildren()) do
            if (ch.ClassName == "Part" or ch.ClassName == "MeshPart") and ch.Name:lower():find("hitbox") then
                if ch.Size.X ~= size then
                    ch.Size = Vector3.new(size, size, size)
                    ch.CanCollide = false
                end
            end
        end
    end
end

