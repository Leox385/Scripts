local function EnsureToolEquipped(toolItem)
    if not toolItem then return false end
    local char = lp.Character
    if not char then return false end

    local th = char:FindFirstChild("ToolHandle")
    local equippedItem = th and th:FindFirstChild("OriginalItem") and th.OriginalItem.Value
    if equippedItem and (equippedItem == toolItem or equippedItem.Name == toolItem.Name) then
        return true
    end

    local pgui = lp:FindFirstChild("PlayerGui")
    local iface = pgui and pgui:FindFirstChild("Interface")
    local hotbar = iface and iface:FindFirstChild("Hotbar")
    local btn = hotbar and hotbar:FindFirstChild("Button" .. toolItem.Name)
    local slotNum = nil
    if btn and btn:FindFirstChild("Number") and btn.Number:IsA("TextLabel") then
        slotNum = tonumber(btn.Number.Text)
    end

    if slotNum and slotNum >= 1 and slotNum <= 9 and keypress and keyrelease then
        local key = 48 + slotNum
        keypress(key)
        task.wait(0.04)
        keyrelease(key)
        task.wait(0.12)
        return true
    end

    if keypress and keyrelease then
        local fallbackKey = toolItem.Name:lower():find("axe") and 50 or 49
        keypress(fallbackKey)
        task.wait(0.04)
        keyrelease(fallbackKey)
        task.wait(0.12)
    end
    return true
end

