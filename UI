	function Window:SetLayout(value) layout=styleTable(value); return self end
    local defaultSection
    function Window:AddTab(options)
        if not defaultSection then defaultSection=self:Section("Pages") end
        return defaultSection:Tab(options)
    end
    function Window:SetIcon(src)
		background(function()
			local d = fetchImage(src)
			if d and windowAlive then
				iconData = d
				miniImgSet = false
			end
		end)
	end
	function Window:Minimize() minimized = true end
	function Window:Restore()
		minimized = false
		visible = true
	end
	function Window:Toggle() toggleUI() end
	function Window:IsPointerOver(mx, my)
        if not windowAlive or not visible then return false end
        if minimized then return (mx - miniX) ^ 2 + (my - miniY) ^ 2 <= 42 ^ 2 end
        return inRect(mx, my, winX - 10, winY - 10, W + 20, H + 20)
    end
    function Window:SetToggleKey(vk) togKey = normalizeKey(vk) end
	function Window:ToggleExpand()
		expanded = not expanded
		if expanded then
			tW, tH = math.min(MAX_W, 790), math.min(MAX_H, 570)
		else
			tW, tH = normalW, normalH
		end
	end
	function Window:SetSize(nw, nh)
		normalW = clamp(finite(nw, normalW), MIN_W, MAX_W)
		normalH = clamp(finite(nh, normalH), MIN_H, MAX_H)
		tW, tH = normalW, normalH
		expanded = false
	end
	function Window:SetVisualFX(enabled)
        gardenEnabled = enabled ~= false
        gardenDirty = true
        if not gardenEnabled then for _, d in ipairs(gardenDraws) do d.Visible = false end end
    end
    function Window:GetVisualFX() return gardenEnabled end
    function Window:_applyTheme(nt)
		T = nt
		gardenDirty = true
		Window._theme = nt
	end

	function Window:Watermark(c)
		c = c or {}
		local label = c.Title or title
		local bg = newDraw("Square", { Filled = true, Rounding = 5, Visible = true })
		local ol = newDraw("Square", { Filled = false, Thickness = 1, Rounding = 5, Visible = true })
		local acc = newDraw("Line", { Thickness = 1, Visible = true })
		local dot = newDraw("Circle", { Filled = true, NumSides = 12, Radius = 3, Visible = true })
		local nm = newDraw("Text", { Text = label, Size = 12, Font = F_BOLD, Outline = true, Visible = true })
		local info = newDraw("Text", { Text = "", Size = 11, Font = F_MONO, Outline = true, Visible = true })
		local list = { bg, ol, acc, dot, nm, info }
		local shownWM = true
		local dateAt, dateText = -1, ""
		local conn = connectFrame(function()
			if not Kirin._alive or not windowAlive then return end
			pcall(function()
				local now = clock()
				if math.floor(now) ~= dateAt then
					dateAt = math.floor(now)
					local ok, value = pcall(os.date, "%H:%M:%S")
					dateText = (ok and type(value) == "string") and value or ("T+" .. math.floor(now - startT) .. "s")
				end
				local tstr = dateText
				info.Text = tostring(fps) .. " fps  " .. tstr
				local x, y = 14, 14
				local nw = textW(nm, 12, false)
				local iw = textW(info, 11, true)
				local ww = 26 + nw + 12 + iw + 12
				bg.Position = V(x, y); bg.Size = V(ww, 24); bg.Color = T.BgAlt
				ol.Position = V(x, y); ol.Size = V(ww, 24); ol.Color = T.Border
				acc.From = V(x + 8, y + 23); acc.To = V(x + 26 + nw, y + 23); acc.Color = T.Accent
				dot.Position = V(x + 14, y + 12); dot.Radius = 2.4 + (math.sin(now * 3) + 1) * 0.6; dot.Color = T.Accent
				nm.Position = V(x + 24, y + 5); nm.Color = T.Text
				info.Position = V(x + 24 + nw + 12, y + 6); info.Color = T.TextSub
				for _, d in ipairs(list) do d.Visible = shownWM end
			end)
		end)
		local wm = { list = list, conn = conn }
		table.insert(watermarks, wm)
		local hd = {}
		function hd:SetVisible(v) shownWM = v and true or false end
		function hd:SetTitle(t) nm.Text = tostring(t) end
		function hd:Destroy()
			pcall(function() conn:Disconnect() end)
			for _, d in ipairs(list) do kill(d) end
		end
		return hd
	end

	function Window:IsAlive() return windowAlive and Kirin._alive end
	function Window:Destroy()
		if not windowAlive then return end
		windowAlive = false
		for _, tab in ipairs(tabs) do
			for _, el in ipairs(tab.elems) do
				el.destroyed = true
				if el.flag then Kirin._controls[el.flag] = nil; Kirin.Flags[el.flag] = nil end
			end
		end
		for i = #Kirin._windows, 1, -1 do if Kirin._windows[i] == Window then table.remove(Kirin._windows, i) end end
		for _, cn in ipairs(conns) do pcall(function() cn:Disconnect() end) end
		for _, wm in ipairs(watermarks) do
			pcall(function() wm.conn:Disconnect() end)
			for _, d in ipairs(wm.list) do kill(d) end
		end
		for _, d in ipairs(winList) do kill(d) end
		for _, d in ipairs(miniList) do kill(d) end
		for _, n in ipairs(notifs) do
			for _, d in pairs(n.d) do kill(d) end
		end
		notifs = {}
		if notifConn then
			pcall(function() notifConn:Disconnect() end)
			notifConn = nil
		end
	end

	if cfg.Icon then Window:SetIcon(cfg.Icon) end
	table.insert(Kirin._windows, Window)
	return Window
end

function Kirin:Destroy()
	for i = #self._windows, 1, -1 do pcall(function() self._windows[i]:Destroy() end) end
	self._windows, self._controls, self._watchers = {}, {}, {}
	self._alive = false
	runtimeAlive = false
end

_G.__AstraCleanup = function() Kirin:Destroy() end
_G.Kirin = Kirin
_G.AstraUI = Kirin
if typeOf(getgenv) == "function" then pcall(function() getgenv().Kirin = Kirin end) end

return Kirin
