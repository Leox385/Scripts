FarmTab:Toggle({
    Title = "Auto-Chop Trees",
    Desc = "Automatically cuts down trees using your strongest detected axe",
    Default = false,
    Callback = function(on)
        autoChopEnabled = on
        chopSession = chopSession + 1
        local mySession = chopSession

        if on then
            if autoHuntEnabled then
                autoHuntEnabled = false
                huntSession = huntSession + 1
            end

            local initAxe, initDmg = GetBestAxe()
            if not initAxe then
                Notify("Auto-Chop", "No axe found in inventory or character.", "trianglealert")
                autoChopEnabled = false
                return
            end

            Notify("Auto-Chop", string.format("Started auto-chop using %s (Damage: %d).", initAxe.Name, initDmg), "circlecheck")

            task.spawn(function()
                while autoChopEnabled and mySession == chopSession do
                    local char = lp.Character
                    local root = char and char:FindFirstChild("HumanoidRootPart")
                    local hum = char and char:FindFirstChildOfClass("Humanoid")
                    if not root or not hum or hum.Health <= 0 then
                        task.wait(1)
                        continue
                    end

                    local axe, axeDamage = GetBestAxe()
                    if not axe then
                        Notify("Auto-Chop", "No axe found in inventory or character.", "trianglealert")
                        autoChopEnabled = false
                        break
                    end

                    EnsureToolEquipped(axe)

                    local bestTree = nil
                    local bestDist = chopRadius

                    local function CheckTree(obj)
                        if not obj:IsA("Model") then return end
                        if obj:GetAttribute("LocalDestroyed") or obj:GetAttribute("Dead") then return end
                        local hp = obj:GetAttribute("Health")
                        if hp ~= nil and hp <= 0 then return end

                        if obj.Name:lower():find("tree") then
                            local trunk = obj:FindFirstChild("Trunk") or obj:FindFirstChild("Wood") or obj.PrimaryPart
                            if trunk and trunk:IsA("BasePart") then
                                local d = (trunk.Position - root.Position).Magnitude
                                if d < bestDist and IsTreeMatchingSize(obj, chopTreeType) then
                                    bestDist = d
                                    bestTree = obj
                                end
                            end
                        end
                    end

                    local foliage = Workspace:FindFirstChild("Map") and Workspace.Map:FindFirstChild("Foliage")
                    if foliage then
                        for _, obj in ipairs(foliage:GetChildren()) do CheckTree(obj) end
                    else
                        local mapFolder = Workspace:FindFirstChild("Map")
                        if mapFolder then
                            for _, obj in ipairs(mapFolder:GetChildren()) do CheckTree(obj) end
                        end
                        for _, obj in ipairs(Workspace:GetChildren()) do CheckTree(obj) end
                    end

                    if not bestTree or not autoChopEnabled or mySession ~= chopSession then
                        task.wait(0.6)
                        continue
                    end

                    local trunk = bestTree:FindFirstChild("Trunk") or bestTree:FindFirstChild("Wood") or bestTree.PrimaryPart
                    if not trunk then
                        task.wait(0.3)
                        continue
                    end

                    local isBig = bestTree.Name:lower():find("big") ~= nil
                    local safeDistance = isBig and 4.8 or 3.6
                    local treePos = trunk.Position
                    local dir = (root.Position - treePos).Unit
                    if dir.Magnitude < 0.1 then dir = Vector3.new(1, 0, 0) end
                    local standPos = Vector3.new(treePos.X, root.Position.Y, treePos.Z) + Vector3.new(dir.X, 0, dir.Z).Unit * safeDistance

                    root.AssemblyLinearVelocity = Vector3.zero
                    root.Velocity = Vector3.zero
                    root.CFrame = CFrame.lookAt(standPos, Vector3.new(treePos.X, standPos.Y, treePos.Z))
                    task.wait(0.1)

                    local chopTimeout = 0
                    while autoChopEnabled and mySession == chopSession and bestTree.Parent and trunk.Parent and not bestTree:GetAttribute("LocalDestroyed") and not bestTree:GetAttribute("Dead") and (bestTree:GetAttribute("Health") == nil or bestTree:GetAttribute("Health") > 0) and chopTimeout < 45 do
                        chopTimeout = chopTimeout + 1
                        local curChar = lp.Character
                        local curRoot = curChar and curChar:FindFirstChild("HumanoidRootPart")
                        local curHum = curChar and curChar:FindFirstChildOfClass("Humanoid")
                        if not curRoot or not curHum or curHum.Health <= 0 then break end

                        EnsureToolEquipped(axe)

                        curRoot.AssemblyLinearVelocity = Vector3.zero
                        curRoot.Velocity = Vector3.zero
                        curRoot.CFrame = CFrame.lookAt(standPos, Vector3.new(treePos.X, standPos.Y, treePos.Z))

                        if mouse1click then
                            mouse1click()
                        end

                        if damageRemote then
                            task.spawn(function()
                                local hitId = tostring(math.random(1000, 99999)) .. "_" .. math.abs(lp.UserId)
                                pcall(function()
                                    damageRemote:InvokeServer(bestTree, axe, hitId, curRoot.CFrame, false)
                                end)
                            end)
                        end

                        task.wait(0.28)
                    end

                    local curChar = lp.Character
                    local curRoot = curChar and curChar:FindFirstChild("HumanoidRootPart")
                    if curRoot then
                        curRoot.AssemblyLinearVelocity = Vector3.zero
                        curRoot.Velocity = Vector3.zero
                    end

                    task.wait(0.25)
                end
            end)
        else
            Notify("Auto-Chop", "Auto-chop disabled.", "circlecheck")
        end
    end
})

