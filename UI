local function refreshRuntime()
    lp = safeGet(Players, "LocalPlayer") or lp
    if not mouse and lp then pcall(function() mouse = lp:GetMouse() end) end
    local current = safeGet(workspace, "CurrentCamera")
    local size = safeGet(current, "ViewportSize") or safeGet(Drawing, "Viewport")
    if size and size.X and size.Y and size.X > 0 and size.Y > 0 then viewport = size end
