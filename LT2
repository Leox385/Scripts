    local main = getItemMainPart(item)
    if not main or main.Anchored then return false end

    local _, root = getChar()
    if not root then return false end

    local targetLanding = savedPos.Position + Vector3.new(math.random(-3, 3), 2.5, math.random(-3, 3))

    for attempt = 1, 3 do
        local curDist = (main.Position - savedPos.Position).Magnitude
        if curDist <= 12 then
            return true
        end

        safeTeleport(CFrame.new(main.Position.X, main.Position.Y + 3.5, main.Position.Z))
        task.wait(0.12)

        ClientIsDragging:FireServer(item)
        task.wait(0.06)
        ClientIsDragging:FireServer(item)
        task.wait(0.06)

        safeTeleport(savedPos)
        task.wait(0.06)

        local delta = targetLanding - main.Position
        for _, p in ipairs(item:GetDescendants()) do
            if isRealBasePart(p) and typeof(p.CFrame) == "CFrame" then
                local cf = p.CFrame
                p.CFrame = CFrame.new(cf.X + delta.X, cf.Y + delta.Y, cf.Z + delta.Z)
                p.Velocity = Vector3.new(0, 0, 0)
                p.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            end
        end

        ClientIsDragging:FireServer(item)
        task.wait(0.08)
        ClientIsDragging:FireServer(item)
        task.wait(0.1)

        if (main.Position - savedPos.Position).Magnitude <= 18 then
            return true
        end
    end

    safeTeleport(savedPos)
    return (main.Position - savedPos.Position).Magnitude <= 18
end

local function isEligibleLooseItem(item, filterType, ownershipMode)
    if not item or not item.Parent then return false end
    if item:FindFirstChild("DriveSeat") or item.Name:lower():find("truck") or item.Name:lower():find("trailer") then
        return false
    end
    local main = getItemMainPart(item)
    if not main or main.Anchored then return false end

    local o = item:FindFirstChild("Owner")
    local ownerStr = o and tostring(o.Value) or ""

    -- Never touch store display/decorative items (Unreadable_name)
    if ownerStr:find("Unreadable") then
        return false
    end

    if ownershipMode ~= "All Items (Forced)" then
        if not isPlayerOwnedItem(item) then
            if o and o.Value and ownerStr ~= "nil" and not ownerStr:find(lp.Name) then
                return false
            end
        end
    end

    local iname = item:FindFirstChild("ItemName")
    local inameStr = iname and tostring(iname.Value) or ""
    local tn = item:FindFirstChild("ToolName")
    local tnStr = tn and tostring(tn.Value) or ""
    local isDraggable = item:FindFirstChild("DraggableItem") ~= nil

    if filterType == "Gifts & Presents" then
        return inameStr:lower():find("gift") ~= nil or inameStr:lower():find("present") ~= nil or item.Name:lower():find("gift") ~= nil or item.Name:lower():find("present") ~= nil
    elseif filterType == "Tools & Axes" then
        return tnStr ~= "" or inameStr:lower():find("axe") ~= nil or item.Name:lower():find("axe") ~= nil or item:FindFirstChild("CuttingTool") ~= nil
    elseif filterType == "Furniture & Boxes" then
        return (inameStr ~= "" and tnStr == "") or isDraggable
    else -- "All Loose Items"
        return isDraggable or inameStr ~= "" or tnStr ~= ""
    end
end

