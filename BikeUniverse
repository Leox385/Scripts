local cachedBikeModel = nil
local cachedChassis = nil
local function getPlayerBikeChassis()
    if cachedBikeModel and cachedBikeModel.Parent == workspace and cachedChassis and cachedChassis.Parent == cachedBikeModel then
        local seat = cachedBikeModel:FindFirstChild("DriverSeat")
        return cachedChassis, cachedBikeModel, seat
    end
    cachedBikeModel = nil
    cachedChassis = nil
    local lpName = LocalPlayer.Name
    for _, child in ipairs(workspace:GetChildren()) do
        if child.ClassName == "Model" and child ~= LocalPlayer.Character and string.find(child.Name, lpName, 1, true) then
            local ch = child:FindFirstChild("Chassis")
            local seat = child:FindFirstChild("DriverSeat")
            if ch and (ch.ClassName == "Part" or ch.ClassName == "MeshPart") then
                cachedBikeModel = child
                cachedChassis = ch
                return ch, child, seat
            end
        end
    end
    return nil, nil, nil
end

local smashedHistory = {}
local function cleanSmashedHistory()
    local now = tick()
    for k, expire in pairs(smashedHistory) do
        if now > expire then
            smashedHistory[k] = nil
        end
    end
end

local function getAvailablePumpkins()
    cleanSmashedHistory()
    local folder = workspace:FindFirstChild("MyPumpkins")
    if not folder then return {} end
    local chassis = getPlayerBikeChassis()
    local origin = (chassis and chassis.Position) or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character.HumanoidRootPart.Position) or Vector3.new(0, 0, 0)
    local now = tick()
    local list = {}
    for _, item in ipairs(folder:GetChildren()) do
        if item.Parent == folder and (not smashedHistory[item] or now > smashedHistory[item]) then
            local body = item:FindFirstChild("Body")
            if body and (body.ClassName == "MeshPart" or body.ClassName == "Part") and body.Position then
                local transp = body.Transparency
                if transp < 0.6 then
                    local pPos = body.Position
                    local posKey = string.format("%d_%d_%d", math.floor(pPos.X / 5), math.floor(pPos.Y / 5), math.floor(pPos.Z / 5))
                    if not smashedHistory[posKey] or now > smashedHistory[posKey] then
                        local dist = (pPos - origin).Magnitude
                        table.insert(list, { model = item, body = body, dist = dist, pos = pPos, posKey = posKey })
                    end
                end
            end
        end
    end
    table.sort(list, function(a, b) return a.dist < b.dist end)
    return list
end

local function safeWorldToScreen(pos)
    if type(WorldToScreen) == "function" then
        local ok, sp, onScreen = pcall(WorldToScreen, pos)
        if ok and sp then return sp, onScreen == true end
    end
    local cam = workspace.CurrentCamera
    if cam and type(cam.WorldToViewportPoint) == "function" then
        local ok, sp, onScreen = pcall(function() return cam:WorldToViewportPoint(pos) end)
        if ok and sp then return Vector2.new(sp.X, sp.Y), onScreen and (sp.Z > 0) end
    end
    return Vector2.new(0, 0), false
end

local POOL_SIZE = 24
local espPool = {}
for i = 1, POOL_SIZE do
    local box = Drawing.new("Square")
    box.Visible = false
    box.Color = State.espColor
    box.Thickness = 1.5
    box.Filled = false

    local line = Drawing.new("Line")
    line.Visible = false
    line.Color = State.espColor
    line.Thickness = 1.0

    local tag = Drawing.new("Text")
    tag.Visible = false
    tag.Color = Color3.fromRGB(255, 255, 255)
    tag.Size = 13
    tag.Center = true
    tag.Outline = true

    espPool[i] = { box = box, line = line, tag = tag }
end

local espConnection = nil
local lastEspUpdate = 0
espConnection = RunService.RenderStepped:Connect(function()
    if not State.alive then return end
    local now = tick()
    if now - lastEspUpdate < 0.05 then return end
    lastEspUpdate = now

    if not State.espEnabled then
        for i = 1, POOL_SIZE do
            local s = espPool[i]
            s.box.Visible = false
            s.line.Visible = false
            s.tag.Visible = false
        end
        return
    end

    local cam = workspace.CurrentCamera
    local camPos = (cam and cam.CFrame and cam.CFrame.Position) or Vector3.new(0, 0, 0)
    local screenW, screenH = 1920, 1080
    if cam and cam.ViewportSize then
        screenW = cam.ViewportSize.X
        screenH = cam.ViewportSize.Y
    end
    local tracerOrigin = Vector2.new(screenW / 2, screenH)

    local folder = workspace:FindFirstChild("MyPumpkins")
    local candidates = {}
    if folder then
        for _, p in ipairs(folder:GetChildren()) do
            local body = p:FindFirstChild("Body")
            if body and body.Parent and body.Position then
                local d = (body.Position - camPos).Magnitude
                if d <= State.espMaxDist then
                    table.insert(candidates, { body = body, dist = d })
                end
            end
        end
        table.sort(candidates, function(a, b) return a.dist < b.dist end)
    end

    for i = 1, POOL_SIZE do
        local slot = espPool[i]
        local data = candidates[i]
        if data and data.body and data.body.Parent and data.body.Position then
            local pos, onScreen = safeWorldToScreen(data.body.Position)
            if onScreen then
                local dist = data.dist
                local sz = math.clamp(1400 / math.max(dist, 10), 12, 60)

                if State.espBoxes then
                    slot.box.Position = Vector2.new(pos.X - sz / 2, pos.Y - sz / 2)
                    slot.box.Size = Vector2.new(sz, sz)
                    slot.box.Color = State.espColor
                    slot.box.Visible = true
                else
                    slot.box.Visible = false
                end

                if State.espTracers then
                    slot.line.From = tracerOrigin
                    slot.line.To = pos
                    slot.line.Color = State.espColor
                    slot.line.Visible = true
                else
                    slot.line.Visible = false
                end

                if State.espNames then
                    slot.tag.Position = Vector2.new(pos.X, pos.Y - sz / 2 - 14)
                    slot.tag.Text = string.format("Pumpkin [%dm]", math.floor(dist))
                    slot.tag.Color = Color3.fromRGB(255, 230, 160)
                    slot.tag.Visible = true
                else
                    slot.tag.Visible = false
                end
            else
                slot.box.Visible = false
                slot.line.Visible = false
                slot.tag.Visible = false
            end
        else
            slot.box.Visible = false
            slot.line.Visible = false
            slot.tag.Visible = false
        end
    end
end)

