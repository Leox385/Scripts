    if hrp and pos then
        hrp.CFrame = CFrame.new(pos.X, pos.Y + 2.5, pos.Z)
        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    end
end

local function smartTeleportToEntity(name, fallbackPos)
    local char = lp.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local foundPos = nil
    local lowerName = name and name:lower() or ""
    
    if lowerName:find("butterfly") or lowerName:find("estate") then
        fallbackPos = Vector3.new(-398.5, 289.0, 515.0)
    elseif lowerName:find("obari") then
        fallbackPos = Vector3.new(37.0, 1307.5, -1179.5)
    end
    
    local deb = Workspace:FindFirstChild("Debree")
    if deb then
        local dReg = deb:FindFirstChild("Regions")
        if dReg then
            for _, r in ipairs(dReg:GetChildren()) do
                local stat = r:FindFirstChild("StationaryNpcs")
                if stat then
                    for _, npc in ipairs(stat:GetChildren()) do
                        if npc.Name == name or npc.Name:lower():find(name:lower(), 1, true) or name:lower():find(npc.Name:lower(), 1, true) then
                            local root = npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChildWhichIsA("BasePart")
                            if root then foundPos = root.Position break end
                        end
                    end
                end
                if foundPos then break end
                local sc = r:FindFirstChild("SpawnCrystal")
                if sc and (r.Name == name or r.Name:lower():find(name:lower(), 1, true) or name:lower():find(r.Name:lower(), 1, true)) then
                    local root = sc:FindFirstChild("Root") or sc:FindFirstChildWhichIsA("BasePart")
                    if root then foundPos = root.Position break end
                end
            end
        end
        if not foundPos then
            for _, ch in ipairs(deb:GetChildren()) do
                if ch.Name:lower():find(name:lower(), 1, true) or name:lower():find(ch.Name:lower(), 1, true) then
                    local root = ch:FindFirstChild("HumanoidRootPart") or ch:FindFirstChildWhichIsA("BasePart")
                    if root then foundPos = root.Position break end
                end
            end
        end
    end
    
    if not foundPos then
        local hums = Workspace:FindFirstChild("Humanoids")
        if hums then
            local hReg = hums:FindFirstChild("Regions")
            if hReg then
                for _, r in ipairs(hReg:GetChildren()) do
                    local act = r:FindFirstChild("ActiveNpcs")
                    if act then
                        for _, item in ipairs(act:GetChildren()) do
                            if item.Name == name or item.Name:lower():find(name:lower(), 1, true) or name:lower():find(item.Name:lower(), 1, true) then
                                local m = item:FindFirstChildOfClass("Model") or (item.ClassName == "Model" and item)
                                if not m then
                                    for _, sub in ipairs(item:GetChildren()) do
                                        if sub.ClassName == "Model" then m = sub break end
                                    end
                                end
                                if m then
                                    local root = m:FindFirstChild("HumanoidRootPart") or m:FindFirstChildWhichIsA("BasePart")
                                    if root then foundPos = root.Position break end
                                end
                            end
                        end
                    end
                    if foundPos then break end
                end
            end
        end
    end
    
    if not foundPos then
        local tr = Workspace:FindFirstChild("Training")
        if tr then
            for _, st in ipairs(tr:GetChildren()) do
                if st.Name == name or st.Name:lower():find(name:lower(), 1, true) or name:lower():find(st.Name:lower(), 1, true) then
                    local bPart = st:FindFirstChild("Boulder") or st:FindFirstChild("Boulder1")
                    if bPart and (bPart.ClassName == "Part" or bPart.ClassName == "MeshPart") then
                        foundPos = bPart.Position
                        break
                    end
                    for _, desc in ipairs(st:GetDescendants()) do
                        if desc.ClassName == "Part" or desc.ClassName == "MeshPart" then
                            if desc.Name:lower():find("boulder") or desc.Name == "Root" or desc.Name:find("Prompt") or desc.Name:find("Mat") then
                                foundPos = desc.Position
                                break
                            end
                        end
                    end
                    if not foundPos then
                        local anyPart = st:FindFirstChildWhichIsA("BasePart", true)
                        if anyPart then foundPos = anyPart.Position end
                    end
                    if foundPos then break end
                end
            end
        end
    end
    
    if not foundPos then
        local mp = Workspace:FindFirstChild("Map")
        if mp then
            local mReg = mp:FindFirstChild("Regions")
            if mReg then
                for _, r in ipairs(mReg:GetChildren()) do
                    if r.Name == name or r.Name:lower():find(name:lower(), 1, true) or name:lower():find(r.Name:lower(), 1, true) then
                        local anyPart = r:FindFirstChildWhichIsA("BasePart", true)
                        if anyPart then foundPos = anyPart.Position break end
                    end
                end
            end
        end
    end
    
    local finalPos = foundPos or fallbackPos
    if finalPos then
        hrp.CFrame = CFrame.new(finalPos.X, finalPos.Y + 2.5, finalPos.Z + 2.0)
        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        if UI and UI.Notify then
            UI:Notify({
                Title = "Teleport",
                Content = (foundPos and "Reached live: " or "Teleported to: ") .. name,
                Type = "success",
                Duration = 2
            })
        end
    else
        if UI and UI.Notify then
            UI:Notify({
                Title = "Teleport",
                Content = "Location not found: " .. name,
                Type = "error",
                Duration = 2
            })
        end
    end
end

local function getTargets(targetName)
    local results = {}
    local rawTarget = targetName and targetName:lower() or ""
    local cleanTarget = targetName and targetName:gsub("%s*%b()%s*", ""):lower() or ""
    local isAll = (targetName == "All Regular Mobs" or targetName == "All Bosses" or targetName == "All Enemies")
    
    local function scanCandidate(item)
        if not item then return end
        local match = false
        local iName = item.Name:lower()
        if isAll then
            match = true
        elseif item.Name == targetName 
            or iName == rawTarget or (cleanTarget ~= "" and iName == cleanTarget)
            or iName:find(rawTarget, 1, true) or (cleanTarget ~= "" and iName:find(cleanTarget, 1, true))
            or rawTarget:find(iName, 1, true) or (cleanTarget ~= "" and cleanTarget:find(iName, 1, true)) then
            match = true
        end
        
        if match then
            local m = item:FindFirstChildOfClass("Model") or (item.ClassName == "Model" and item)
            if not m then
                for _, sub in ipairs(item:GetChildren()) do
                    if sub.ClassName == "Model" and sub:FindFirstChildOfClass("Humanoid") then
                        m = sub
                        break
                    end
                end
            end
            if m and not isPlayerModel(m) then
                local hum = m:FindFirstChildOfClass("Humanoid")
                local root = m:FindFirstChild("HumanoidRootPart") or m:FindFirstChildWhichIsA("BasePart")
                if hum and root and hum.Health > 0 then
                    table.insert(results, {
                        Model = m,
                        Humanoid = hum,
                        Root = root,
                        Name = item.Name
                    })
                end
            end
        end
    end
    
    local function scanContainer(folder)
        if not folder then return end
        for _, item in ipairs(folder:GetChildren()) do
            scanCandidate(item)
        end
    end
    
    local hums = Workspace:FindFirstChild("Humanoids")
    if hums then
        local reg = hums:FindFirstChild("Regions")
        if reg then
            for _, r in ipairs(reg:GetChildren()) do
                scanContainer(r:FindFirstChild("ActiveNpcs"))
                scanContainer(r:FindFirstChild("StationaryNpcs"))
            end
        end
        scanContainer(hums:FindFirstChild("ActiveNpcs"))
        scanContainer(hums:FindFirstChild("StationaryNpcs"))
    end
    
    local deb = Workspace:FindFirstChild("Debree")
    if deb then
        local dReg = deb:FindFirstChild("Regions")
        if dReg then
            for _, r in ipairs(dReg:GetChildren()) do
                scanContainer(r:FindFirstChild("ActiveNpcs"))
                scanContainer(r:FindFirstChild("StationaryNpcs"))
            end
        end
        scanContainer(deb:FindFirstChild("ActiveNpcs"))
        scanContainer(deb:FindFirstChild("StationaryNpcs"))
        scanContainer(deb)
    end
    
    return results
end

